# Explicit read-only browser asset routes. Never map arbitrary URLs to disk.
export struct StaticAsset {
    path: string,
    mime: string,
    found: bool
}

export function data_route(url: string) -> StaticAsset {
    if url == "/ui/workbench.js" {
        return StaticAsset { path: "web/ui/workbench.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ui/workbench.css" {
        return StaticAsset { path: "web/ui/workbench.css", mime: "text/css; charset=utf-8", found: true }
    }
    if url == "/ui/editor.worker.js" {
        return StaticAsset { path: "web/ui/editor.worker.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ui/workbench.js.LEGAL.txt" {
        return StaticAsset { path: "web/ui/workbench.js.LEGAL.txt", mime: "text/plain; charset=utf-8", found: true }
    }
    if url == "/ui/THIRD_PARTY_LICENSES.txt" {
        return StaticAsset { path: "web/ui/THIRD_PARTY_LICENSES.txt", mime: "text/plain; charset=utf-8", found: true }
    }
    if url == "/data" or url == "/data.html" {
        return StaticAsset { path: "web/data.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/data_viewer.js" {
        return StaticAsset { path: "web/data_viewer.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/data_page.js" {
        return StaticAsset { path: "web/data_page.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/index.html" {
        return StaticAsset { path: "web/index.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/plots" or url == "/plots.html" {
        return StaticAsset { path: "web/plots.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/plot_history.js" {
        return StaticAsset { path: "web/plot_history.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/math_flow_plot.js" {
        return StaticAsset { path: "web/math_flow_plot.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/plot_page.js" {
        return StaticAsset { path: "web/plot_page.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/environment.js" {
        return StaticAsset { path: "web/environment.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/console" or url == "/console.html" {
        return StaticAsset { path: "web/console.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/console.js" {
        return StaticAsset { path: "web/console.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/console_page.js" {
        return StaticAsset { path: "web/console_page.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/rproj" or url == "/rproj.html" {
        return StaticAsset { path: "web/rproj.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/rproj.js" {
        return StaticAsset { path: "web/rproj.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/rproj_page.js" {
        return StaticAsset { path: "web/rproj_page.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/file_save.js" {
        return StaticAsset { path: "web/file_save.js", mime: "text/javascript; charset=utf-8", found: true }
