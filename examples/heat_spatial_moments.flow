# Executable spatial moment reductions in a periodic Fourier-mode heat source.
# The three coefficients are computed from the actual 2D grid, not substituted constants.
domain ThermalDomain {
    grid       = 32 × 32
    extent     = 1m × 1m
    boundaries = Periodic
}

model HeatEquation on ThermalDomain {
    const diffusivity = 0.01m²/s
    field temperature: Scalar<Kelvin>

    dynamics {
        ∂ₜtemperature = diffusivity ∇²temperature + 1K/s * (rms(10K*sin(2πx/1m))/1K + std(10K*sin(2πx/1m))/1K + variance(10K*sin(2πx/1m))/1K²) * sin(2πx/1m)
    }
    initial {
        temperature = 300K
    }
}

solver ThermalSolver for HeatEquation {
    spatial {
        method    = FiniteDifference
        diffusion = CentralDifference
    }
    temporal {
        method   = RungeKuttaSecondOrder
        timeStep = 10⁻⁴s
    }
}

let simulation = HeatEquation ▷ ThermalSolver ▷ Evolve(until: 0.01s)

simulation
    ▷ Observe {
        meanTemperature     = Mean(temperature)
        temperatureVariance = Mean((temperature − meanTemperature)²)
    }
    ▷ Visualize {
        temperature         = Heatmap
        temperatureVariance = LineGraph
    }
