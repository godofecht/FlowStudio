# Executable three-unknown dimensional inference through native Flow IR.
import .math_dimensions { Dimension, dimensionless, length_dimension, time_dimension, mass_dimension, product_dimension, quotient_dimension, same_dimension }
import .math_static { MathDimensionBindings, MathDimensionSymbol, empty_math_dimension_bindings }
import .math_dimension_triple { MathThreeDimensionSolution, solve_math_equations_three_unknown_dimensions }

function main() -> i32 {
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let area: Dimension = product_dimension(length, length)
    let mut known: MathDimensionBindings = empty_math_dimension_bindings()
    let mut result: MathThreeDimensionSolution =
        solve_math_equations_three_unknown_dimensions(
            "x*y*z = 1m³", "x/y = 1", "y/z = 1", known, "x", "y", "z")
    if not result.valid or result.failed_equation != -1 or
       not same_dimension(result.first, length) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, length) { return 1 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y = 1m²", "y*z = 1s²", "x = 1m", known, "x", "y", "z")
    let seconds_squared_per_metre: Dimension =
        quotient_dimension(product_dimension(time, time), length)
    if not result.valid or not same_dimension(result.first, length) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, seconds_squared_per_metre) { return 2 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m*1s", "x/y = 1m/1s", "y/z = 1s",
        known, "x", "y", "z")
    if not result.valid or not same_dimension(result.first, length) or
       not same_dimension(result.second, time) or
       not same_dimension(result.third, dimensionless()) { return 3 }

    result = solve_math_equations_three_unknown_dimensions(
        "δ₀*ρ*ζ = 1m³", "δ₀/ρ = 1", "ρ/ζ = 1",
        known, "δ₀", "ρ", "ζ")
    if not result.valid or not same_dimension(result.first, length) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, length) { return 4 }

    result = solve_math_equations_three_unknown_dimensions(
        "sqrt(x)*y*z = 1m³", "x/y = 1m", "y/z = 1",
        known, "x", "y", "z")
    # x=m², y=m, z=m, so sqrt(x)*y*z=m³.
    if not result.valid or not same_dimension(result.first, area) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, length) { return 5 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "x/y = 1",
        known, "x", "y", "z")
    if result.valid { return 6 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m²", "x/y = 1", "y/z = 1",
        known, "x", "y", "z")
    if result.valid { return 7 }

    result = solve_math_equations_three_unknown_dimensions(
        "x+y = 1m", "x/y = 1", "y/z = 1",
        known, "x", "y", "z")
    if result.valid or result.failed_equation != 0 { return 8 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "sin(z) = 1",
        known, "x", "y", "z")
    if result.valid or result.failed_equation != 2 { return 9 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "y/z = missing",
        known, "x", "y", "z")
    if result.valid or result.failed_equation != 2 { return 10 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "y/z = 1",
        known, "x", "x", "z")
    if result.valid { return 11 }

    known.count = 1
    known.symbols[0] = MathDimensionSymbol {
        name: "duration", dimension: time
    }
    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = duration³*1m³", "x/y = 1", "y/z = 1",
        known, "x", "y", "z")
    let length_time: Dimension = product_dimension(length, time)
    if not result.valid or not same_dimension(result.first, length_time) or
       not same_dimension(result.second, length_time) or
       not same_dimension(result.third, length_time) { return 12 }

    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "y/z = 1",
        known, "x", "y", "duration")
    if result.valid { return 13 }

    known.count = 6
    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "y/z = 1",
        known, "x", "y", "z")
    if result.valid { return 14 }

    known.count = -1
    result = solve_math_equations_three_unknown_dimensions(
        "x*y*z = 1m³", "x/y = 1", "y/z = 1",
        known, "x", "y", "z")
    if result.valid { return 15 }
    print("native-math-dimension-triple-ok")
    return 0
}
