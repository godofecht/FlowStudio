# Executable native Flow 2.0 bounded equation-system parsing and residuals.
# flow run src/math_equation_system_smoke.flow
import .math_dimensions { dimensionless, length_dimension, time_dimension, temperature_dimension, quotient_dimension, product_dimension, quantity, same_dimension }
import .math_expression_source { MathBindings, MathSymbol, empty_math_bindings }
import .math_equation_system { MathEquationSystem, MathEquationSystemResult, MathEquationTolerances, empty_math_equation_tolerances, parse_math_equation_system, parse_math_equation_system_with_bindings, evaluate_math_equation_system }

function near(a: f64, b: f64) -> bool {
    let mut difference: f64 = a - b
    if difference < 0.0 { difference = -difference }
    return difference < 0.00000000001
}

function main() -> i32 {
    let mut system: MathEquationSystem = parse_math_equation_system("3m+2m=5m;2s=2s;3K=3K")
    if not system.valid or system.count != 3 or system.source_length != 20 or
       system.equations[1].equality_at != 11 or
       system.equations[1].right.instructions[0].source_start != 12 or
       system.equations[2].left.instructions[0].source_start != 15 { return 1 }
    let mut tolerances: MathEquationTolerances = empty_math_equation_tolerances()
    tolerances.count = 3
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, time_dimension())
    tolerances.values[2] = quantity(0.0, temperature_dimension())
    let mut result: MathEquationSystemResult = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 3 or
       not near(result.results[0].residual.value, 0.0) or
       not same_dimension(result.results[1].residual.dimension, time_dimension()) { return 2 }

    system = parse_math_equation_system("3m+2m=5m;2s=3s;3K=3K")
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or result.satisfied or result.count != 3 or
       result.results[1].satisfied or not near(result.results[1].residual.value, -1.0) { return 3 }
    tolerances.values[1] = quantity(1.0, time_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 4 }
    tolerances.values[1] = quantity(0.0, time_dimension())

    tolerances.count = 2
    system = parse_math_equation_system("1m+2m=3m;4s/0=2s")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 11 { return 5 }
    system = parse_math_equation_system("1m+2m=3m;1m+1s=2m")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 11 { return 6 }
    system = parse_math_equation_system("1m+2m=3m;2s=2m")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 11 { return 7 }

    system = parse_math_equation_system("1m+2m=3m;;2s=2s")
    if system.valid or system.failed_equation != 1 or system.failed_at != 9 { return 8 }
    system = parse_math_equation_system("1m+2m=3m;")
    if system.valid or system.failed_equation != 1 or system.failed_at != 9 { return 9 }
    system = parse_math_equation_system("1=(2;3)")
    if system.valid or system.failed_at != 4 { return 10 }
    system = parse_math_equation_system("1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m")
    if not system.valid or system.count != 9 { return 11 }

    system = parse_math_equation_system("1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m")
    if not system.valid or system.count != 8 { return 12 }
    tolerances.count = 8
    let mut i: i32 = 0
    while i < 8 {
        tolerances.values[i] = quantity(0.0, length_dimension())
        i = i + 1
    }
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 8 { return 13 }
    tolerances.count = 7
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != -1 { return 14 }

    let mut bindings: MathBindings = empty_math_bindings()
    bindings.count = 1
    bindings.symbols[0] = MathSymbol { name: "α", value: quantity(3.0, length_dimension()) }
    system = parse_math_equation_system_with_bindings("α+2m=5m;α/3=1m", bindings)
    if not system.valid or system.count != 2 or
       system.equations[1].left.instructions[0].source_start != 9 { return 15 }
    tolerances.count = 2
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, length_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 16 }

    # Eight heterogeneous equations exercise the production compiler's
    # Unicode byte spans, nested functions, unit algebra and tolerance vector.
    # The source is 122 UTF-8 bytes; all positions below are byte offsets.
    let mixed_source: string = "2×(3m−1m)=4m;9m∕3s=3m/1s;where(1<2,5K,6K)=5K;ln(exp(1))=1;2m³/4m²=0.5m;3m⁻²=1m⁻²/9;exp(0)=1;1e-6m+2e-6m=3e-6m"
    system = parse_math_equation_system(mixed_source)
    if not system.valid or system.count != 8 or system.source_length != 122 or
       system.equations[0].equality_at != 12 or
       system.equations[1].equality_at != 23 or
       system.equations[5].equality_at != 85 or
       system.equations[7].equality_at != 116 or
       system.equations[7].right.instructions[0].source_start != 117 { return 17 }
    let speed = quotient_dimension(length_dimension(), time_dimension())
    let inverse_area = quotient_dimension(
        dimensionless(), product_dimension(length_dimension(), length_dimension()))
    tolerances.count = 8
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, speed)
    tolerances.values[2] = quantity(0.0, temperature_dimension())
    tolerances.values[3] = quantity(0.0000000001, dimensionless())
    tolerances.values[4] = quantity(0.0, length_dimension())
    tolerances.values[5] = quantity(0.0000000001, inverse_area)
    tolerances.values[6] = quantity(0.0, dimensionless())
    tolerances.values[7] = quantity(0.000000000001, length_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 8 or
       not same_dimension(result.results[1].residual.dimension, speed) or
       not same_dimension(result.results[5].residual.dimension, inverse_area) or
       not near(result.results[7].residual.value, 0.0) { return 18 }

    # A late numerical disagreement must be distinct from a compiler/runtime
    # failure, and changing only its physical tolerance changes satisfaction.
    system = parse_math_equation_system(
        "2×(3m−1m)=4m;9m∕3s=3m/1s;where(1<2,5K,6K)=5K;ln(exp(1))=1;2m³/4m²=0.5m;3m⁻²=1m⁻²/9;exp(0)=1;1e-6m+2e-6m=4e-6m")
    tolerances.values[7] = quantity(0.0000009, length_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or result.satisfied or result.results[7].satisfied or
       not near(result.results[7].residual.value, -0.000001) { return 19 }
    tolerances.values[7] = quantity(0.0000011, length_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 20 }

    # A dimension error in equation eight must preserve its global source
    # byte offset, rather than returning an offset relative to the fragment.
    system = parse_math_equation_system(
        "2×(3m−1m)=4m;9m∕3s=3m/1s;where(1<2,5K,6K)=5K;ln(exp(1))=1;2m³/4m²=0.5m;3m⁻²=1m⁻²/9;exp(0)=1;1e-6m+2e-6m=3e-6s")
    if not system.valid { return 21 }
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 7 or result.failed_at != 116 { return 22 }
    system = parse_math_equation_system("1m=1m;1m=1m;foo=1m")
    if system.valid or system.failed_equation != 2 or system.failed_at != 12 { return 23 }

    # Sixteen independently dimensioned equations run through the same native
    # typed parser and evaluator. The last expression is not a fixture stub.
    let sixteen_source: string = "1m=1m;1s=1s;1K=1K;1=1;2m=2m;2s=2s;2K=2K;2=2;3m=3m;3s=3s;3K=3K;3=3;4m=4m;4s=4s;4K=4K;4=4"
    system = parse_math_equation_system(sixteen_source)
    if not system.valid or system.count != 16 or system.source_length != 87 or
       system.equations[8].equality_at != 46 or
       system.equations[15].equality_at != 85 or
       system.equations[15].right.instructions[0].source_start != 86 { return 24 }
    tolerances.count = 16
    i = 0
    while i < 16 {
        tolerances.values[i] = quantity(0.0, length_dimension())
        tolerances.values[i + 1] = quantity(0.0, time_dimension())
        tolerances.values[i + 2] = quantity(0.0, temperature_dimension())
        tolerances.values[i + 3] = quantity(0.0, dimensionless())
        i = i + 4
    }
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 16 or
       not same_dimension(result.results[13].residual.dimension, time_dimension()) or
       not near(result.results[15].residual.value, 0.0) { return 25 }

    # Numerical disagreement in equation sixteen is not invalid execution.
    system = parse_math_equation_system(
        "1m=1m;1s=1s;1K=1K;1=1;2m=2m;2s=2s;2K=2K;2=2;3m=3m;3s=3s;3K=3K;3=3;4m=4m;4s=4s;4K=4K;4=5")
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or result.satisfied or result.results[15].satisfied or
       not near(result.results[15].residual.value, -1.0) { return 26 }
    tolerances.values[15] = quantity(1.0, dimensionless())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 27 }
    tolerances.values[15] = quantity(0.0, dimensionless())

    # A late dimensional error reports the original full-source byte offset.
    system = parse_math_equation_system(
        "1m=1m;1s=1s;1K=1K;1=1;2m=2m;2s=2s;2K=2K;2=2;3m=3m;3s=3s;3K=3K;3=3;4m=4m;4s=4s;4K=4K;4m=4s")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 15 or result.failed_at != 86 { return 28 }

    # Seventeen equations exceed the bounded native storage and fail closed.
    system = parse_math_equation_system("1m=1m;1s=1s;1K=1K;1=1;2m=2m;2s=2s;2K=2K;2=2;3m=3m;3s=3s;3K=3K;3=3;4m=4m;4s=4s;4K=4K;4=4;1=1")
    if system.valid or system.failed_equation != 16 or system.failed_at != 88 { return 29 }
    system = parse_math_equation_system(sixteen_source)
    tolerances.count = 15
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != -1 { return 30 }

    # LF and CRLF are native equation separators; offsets remain UTF-8 byte positions.
    system = parse_math_equation_system("1m=1m\n 2s=2s\r\n3K=3K\n")
    if not system.valid or system.count != 3 or system.source_length != 20 or
       system.equations[1].equality_at != 9 or
       system.equations[1].left.instructions[0].source_start != 7 or
       system.equations[2].right.instructions[0].source_start != 17 { return 31 }
    tolerances.count = 3
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, time_dimension())
    tolerances.values[2] = quantity(0.0, temperature_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 3 { return 32 }

    # Blank lines, indentation, and semicolon-plus-newline are accepted.
    system = parse_math_equation_system(" \n1m=1m\n\n 2s=2s\n")
    if not system.valid or system.count != 2 { return 33 }
    system = parse_math_equation_system("1m=1m;\n2s=2s")
    if not system.valid or system.count != 2 { return 34 }
    system = parse_math_equation_system("1m=1m;\n")
    if system.valid or system.failed_equation != 1 { return 35 }
    system = parse_math_equation_system("\n \r\n")
    if system.valid { return 36 }

    # Parenthesized line breaks are expression whitespace, not equation boundaries.
    system = parse_math_equation_system("1m=(1m+\n0m)\n2s=2s")
    if not system.valid or system.count != 2 { return 37 }
    tolerances.count = 2
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 38 }

    # An invalid later equation reports the original complete-source position.
    system = parse_math_equation_system("1m=1m\n2s=2m")
    if not system.valid or system.count != 2 { return 39 }
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 8 { return 40 }
    system = parse_math_equation_system("1m+\n2m=3m")
    if system.valid or system.failed_equation != 0 { return 41 }

    println("native-math-equation-system-ok")
    return 0
}
