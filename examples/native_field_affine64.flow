# Real upstream Flow 2.0 field/boundary/laplacian lowering with unequal
# nonzero Dirichlet ends. A linear equilibrium plus two independent sine modes.
# All 64 cells are checked against analytic semidiscrete Euler eigenvalues.
# Run: flow run examples/native_field_affine64.flow
import "stdlib/dynamics/pde.flow"

const N: i32 = 64
const RATIO: f64 = 0.4

field U : f64[64] on Line
U evolves as laplacian(U)
boundary U { left = 1.0  right = 2.0 }

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

# Fail closed before invoking the compiler-generated explicit Euler stencil.
# 4096 steps x 64 cells <= 262144 cell-steps. No partial output on failure.
function integrate(initial: ptr<f64>, output: ptr<f64>, ratio: f64, steps: i32) -> bool {
    if steps < 0 or steps > 4096 or ratio != ratio or
       ratio < 0.0 or ratio > 0.5 { return false }
    let current: array<f64, 64> = [0.0]
    let next: array<f64, 64> = [0.0]
    for i in 0 to N {
        if initial[i] != initial[i] or
           initial[i] < -1000000.0 or initial[i] > 1000000.0 { return false }
        current[i] = initial[i]
    }
    if current[0] != 1.0 or current[N - 1] != 2.0 { return false }
    for step in 0 to steps {
        U_field_step(current, next, ratio)
        field_copy_1d(next, current, N)
        for i in 0 to N {
            if current[i] != current[i] or
               current[i] < -1000000.0 or current[i] > 1000000.0 { return false }
        }
    }
    for i in 0 to N { output[i] = current[i] }
    return true
}

