# Real Flow 2.0 nine-state, 3x3 periodic anisotropic heat evolution.
# Unlike 2x2 grids, both periodic neighbors are distinct on each axis.
# Flow's compiler generates the RK4 stepping function; no Python runtime.
# Discrete Fourier eigenvalues: lambda_x = -3*Dx/dx^2 = -0.24,
# lambda_y = -3*Dy/dy^2 = -0.48, lambda_xy = -0.72.
# Initial field = 3 + 0.6 cx + 0.2 sx - 0.4 cy - 0.17 sy
#                 + 0.3 cx cy + 0.11 sx sy + 0.09 sx cy - 0.07 cx sy,
# where cx = cos(2pi*x/3), sx = sin(2pi*x/3), likewise for y.
# All nine initial cells differ, exercising genuinely distinct neighbors.
# Exact semidiscrete solution: multiply each Fourier amplitude by exp(lambda*t).
# Run: flow run examples/native_evolution_heat3x3.flow

flow PeriodicHeat3x3 {
    state northwest: f64 = 3.5
    state north: f64 = 2.4011473670974874
    state northeast: f64 = 1.8988526329025126
    state west: f64 = 3.442153903091735
    state center: f64 = 3.074820508075689
    state east: f64 = 2.6413526329025125
    state southwest: f64 = 3.8578460969082653
    state south: f64 = 3.143647367097487
    state southeast: f64 = 3.0401794919243113

    param diffusivity_x: f64 = 0.02
    param diffusivity_y: f64 = 0.04
    param spacing_x: f64 = 0.5
    param spacing_y: f64 = 0.5

    solver { dt 1 ms method rk4 }

    northwest evolves as diffusivity_x * (northeast + north - 2.0 * northwest) / (spacing_x * spacing_x) + diffusivity_y * (southwest + west - 2.0 * northwest) / (spacing_y * spacing_y)
    north evolves as diffusivity_x * (northwest + northeast - 2.0 * north) / (spacing_x * spacing_x) + diffusivity_y * (south + center - 2.0 * north) / (spacing_y * spacing_y)
    northeast evolves as diffusivity_x * (north + northwest - 2.0 * northeast) / (spacing_x * spacing_x) + diffusivity_y * (southeast + east - 2.0 * northeast) / (spacing_y * spacing_y)
    west evolves as diffusivity_x * (east + center - 2.0 * west) / (spacing_x * spacing_x) + diffusivity_y * (northwest + southwest - 2.0 * west) / (spacing_y * spacing_y)
    center evolves as diffusivity_x * (west + east - 2.0 * center) / (spacing_x * spacing_x) + diffusivity_y * (north + south - 2.0 * center) / (spacing_y * spacing_y)
    east evolves as diffusivity_x * (center + west - 2.0 * east) / (spacing_x * spacing_x) + diffusivity_y * (northeast + southeast - 2.0 * east) / (spacing_y * spacing_y)
    southwest evolves as diffusivity_x * (southeast + south - 2.0 * southwest) / (spacing_x * spacing_x) + diffusivity_y * (west + northwest - 2.0 * southwest) / (spacing_y * spacing_y)
    south evolves as diffusivity_x * (southwest + southeast - 2.0 * south) / (spacing_x * spacing_x) + diffusivity_y * (center + north - 2.0 * south) / (spacing_y * spacing_y)
    southeast evolves as diffusivity_x * (south + southwest - 2.0 * southeast) / (spacing_x * spacing_x) + diffusivity_y * (east + northeast - 2.0 * southeast) / (spacing_y * spacing_y)
}
# Additional nine-state, genuinely non-reversible 2D directed transport.
# The native compiler generates RK4; the reference is a product of two
# independent three-state Fourier/Poisson Markov transition kernels.
# Each directed axis has a complex-conjugate Fourier eigenvalue pair.
flow DirectedTransport3x3 {
    state northwest: f64 = 1.0
    state north: f64 = 0.0
    state northeast: f64 = 0.0
    state west: f64 = 0.0
    state center: f64 = 0.0
    state east: f64 = 0.0
    state southwest: f64 = 0.0
    state south: f64 = 0.0
    state southeast: f64 = 0.0

    param drift_x: f64 = 0.7
    param drift_y: f64 = 0.35
    param diffusion_x: f64 = 0.12
    param diffusion_y: f64 = 0.08

    solver { dt 1 ms method rk4 }

    northwest evolves as drift_x * (northeast - northwest) + drift_y * (southwest - northwest) + diffusion_x * (northeast + north - 2.0 * northwest) + diffusion_y * (southwest + west - 2.0 * northwest)
    north evolves as drift_x * (northwest - north) + drift_y * (south - north) + diffusion_x * (northwest + northeast - 2.0 * north) + diffusion_y * (south + center - 2.0 * north)
    northeast evolves as drift_x * (north - northeast) + drift_y * (southeast - northeast) + diffusion_x * (north + northwest - 2.0 * northeast) + diffusion_y * (southeast + east - 2.0 * northeast)
    west evolves as drift_x * (east - west) + drift_y * (northwest - west) + diffusion_x * (east + center - 2.0 * west) + diffusion_y * (northwest + southwest - 2.0 * west)
    center evolves as drift_x * (west - center) + drift_y * (north - center) + diffusion_x * (west + east - 2.0 * center) + diffusion_y * (north + south - 2.0 * center)
    east evolves as drift_x * (center - east) + drift_y * (northeast - east) + diffusion_x * (center + west - 2.0 * east) + diffusion_y * (northeast + southeast - 2.0 * east)
    southwest evolves as drift_x * (southeast - southwest) + drift_y * (west - southwest) + diffusion_x * (southeast + south - 2.0 * southwest) + diffusion_y * (west + northwest - 2.0 * southwest)
    south evolves as drift_x * (southwest - south) + drift_y * (center - south) + diffusion_x * (southwest + southeast - 2.0 * south) + diffusion_y * (center + north - 2.0 * south)
    southeast evolves as drift_x * (south - southeast) + drift_y * (east - southeast) + diffusion_x * (south + southwest - 2.0 * southeast) + diffusion_y * (east + northeast - 2.0 * southeast)
}

struct DirectedRun3x3 {
    valid: bool,
    state: DirectedTransport3x3
}

struct HeatRun3x3 {
    valid: bool,
    state: PeriodicHeat3x3
}

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

function maximum(first: f64, second: f64) -> f64 {
    if first > second { return first }
    return second
}

function maxDifference(first: PeriodicHeat3x3, second: PeriodicHeat3x3) -> f64 {
    let mut error: f64 = 0.0
    error = maximum(error, absolute(first.northwest - second.northwest))
    error = maximum(error, absolute(first.north - second.north))
    error = maximum(error, absolute(first.northeast - second.northeast))
    error = maximum(error, absolute(first.west - second.west))
    error = maximum(error, absolute(first.center - second.center))
    error = maximum(error, absolute(first.east - second.east))
    error = maximum(error, absolute(first.southwest - second.southwest))
    error = maximum(error, absolute(first.south - second.south))
    error = maximum(error, absolute(first.southeast - second.southeast))
    return error
}

function meanTemperature(state: PeriodicHeat3x3) -> f64 {
    return (state.northwest + state.north + state.northeast + state.west + state.center + state.east + state.southwest + state.south + state.southeast) / 9.0
}

function validRun(state: PeriodicHeat3x3, duration: f64, steps: i32) -> bool {
    if steps <= 0 or steps > 100000 { return false }
    if not (duration >= 0.0 and duration <= 100.0) { return false }
    if not (state.spacing_x > 0.0 and state.spacing_x <= 100.0) { return false }
    if not (state.spacing_y > 0.0 and state.spacing_y <= 100.0) { return false }
    if not (state.diffusivity_x >= 0.0 and state.diffusivity_x <= 100.0) { return false }
    if not (state.diffusivity_y >= 0.0 and state.diffusivity_y <= 100.0) { return false }
    # Conservative RK4 step restriction, including invalid huge coefficients.
    let maximum_rate: f64 = 4.0 * (
        state.diffusivity_x / (state.spacing_x * state.spacing_x) +
        state.diffusivity_y / (state.spacing_y * state.spacing_y))
    return duration * maximum_rate / (steps as f64) <= 1.0
}

function runFrom(initial: PeriodicHeat3x3, duration: f64, steps: i32) -> HeatRun3x3 {
    if not validRun(initial, duration, steps) {
        return HeatRun3x3 { valid: false, state: initial }
    }
    let mut state: PeriodicHeat3x3 = initial
    let dt: f64 = duration / (steps as f64)
    for index in 0 to steps {
        PeriodicHeat3x3_step(&state, dt)
    }
    return HeatRun3x3 { valid: true, state: state }
}

function integrate(duration: f64, steps: i32) -> HeatRun3x3 {
    return runFrom(PeriodicHeat3x3_new(), duration, steps)
}

function analyticReference() -> PeriodicHeat3x3 {
    let mut reference: PeriodicHeat3x3 = PeriodicHeat3x3_new()
    reference.northwest = 3.370489036705467
    reference.north = 2.617671972476197
    reference.northeast = 2.269298920650966
    reference.west = 3.4021128060299306
    reference.center = 3.005364381120018
    reference.east = 2.6904929581942865
    reference.southwest = 3.643328307184398
    reference.south = 3.077742398048838
    reference.southeast = 2.9234992195898974
    return reference
}

function directedDifference(first: DirectedTransport3x3, second: DirectedTransport3x3) -> f64 {
    let mut error: f64 = 0.0
    error = maximum(error, absolute(first.northwest - second.northwest))
    error = maximum(error, absolute(first.north - second.north))
    error = maximum(error, absolute(first.northeast - second.northeast))
    error = maximum(error, absolute(first.west - second.west))
    error = maximum(error, absolute(first.center - second.center))
    error = maximum(error, absolute(first.east - second.east))
    error = maximum(error, absolute(first.southwest - second.southwest))
    error = maximum(error, absolute(first.south - second.south))
    error = maximum(error, absolute(first.southeast - second.southeast))
    return error
}

function directedTotal(state: DirectedTransport3x3) -> f64 {
    return state.northwest + state.north + state.northeast + state.west + state.center + state.east + state.southwest + state.south + state.southeast
}

function directedValid(state: DirectedTransport3x3, duration: f64, steps: i32) -> bool {
    if steps <= 0 or steps > 2048 { return false }
    if not (duration >= 0.0 and duration <= 10.0) { return false }
    if not (state.drift_x >= 0.0 and state.drift_x <= 10.0) { return false }
    if not (state.drift_y >= 0.0 and state.drift_y <= 10.0) { return false }
    if not (state.diffusion_x >= 0.0 and state.diffusion_x <= 10.0) { return false }
    if not (state.diffusion_y >= 0.0 and state.diffusion_y <= 10.0) { return false }
    let rate: f64 = state.drift_x + state.drift_y + 4.0 * state.diffusion_x + 4.0 * state.diffusion_y
    return duration * rate / (steps as f64) <= 0.75
}

function directedRunFrom(initial: DirectedTransport3x3, duration: f64, steps: i32) -> DirectedRun3x3 {
    if not directedValid(initial, duration, steps) {
        return DirectedRun3x3 { valid: false, state: initial }
    }
    let mut state: DirectedTransport3x3 = initial
    let dt: f64 = duration / (steps as f64)
    for index in 0 to steps {
        DirectedTransport3x3_step(&state, dt)
    }
    return DirectedRun3x3 { valid: true, state: state }
}

function directedIntegrate(duration: f64, steps: i32) -> DirectedRun3x3 {
    return directedRunFrom(DirectedTransport3x3_new(), duration, steps)
}

function directedReference() -> DirectedTransport3x3 {
    # Exact semidiscrete solution at t=1.3; all nine cells are asserted.
    # P_j(t) = (1 + 2 exp(-(3*a/2+3*d)t) cos(sqrt(3)*a*t/2-2*pi*j/3))/3.
    # The 2D kernel is P_x(x,t) * P_y(y,t), not continuum advection.
    let mut reference: DirectedTransport3x3 = DirectedTransport3x3_new()
    reference.northwest = 0.22919830244593897
    reference.north = 0.20265086984055189
    reference.northeast = 0.12919110089793504
    reference.west = 0.12315893802007188
    reference.center = 0.10889376427337671
    reference.east = 0.069420404158475710
    reference.southwest = 0.056166556132449370
    reference.south = 0.049660932627866076
    reference.southeast = 0.031659131603334292
    return reference
}

function directedAcceptance() -> i32 {
    let expected: DirectedTransport3x3 = directedReference()
    let coarse: DirectedRun3x3 = directedIntegrate(1.3, 4)
    let medium: DirectedRun3x3 = directedIntegrate(1.3, 8)
    let fine: DirectedRun3x3 = directedIntegrate(1.3, 16)
    let finest: DirectedRun3x3 = directedIntegrate(1.3, 64)
    if not coarse.valid or not medium.valid or not fine.valid or not finest.valid { return 101 }
    let error4: f64 = directedDifference(coarse.state, expected)
    let error8: f64 = directedDifference(medium.state, expected)
    let error16: f64 = directedDifference(fine.state, expected)
    let error64: f64 = directedDifference(finest.state, expected)
    if error4 < 0.0001 or error64 > 0.000000005 { return 102 }
    if error8 >= error4 * 0.08 or error16 >= error8 * 0.08 or error64 >= error16 * 0.01 { return 103 }
    if absolute(directedTotal(finest.state) - 1.0) > 0.000000000001 { return 104 }
    if finest.state.northwest <= 0.0 or
       finest.state.north <= 0.0 or
       finest.state.northeast <= 0.0 or
       finest.state.west <= 0.0 or
       finest.state.center <= 0.0 or
       finest.state.east <= 0.0 or
       finest.state.southwest <= 0.0 or
       finest.state.south <= 0.0 or
       finest.state.southeast <= 0.0 { return 105 }
    if finest.state.north <= finest.state.northeast + 0.05 or
       finest.state.west <= finest.state.southwest + 0.05 { return 106 }
    let replay: DirectedRun3x3 = directedIntegrate(1.3, 64)
    if not replay.valid or directedDifference(replay.state, finest.state) > 0.000000000001 { return 107 }
    let half: DirectedRun3x3 = directedIntegrate(0.65, 32)
    if not half.valid { return 108 }
    let composed: DirectedRun3x3 = directedRunFrom(half.state, 0.65, 32)
    if not composed.valid or directedDifference(composed.state, finest.state) > 0.000000000001 { return 109 }

    # Periodic translation by one column must commute with the native solver.
    let mut shiftedInitial: DirectedTransport3x3 = DirectedTransport3x3_new()
    shiftedInitial.northwest = 0.0
    shiftedInitial.north = 1.0
    let shifted: DirectedRun3x3 = directedRunFrom(shiftedInitial, 1.3, 64)
    let mut shiftedExpected: DirectedTransport3x3 = finest.state
    shiftedExpected.northwest = finest.state.northeast
    shiftedExpected.north = finest.state.northwest
    shiftedExpected.northeast = finest.state.north
    shiftedExpected.west = finest.state.east
    shiftedExpected.center = finest.state.west
    shiftedExpected.east = finest.state.center
    shiftedExpected.southwest = finest.state.southeast
    shiftedExpected.south = finest.state.southwest
    shiftedExpected.southeast = finest.state.south
    if not shifted.valid or directedDifference(shifted.state, shiftedExpected) > 0.000000000001 { return 110 }

    # Scaling every rate by 1/2 and time by 2 leaves the trajectory unchanged.
    let mut scaledInitial: DirectedTransport3x3 = DirectedTransport3x3_new()
    scaledInitial.drift_x = 0.35
    scaledInitial.drift_y = 0.175
    scaledInitial.diffusion_x = 0.06
    scaledInitial.diffusion_y = 0.04
    let scaled: DirectedRun3x3 = directedRunFrom(scaledInitial, 2.6, 64)
    if not scaled.valid or directedDifference(scaled.state, finest.state) > 0.000000000001 { return 111 }

    let mut uniform: DirectedTransport3x3 = DirectedTransport3x3_new()
    uniform.northwest = 1.0 / 9.0
    uniform.north = 1.0 / 9.0
    uniform.northeast = 1.0 / 9.0
    uniform.west = 1.0 / 9.0
    uniform.center = 1.0 / 9.0
    uniform.east = 1.0 / 9.0
    uniform.southwest = 1.0 / 9.0
    uniform.south = 1.0 / 9.0
    uniform.southeast = 1.0 / 9.0
    let equilibrium: DirectedRun3x3 = directedRunFrom(uniform, 1.3, 64)
    if not equilibrium.valid or directedDifference(equilibrium.state, uniform) > 0.000000000001 { return 112 }
    let zeroDuration: DirectedRun3x3 = directedIntegrate(0.0, 8)
    if not zeroDuration.valid or directedDifference(zeroDuration.state, DirectedTransport3x3_new()) > 0.000000000001 { return 113 }
    let mut frozen: DirectedTransport3x3 = DirectedTransport3x3_new()
    frozen.drift_x = 0.0
    frozen.drift_y = 0.0
    frozen.diffusion_x = 0.0
    frozen.diffusion_y = 0.0
    let stationary: DirectedRun3x3 = directedRunFrom(frozen, 1.3, 8)
    if not stationary.valid or directedDifference(stationary.state, frozen) > 0.000000000001 { return 114 }

    if directedIntegrate(1.3, 0).valid or directedIntegrate(1.3, 2049).valid { return 115 }
    if directedIntegrate(-1.0, 64).valid or directedIntegrate(10.1, 64).valid { return 116 }
    if directedIntegrate(1.3, 1).valid { return 117 }
    let mut invalid: DirectedTransport3x3 = DirectedTransport3x3_new()
    invalid.drift_x = -0.01
    if directedRunFrom(invalid, 1.3, 64).valid { return 118 }
    invalid = DirectedTransport3x3_new()
    invalid.diffusion_y = -0.01
    if directedRunFrom(invalid, 1.3, 64).valid { return 119 }
    invalid = DirectedTransport3x3_new()
    invalid.drift_y = 10.1
    if directedRunFrom(invalid, 1.3, 64).valid { return 120 }

    println("native-directed-transport3x3-ok")
    return 0
}

function main() -> i32 {
    let reference: PeriodicHeat3x3 = analyticReference()
    let coarse: HeatRun3x3 = integrate(1.0, 4)
    let medium: HeatRun3x3 = integrate(1.0, 8)
    let fine: HeatRun3x3 = integrate(1.0, 16)
    let finest: HeatRun3x3 = integrate(1.0, 64)
    if not coarse.valid or not medium.valid or not fine.valid or not finest.valid { return 1 }
    let error4: f64 = maxDifference(coarse.state, reference)
    let error8: f64 = maxDifference(medium.state, reference)
    let error16: f64 = maxDifference(fine.state, reference)
    let error64: f64 = maxDifference(finest.state, reference)
    if error4 < 0.0000001 { return 2 }
    if error64 > 0.0000000001 { return 3 }
    if error8 >= error4 * 0.08 { return 4 }
    if error16 >= error8 * 0.08 { return 5 }
    if absolute(meanTemperature(finest.state) - 3.0) > 0.000000000001 { return 6 }

    let replay: HeatRun3x3 = integrate(1.0, 64)
    if not replay.valid or maxDifference(replay.state, finest.state) > 0.000000000001 { return 7 }
    let half: HeatRun3x3 = integrate(0.5, 32)
    if not half.valid { return 8 }
    let secondHalf: HeatRun3x3 = runFrom(half.state, 0.5, 32)
    if not secondHalf.valid or maxDifference(secondHalf.state, finest.state) > 0.000000000001 { return 9 }

    # Transposition of the grid and diffusivity tensor must commute with evolution.
    let initial: PeriodicHeat3x3 = PeriodicHeat3x3_new()
    let mut transposed: PeriodicHeat3x3 = initial
    transposed.north = initial.west
    transposed.northeast = initial.southwest
    transposed.west = initial.north
    transposed.east = initial.south
    transposed.southwest = initial.northeast
    transposed.south = initial.east
    transposed.diffusivity_x = 0.04
    transposed.diffusivity_y = 0.02
    let transposedRun: HeatRun3x3 = runFrom(transposed, 1.0, 64)
    let mut transposedExpected: PeriodicHeat3x3 = finest.state
    transposedExpected.north = finest.state.west
    transposedExpected.northeast = finest.state.southwest
    transposedExpected.west = finest.state.north
    transposedExpected.east = finest.state.south
    transposedExpected.southwest = finest.state.northeast
    transposedExpected.south = finest.state.east
    if not transposedRun.valid or
       maxDifference(transposedRun.state, transposedExpected) > 0.000000000001 { return 10 }

    let mut uniform: PeriodicHeat3x3 = PeriodicHeat3x3_new()
    uniform.northwest = 7.0
    uniform.north = 7.0
    uniform.northeast = 7.0
    uniform.west = 7.0
    uniform.center = 7.0
    uniform.east = 7.0
    uniform.southwest = 7.0
    uniform.south = 7.0
    uniform.southeast = 7.0
    let equilibrium: HeatRun3x3 = runFrom(uniform, 1.0, 64)
    if not equilibrium.valid or maxDifference(equilibrium.state, uniform) > 0.000000000001 { return 11 }
    let mut frozen: PeriodicHeat3x3 = PeriodicHeat3x3_new()
    frozen.diffusivity_x = 0.0
    frozen.diffusivity_y = 0.0
    let stationary: HeatRun3x3 = runFrom(frozen, 1.0, 8)
    if not stationary.valid or maxDifference(stationary.state, frozen) > 0.000000000001 { return 12 }

    if integrate(1.0, 0).valid { return 13 }
    if integrate(1.0, 100001).valid { return 14 }
    if integrate(-1.0, 64).valid { return 15 }
    if integrate(100.1, 64).valid { return 16 }
    let mut invalid: PeriodicHeat3x3 = PeriodicHeat3x3_new()
    invalid.spacing_x = 0.0
    if runFrom(invalid, 1.0, 64).valid { return 17 }
    invalid = PeriodicHeat3x3_new()
    invalid.diffusivity_y = -0.04
    if runFrom(invalid, 1.0, 64).valid { return 18 }
    invalid = PeriodicHeat3x3_new()
    invalid.diffusivity_x = 100.1
    if runFrom(invalid, 1.0, 64).valid { return 19 }
    invalid = PeriodicHeat3x3_new()
    invalid.diffusivity_x = 1.0
    if runFrom(invalid, 1.0, 1).valid { return 20 }

    let directedStatus: i32 = directedAcceptance()
    if directedStatus != 0 { return directedStatus }
    println("native-evolution-heat3x3-ok")
    return 0
}
