# Actual native Flow 2.0 execution of typed mathematical postfix IR.
# flow run src/math_expression_ir_smoke.flow
import .math_dimensions { Dimension, Quantity, dimensionless, length_dimension, time_dimension, quotient_dimension, same_dimension, quantity }
import .math_expression_ir { MathInstruction, MathProgram, MathResult, evaluate_math_ir }

function instruction(opcode: i32, literal: Quantity, exponent: i32, position: i32) -> MathInstruction {
    return MathInstruction {
        opcode: opcode, literal: literal, exponent: exponent,
        source_start: position, source_end: position + 1
    }
}

function close(first: f64, second: f64) -> bool {
    let mut difference: f64 = first - second
    if difference < 0.0 { difference = -difference }
    return difference < 0.000000000001
}

function main() -> i32 {
    let blank: MathInstruction = instruction(0, quantity(0.0, dimensionless()), 0, 0)
    let mut operations: array<MathInstruction, 64> = [blank]
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let speed: Dimension = quotient_dimension(length, time)

    # (3 m / 2 s) + 4 m/s = 5.5 m/s
    operations[0] = instruction(0, quantity(3.0, length), 0, 0)
    operations[1] = instruction(0, quantity(2.0, time), 0, 1)
    operations[2] = instruction(4, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(4.0, speed), 0, 3)
    operations[4] = instruction(1, quantity(0.0, dimensionless()), 0, 4)
    let mut program: MathProgram = MathProgram {
        instructions: operations, count: 5, source_length: 5
    }
    let mut result: MathResult = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, 5.5) { return 1 }
    if not same_dimension(result.result.dimension, speed) or result.failed_at != -1 { return 2 }

    # Incorrect physical addition must fail at the original source byte offset.
    operations[3] = instruction(0, quantity(4.0, time), 0, 3)
    program = MathProgram { instructions: operations, count: 5, source_length: 5 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 4 { return 3 }

    # Zero denominator is rejected, never converted to infinity.
    operations[1] = instruction(0, quantity(0.0, time), 0, 1)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 4 }

    # Negative integer powers invert values and physical dimensions.
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(6, quantity(0.0, dimensionless()), -2, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    let inverse_area: Dimension = Dimension { length: -2, mass: 0, time: 0, temperature: 0 }
    if not result.valid or not close(result.result.value, 0.25) { return 5 }
    if not same_dimension(result.result.dimension, inverse_area) { return 6 }

    operations[0] = instruction(0, quantity(0.0, length), 0, 0)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    if evaluate_math_ir(program).valid { return 7 }

    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(6, quantity(0.0, dimensionless()), 9, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    if evaluate_math_ir(program).valid { return 8 }

    # Reject dimensional overflow, even for numerically small values.
    let fifth_length: Dimension = Dimension { length: 5, mass: 0, time: 0, temperature: 0 }
    operations[0] = instruction(0, quantity(2.0, fifth_length), 0, 0)
    operations[1] = instruction(6, quantity(0.0, dimensionless()), 8, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    if evaluate_math_ir(program).valid { return 9 }

    operations[0] = instruction(1, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    if evaluate_math_ir(program).valid { return 10 }

    operations[0] = instruction(42, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    if evaluate_math_ir(program).valid { return 11 }

    operations[0] = instruction(0, quantity(1.0, length), 0, 0)
    operations[1] = instruction(0, quantity(2.0, length), 0, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 12 }

    program = MathProgram { instructions: operations, count: 2, source_length: 1 }
    if evaluate_math_ir(program).valid { return 13 }
    program = MathProgram { instructions: operations, count: 65, source_length: 65 }
    if evaluate_math_ir(program).valid { return 14 }

    # Unary negation, multiplication and subtraction on a nested expression.
    operations[0] = instruction(0, quantity(3.0, length), 0, 0)
    operations[1] = instruction(5, quantity(0.0, dimensionless()), 0, 1)
    operations[2] = instruction(0, quantity(2.0, time), 0, 2)
    operations[3] = instruction(3, quantity(0.0, dimensionless()), 0, 3)
    operations[4] = instruction(0, quantity(1.0, dimensionless()), 0, 4)
    operations[5] = instruction(6, quantity(0.0, dimensionless()), 0, 5)
    program = MathProgram { instructions: operations, count: 6, source_length: 6 }
    result = evaluate_math_ir(program)
    let length_time: Dimension = Dimension { length: 1, mass: 0, time: 1, temperature: 0 }
    if result.valid { return 15 } # Two remaining values are not a valid expression.
    operations[4] = instruction(0, quantity(1.0, length_time), 0, 4)
    operations[5] = instruction(2, quantity(0.0, dimensionless()), 0, 5)
    program = MathProgram { instructions: operations, count: 6, source_length: 6 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, -7.0) { return 16 }
    if not same_dimension(result.result.dimension, length_time) { return 17 }

    # Unit-preserving minimum and maximum, including an exact equal-value tie.
    operations[0] = instruction(0, quantity(9.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(7, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 3.0 or
       not same_dimension(result.result.dimension, length) { return 18 }
    operations[2] = instruction(8, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 9.0 { return 19 }
    operations[1] = instruction(0, quantity(9.0, length), 0, 1)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 9.0 { return 20 }

    # A physical clamp consumes value, lower bound and upper bound in that order.
    operations[0] = instruction(0, quantity(-3.0, length), 0, 0)
    operations[1] = instruction(0, quantity(0.0, length), 0, 1)
    operations[2] = instruction(0, quantity(5.0, length), 0, 2)
    operations[3] = instruction(9, quantity(0.0, dimensionless()), 0, 3)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 0.0 or
       not same_dimension(result.result.dimension, length) { return 21 }
    operations[0] = instruction(0, quantity(8.0, length), 0, 0)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 5.0 { return 22 }
    operations[0] = instruction(0, quantity(2.5, length), 0, 0)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 2.5 { return 23 }

    # Nested arithmetic feeding a bounded nonlinear piecewise operator:
    # clamp((9 metres - 2 metres) * 2, 0 metres, 10 metres) == 10 metres.
    operations[0] = instruction(0, quantity(9.0, length), 0, 0)
    operations[1] = instruction(0, quantity(2.0, length), 0, 1)
    operations[2] = instruction(2, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(2.0, dimensionless()), 0, 3)
    operations[4] = instruction(3, quantity(0.0, dimensionless()), 0, 4)
    operations[5] = instruction(0, quantity(0.0, length), 0, 5)
    operations[6] = instruction(0, quantity(10.0, length), 0, 6)
    operations[7] = instruction(9, quantity(0.0, dimensionless()), 0, 7)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 10.0 or
       not same_dimension(result.result.dimension, length) { return 24 }

    # All three physical operands must have identical dimensions.
    operations[0] = instruction(0, quantity(9.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, time), 0, 1)
    operations[2] = instruction(7, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 25 }
    operations[2] = instruction(8, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 26 }

    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(0.0, length), 0, 1)
    operations[2] = instruction(0, quantity(5.0, time), 0, 2)
    operations[3] = instruction(9, quantity(0.0, dimensionless()), 0, 3)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 3 { return 27 }
    operations[1] = instruction(0, quantity(0.0, time), 0, 1)
    operations[2] = instruction(0, quantity(5.0, length), 0, 2)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 3 { return 28 }
    operations[1] = instruction(0, quantity(6.0, length), 0, 1)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 3 { return 29 }

    # Underflow and malformed byte spans fail at the offending instruction.
    operations[0] = instruction(9, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 0 { return 30 }
    operations[0] = instruction(0, quantity(1.0, length), 0, 0)
    operations[1] = instruction(0, quantity(2.0, length), 0, 1)
    operations[2] = instruction(7, quantity(0.0, dimensionless()), 0, 9)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 31 }

    # An otherwise valid physical minimum cannot bypass magnitude limits.
    operations[0] = instruction(0, quantity(1000000000000000000000000000000.0, length), 0, 0)
    operations[1] = instruction(0, quantity(1000000000000000000000000000000.0, length), 0, 1)
    operations[2] = instruction(1, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 32 }

    # Typed physical comparisons: ordering, equality and dimension rejection.
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or not result.is_predicate or result.result.value != 1.0 or
       not same_dimension(result.result.dimension, dimensionless()) { return 33 }
    operations[2] = instruction(11, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 1.0 { return 34 }
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    operations[2] = instruction(12, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 0.0 { return 35 }
    operations[2] = instruction(13, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 0.0 { return 36 }
    operations[2] = instruction(14, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 0.0 { return 37 }
    operations[2] = instruction(15, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 1.0 { return 38 }
    operations[1] = instruction(0, quantity(2.0, length), 0, 1)
    operations[2] = instruction(14, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    if evaluate_math_ir(program).result.value != 1.0 { return 39 }
    operations[1] = instruction(0, quantity(3.0, time), 0, 1)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 40 }

    # Two independently dimensioned comparisons combine into a boolean value.
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(5.0, time), 0, 3)
    operations[4] = instruction(0, quantity(4.0, time), 0, 4)
    operations[5] = instruction(12, quantity(0.0, dimensionless()), 0, 5)
    operations[6] = instruction(16, quantity(0.0, dimensionless()), 0, 6)
    program = MathProgram { instructions: operations, count: 7, source_length: 7 }
    result = evaluate_math_ir(program)
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 41 }
    operations[5] = instruction(10, quantity(0.0, dimensionless()), 0, 5)
    program = MathProgram { instructions: operations, count: 7, source_length: 7 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 0.0 { return 42 }
    operations[6] = instruction(17, quantity(0.0, dimensionless()), 0, 6)
    program = MathProgram { instructions: operations, count: 7, source_length: 7 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 1.0 { return 43 }
    operations[7] = instruction(18, quantity(0.0, dimensionless()), 0, 7)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if not result.valid or not result.is_predicate or result.result.value != 0.0 { return 44 }

    # where(condition, true_value, false_value) selects quantities with units.
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(9.0, length), 0, 3)
    operations[4] = instruction(0, quantity(4.0, length), 0, 4)
    operations[5] = instruction(2, quantity(0.0, dimensionless()), 0, 5)
    operations[6] = instruction(0, quantity(3.0, length), 0, 6)
    operations[7] = instruction(19, quantity(0.0, dimensionless()), 0, 7)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if not result.valid or result.is_predicate or result.result.value != 5.0 or
       not same_dimension(result.result.dimension, length) { return 45 }
    operations[2] = instruction(12, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 3.0 { return 46 }
    operations[6] = instruction(0, quantity(3.0, time), 0, 6)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 7 { return 47 }
    operations[6] = instruction(0, quantity(3.0, length), 0, 6)
    operations[2] = instruction(1, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 8, source_length: 8 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 7 { return 48 }

    # Predicates cannot be used as numbers; numbers cannot be logical operands.
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(1.0, dimensionless()), 0, 3)
    operations[4] = instruction(1, quantity(0.0, dimensionless()), 0, 4)
    program = MathProgram { instructions: operations, count: 5, source_length: 5 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 4 { return 49 }
    operations[4] = instruction(16, quantity(0.0, dimensionless()), 0, 4)
    program = MathProgram { instructions: operations, count: 5, source_length: 5 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 4 { return 50 }
    operations[4] = instruction(10, quantity(0.0, dimensionless()), 0, 4)
    program = MathProgram { instructions: operations, count: 5, source_length: 5 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 4 { return 51 }
    operations[0] = instruction(18, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 0 { return 52 }
    operations[0] = instruction(19, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 0 { return 53 }

    # Unit-preserving absolute and exact square roots of physical areas.
    let area: Dimension = Dimension { length: 2, mass: 0, time: 0, temperature: 0 }
    operations[0] = instruction(0, quantity(-9.0, area), 0, 0)
    operations[1] = instruction(20, quantity(0.0, dimensionless()), 0, 1)
    operations[2] = instruction(21, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.is_predicate or not close(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 54 }

    # A negative radicand, odd dimensions and predicate operands fail closed.
    operations[1] = instruction(21, quantity(0.0, dimensionless()), 0, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 1 { return 55 }
    operations[0] = instruction(0, quantity(9.0, length), 0, 0)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 1 { return 56 }
    operations[0] = instruction(0, quantity(2.0, length), 0, 0)
    operations[1] = instruction(0, quantity(3.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(21, quantity(0.0, dimensionless()), 0, 3)
    program = MathProgram { instructions: operations, count: 4, source_length: 4 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 3 { return 57 }

    # Hypotenuse is dimension-checked and scaled to avoid squaring overflow.
    operations[0] = instruction(0, quantity(-3.0, length), 0, 0)
    operations[1] = instruction(0, quantity(4.0, length), 0, 1)
    operations[2] = instruction(22, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.is_predicate or not close(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, length) { return 58 }
    operations[1] = instruction(0, quantity(4.0, time), 0, 1)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 59 }
    operations[1] = instruction(0, quantity(4.0, length), 0, 1)
    operations[2] = instruction(10, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(5.0, length), 0, 3)
    operations[4] = instruction(22, quantity(0.0, dimensionless()), 0, 4)
    program = MathProgram { instructions: operations, count: 5, source_length: 5 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 4 { return 60 }

    # Dimensioned Pythagorean identity: hypot(3m,4m) - sqrt(25m²) == 0m.
    operations[0] = instruction(0, quantity(3.0, length), 0, 0)
    operations[1] = instruction(0, quantity(4.0, length), 0, 1)
    operations[2] = instruction(22, quantity(0.0, dimensionless()), 0, 2)
    operations[3] = instruction(0, quantity(25.0, area), 0, 3)
    operations[4] = instruction(21, quantity(0.0, dimensionless()), 0, 4)
    operations[5] = instruction(2, quantity(0.0, dimensionless()), 0, 5)
    program = MathProgram { instructions: operations, count: 6, source_length: 6 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, 0.0) or
       not same_dimension(result.result.dimension, length) { return 61 }

    # Small and large roots must remain accurate and bounded.
    operations[0] = instruction(0, quantity(0.000000000000000000000000000001, area), 0, 0)
    operations[1] = instruction(21, quantity(0.0, dimensionless()), 0, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value < 0.000000000000000999 or
       result.result.value > 0.000000000000001001 { return 62 }
    operations[0] = instruction(0, quantity(1000000000000000000000000000000.0, area), 0, 0)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value < 999999999999000.0 or
       result.result.value > 1000000000001000.0 { return 63 }
    operations[0] = instruction(0, quantity(1000000000000000000000000000000.0, length), 0, 0)
    operations[1] = instruction(0, quantity(1000000000000000000000000000000.0, length), 0, 1)
    operations[2] = instruction(22, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 2 { return 64 }

    # Empty norm and zero root retain dimensions; invalid opcodes still fail.
    operations[0] = instruction(0, quantity(0.0, length), 0, 0)
    operations[1] = instruction(0, quantity(0.0, length), 0, 1)
    operations[2] = instruction(22, quantity(0.0, dimensionless()), 0, 2)
    program = MathProgram { instructions: operations, count: 3, source_length: 3 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 0.0 or
       not same_dimension(result.result.dimension, length) { return 65 }
    operations[0] = instruction(0, quantity(0.0, area), 0, 0)
    operations[1] = instruction(21, quantity(0.0, dimensionless()), 0, 1)
    program = MathProgram { instructions: operations, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if not result.valid or result.result.value != 0.0 or
       not same_dimension(result.result.dimension, length) { return 66 }
    operations[0] = instruction(23, quantity(0.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 0 { return 67 }


    # The full 64-slot IR executes a 32-component physical sum in postfix form.
    let mut cursor: i32 = 0
    while cursor < 32 {
        operations[cursor] = instruction(0, quantity(1.0, length), 0, cursor)
        cursor = cursor + 1
    }
    while cursor < 63 {
        operations[cursor] = instruction(1, quantity(0.0, dimensionless()), 0, cursor)
        cursor = cursor + 1
    }
    program = MathProgram { instructions: operations, count: 63, source_length: 63 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, 32.0) or
       not same_dimension(result.result.dimension, length) { return 68 }
    operations[63] = instruction(5, quantity(0.0, dimensionless()), 0, 63)
    program = MathProgram { instructions: operations, count: 64, source_length: 64 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, -32.0) or
       not same_dimension(result.result.dimension, length) { return 69 }
    program = MathProgram { instructions: operations, count: 65, source_length: 65 }
    result = evaluate_math_ir(program)
    if result.valid or result.failed_at != 0 { return 70 }

    # Typed Boolean literals are distinct from numerical dimensionless values.
    operations[0] = instruction(24, quantity(1.0, dimensionless()), 0, 0)
    program = MathProgram { instructions: operations, count: 1, source_length: 1 }
    result = evaluate_math_ir(program)
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 71 }
