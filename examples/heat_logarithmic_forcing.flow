# Executable typed logarithms in a periodic Fourier-mode heat source.
domain ThermalDomain {
    grid       = 32 × 32
    extent     = 1m × 1m
    boundaries = Periodic
}

model HeatEquation on ThermalDomain {
    const diffusivity = 0.01m²/s
    field temperature: Scalar<Kelvin>

    dynamics {
        ∂ₜtemperature = diffusivity ∇²temperature + 1K/s * (log(exp(sin(2πx / 1m))) + ln(exp(sin(2πx / 1m))) + log10(exp(ln(10) * sin(2πx / 1m))) + log1p(exp(sin(2πx / 1m)) − 1))
    }
    initial {
        temperature = 300K
    }
}

solver ThermalSolver for HeatEquation {
    spatial {
        method    = FiniteDifference
        diffusion = CentralDifference
    }
    temporal {
        method   = RungeKuttaSecondOrder
        timeStep = 10⁻⁴s
    }
}

let simulation = HeatEquation ▷ ThermalSolver ▷ Evolve(until: 0.01s)

simulation
    ▷ Observe {
        meanTemperature     = Mean(temperature)
        temperatureVariance = Mean((temperature − meanTemperature)²)
    }
    ▷ Visualize {
        temperature         = Heatmap
        temperatureVariance = LineGraph
    }
