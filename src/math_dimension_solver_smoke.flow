# Native Flow 2.0 symbolic dimension constraint acceptance.
# flow run src/math_dimension_solver_smoke.flow
import .math_dimensions { Dimension, dimensionless, length_dimension, time_dimension, quotient_dimension, product_dimension, same_dimension }
import .math_static { MathDimensionSymbol, MathDimensionBindings, empty_math_dimension_bindings }
import .math_dimension_solver { MathDimensionSolution, solve_math_equation_unknown_dimension }

function main() -> i32 {
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let speed: Dimension = quotient_dimension(length, time)
    let acceleration: Dimension = quotient_dimension(speed, time)
    let area: Dimension = product_dimension(length, length)
    let mut known: MathDimensionBindings = empty_math_dimension_bindings()
    known.count = 2
    known.symbols[0] = MathDimensionSymbol { name: "duration", dimension: time }
    known.symbols[1] = MathDimensionSymbol { name: "δ₀", dimension: speed }

    let mut result: MathDimensionSolution = solve_math_equation_unknown_dimension(
        "x * duration = 1m", known, "x")
    if not result.valid or result.failed_at != -1 or
       not same_dimension(result.dimension, speed) { return 1 }

    result = solve_math_equation_unknown_dimension("x / duration = 1m/1s²", known, "x")
    if not result.valid or not same_dimension(result.dimension, speed) { return 2 }
    result = solve_math_equation_unknown_dimension("x = duration", known, "x")
    if not result.valid or not same_dimension(result.dimension, time) { return 3 }
    result = solve_math_equation_unknown_dimension("x = δ₀", known, "x")
    if not result.valid or not same_dimension(result.dimension, speed) { return 4 }
    result = solve_math_equation_unknown_dimension("x + 2m = 3m", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 5 }
    result = solve_math_equation_unknown_dimension("x + x = 1m", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 6 }
    result = solve_math_equation_unknown_dimension("x * x = 1m²", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 7 }
    result = solve_math_equation_unknown_dimension("x³ = 1m³", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 8 }
    result = solve_math_equation_unknown_dimension("sqrt(x²) = 1m", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 9 }
    result = solve_math_equation_unknown_dimension("x² = 1m²", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 10 }
    result = solve_math_equation_unknown_dimension("x = 1m²", known, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 11 }
    result = solve_math_equation_unknown_dimension("sin(x) = 1", known, "x")
    if not result.valid or not same_dimension(result.dimension, dimensionless()) { return 12 }
    result = solve_math_equation_unknown_dimension("atan2(x,1m) = 0", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 13 }
    result = solve_math_equation_unknown_dimension("norm3(x,1m,2m) = 1m", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 14 }
    result = solve_math_equation_unknown_dimension("where(true,x,2m) = 3m", known, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 15 }
    result = solve_math_equation_unknown_dimension("x > 2m = true", known, "x")
    if result.valid { return 16 }
    result = solve_math_equation_unknown_dimension("x + 1m = 1s", known, "x")
    if result.valid { return 17 }
    result = solve_math_equation_unknown_dimension("x * x = 1m", known, "x")
    if result.valid { return 18 }
    result = solve_math_equation_unknown_dimension("x / x = 1", known, "x")
    if result.valid { return 19 }
    result = solve_math_equation_unknown_dimension("x^0 = 1", known, "x")
    if result.valid { return 20 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m", known, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 21 }
    result = solve_math_equation_unknown_dimension("x = missing", known, "x")
    if result.valid { return 22 }
    result = solve_math_equation_unknown_dimension("x = 1m", known, "duration")
    if result.valid { return 23 }
    result = solve_math_equation_unknown_dimension("x = 1m", known, "bad-name")
    if result.valid { return 24 }
    result = solve_math_equation_unknown_dimension("x = 1m", known, "")
    if result.valid { return 25 }

    let empty: MathDimensionBindings = empty_math_dimension_bindings()
    result = solve_math_equation_unknown_dimension("δ₁ = 1m/1s²", empty, "δ₁")
    if not result.valid or not same_dimension(result.dimension, acceleration) { return 26 }
    result = solve_math_equation_unknown_dimension("π = 1m", empty, "π")
    if not result.valid or not same_dimension(result.dimension, length) { return 27 }
    result = solve_math_equation_unknown_dimension("pi = 1m", empty, "pi")
    if not result.valid or not same_dimension(result.dimension, length) { return 28 }
    result = solve_math_equation_unknown_dimension("x = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 29 }
    result = solve_math_equation_unknown_dimension("x = 1m", empty, "y")
    if result.valid { return 30 }
    result = solve_math_equation_unknown_dimension("x = 1m = 2m", empty, "x")
    if result.valid { return 31 }
    result = solve_math_equation_unknown_dimension("x = 1m + 1s", empty, "x")
    if result.valid { return 32 }

    known.count = 8
    result = solve_math_equation_unknown_dimension("x = 1m", known, "x")
    if result.valid { return 33 }
    known.count = -1
    result = solve_math_equation_unknown_dimension("x = 1m", known, "x")
    if result.valid { return 34 }

    # Rational-affine dimension constraints: unknown roots are solved by
    # clearing denominators, then verified by native static SI inference.
    let volume: Dimension = product_dimension(area, length)
    let fourth_length: Dimension = product_dimension(area, area)
    let sixth_length: Dimension = product_dimension(volume, volume)
    let squared_speed: Dimension = product_dimension(speed, speed)
    let squared_time: Dimension = product_dimension(time, time)
    let cubed_speed: Dimension = product_dimension(squared_speed, speed)

    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 35 }
    result = solve_math_equation_unknown_dimension("cbrt(x) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, volume) { return 36 }
    result = solve_math_equation_unknown_dimension("sqrt(x*1m) = 1m²", empty, "x")
    if not result.valid or not same_dimension(result.dimension, volume) { return 37 }
    result = solve_math_equation_unknown_dimension("sqrt(cbrt(x)) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, sixth_length) { return 38 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m/1s²", empty, "x")
    if not result.valid or not same_dimension(result.dimension,
       product_dimension(acceleration, acceleration)) { return 39 }
    known.count = 2
    result = solve_math_equation_unknown_dimension("sqrt(x) = duration", known, "x")
    if not result.valid or not same_dimension(result.dimension, squared_time) { return 40 }
    result = solve_math_equation_unknown_dimension("cbrt(x) = δ₀", known, "x")
    if not result.valid or not same_dimension(result.dimension, cubed_speed) { return 41 }
    result = solve_math_equation_unknown_dimension("sqrt(x) + 1m = 2m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 42 }
    result = solve_math_equation_unknown_dimension("x * sqrt(x) = 1m³", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 43 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = x", empty, "x")
    if not result.valid or not same_dimension(result.dimension, dimensionless()) { return 44 }
    result = solve_math_equation_unknown_dimension("sqrt(x²) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 45 }
    result = solve_math_equation_unknown_dimension("cbrt(x³) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 46 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m/1s", empty, "x")
    if not result.valid or not same_dimension(result.dimension, squared_speed) { return 47 }
    result = solve_math_equation_unknown_dimension("cbrt(x/1m) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, fourth_length) { return 48 }
    result = solve_math_equation_unknown_dimension("where(true,sqrt(x),1m) = 2m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 49 }
    result = solve_math_equation_unknown_dimension("norm3(sqrt(x),1m,2m) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 50 }
    result = solve_math_equation_unknown_dimension("atan2(sqrt(x),1m) = 0", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 51 }
    result = solve_math_equation_unknown_dimension("sin(sqrt(x)) = 1", empty, "x")
    if not result.valid or not same_dimension(result.dimension, dimensionless()) { return 52 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = cbrt(x)", empty, "x")
    if not result.valid or not same_dimension(result.dimension, dimensionless()) { return 53 }
    result = solve_math_equation_unknown_dimension("sqrt(x) + cbrt(x) = 1m", empty, "x")
    if result.valid { return 54 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m + 1s", empty, "x")
    if result.valid { return 55 }
    result = solve_math_equation_unknown_dimension("sqrt(x/x) = 1", empty, "x")
    if result.valid { return 56 }
    result = solve_math_equation_unknown_dimension("sin(sqrt(x)) = 1m", empty, "x")
    if result.valid { return 57 }
    result = solve_math_equation_unknown_dimension("sqrt(x) = 1m²", empty, "x")
    if not result.valid or not same_dimension(result.dimension, fourth_length) { return 58 }

    result = solve_math_equation_unknown_dimension("root4(x) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, fourth_length) { return 59 }
    result = solve_math_equation_unknown_dimension("∜x = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, fourth_length) { return 60 }

    # Higher-arity native norm IR now participates in symbolic dimensional
    # constraints; numerical magnitudes do not determine physical dimensions.
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,2m,3m,4m) = 5m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 61 }
    result = solve_math_equation_unknown_dimension(
        "norm8(1s,2s,3s,4s,5s,6s,7s,x) = 1s", empty, "x")
    if not result.valid or not same_dimension(result.dimension, time) { return 62 }
    result = solve_math_equation_unknown_dimension(
        "norm8(sqrt(x),1m,2m,3m,4m,5m,6m,7m) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, area) { return 63 }
    result = solve_math_equation_unknown_dimension(
        "norm8(x,x,x,x,x,x,x,x) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 64 }
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,1s,1m,1m) = 1m", empty, "x")
    if result.valid { return 65 }
    result = solve_math_equation_unknown_dimension(
        "norm8(x,1m,1m,1m,1m,1m,1m,1s) = 1m", empty, "x")
    if result.valid { return 66 }
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,1m,1m,1m) = 1s", empty, "x")
    if result.valid { return 67 }
    result = solve_math_equation_unknown_dimension(
        "norm8(1m,1m,1m,1m,1m,1m,1m,1m) = 1m", empty, "x")
    if result.valid { return 68 }
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,1m,1m,true) = 1m", empty, "x")
    if result.valid { return 69 }
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,1m,1m) = 1m", empty, "x")
    if result.valid { return 70 }
    result = solve_math_equation_unknown_dimension(
        "norm8(x,1m,1m,1m,1m,1m,1m,1m,1m) = 1m", empty, "x")
    if result.valid { return 71 }
    result = solve_math_equation_unknown_dimension(
        "norm8(x,1m,1m,1m,1m,1m,1m,1m) = 1m²", empty, "x")
    if result.valid { return 72 }
    let fifth_length: Dimension = product_dimension(fourth_length, length)
    result = solve_math_equation_unknown_dimension(
        "norm5(root5(x),1m,2m,3m,4m) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, fifth_length) { return 73 }
    let eighth_length: Dimension = product_dimension(fourth_length, fourth_length)
    result = solve_math_equation_unknown_dimension(
        "norm8(root8(x),1m,1m,1m,1m,1m,1m,1m) = 1m", empty, "x")
    if not result.valid or not same_dimension(result.dimension, eighth_length) { return 74 }
    result = solve_math_equation_unknown_dimension(
        "norm5(x,1m,1m,1m,1m) = x", empty, "x")
    if not result.valid or not same_dimension(result.dimension, length) { return 75 }

    println("native-math-unknown-dimension-constraints-ok")
    return 0
}
