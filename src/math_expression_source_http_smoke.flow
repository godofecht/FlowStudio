# Compact HTTP acceptance fixture for the real native mathematical source parser.
# The comprehensive 70KB+ source regression runs separately via flow run.
# flow run src/math_expression_source_http_smoke.flow
import .math_dimensions { Dimension, dimensionless, length_dimension, time_dimension, quotient_dimension, same_dimension }
import .math_expression_ir { MathResult }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }

function close(actual: f64, expected: f64) -> bool {
    let mut difference: f64 = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference < 0.00000000001
}

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("3m/2s+4m/1s")
    if not result.valid or not close(result.result.value, 5.5) or
       not same_dimension(result.result.dimension,
           quotient_dimension(length_dimension(), time_dimension())) { return 1 }
    result = evaluate_math_expression("2×(3−1)÷2")
    if not result.valid or not close(result.result.value, 2.0) { return 2 }
    result = evaluate_math_expression("2m²/2m")
    if not result.valid or not close(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 3 }
    result = evaluate_math_expression("sin(0)+cos(0)")
    if not result.valid or not close(result.result.value, 1.0) { return 4 }
    result = evaluate_math_expression("tan(0)")
    if not result.valid or not close(result.result.value, 0.0) { return 5 }
    result = evaluate_math_expression("atan(1)")
    if not result.valid or not close(result.result.value, 0.7853981633974483) { return 6 }
    result = evaluate_math_expression("asin(0)+acos(1)")
    if not result.valid or not close(result.result.value, 0.0) { return 7 }
    result = evaluate_math_expression("atan2(1,1)")
    if not result.valid or not close(result.result.value, 0.7853981633974483) { return 8 }
    result = evaluate_math_expression("sinh(0)+cosh(0)+tanh(0)")
    if not result.valid or not close(result.result.value, 1.0) { return 9 }
    result = evaluate_math_expression("sinh(1m)")
    if result.valid or result.failed_at != 0 { return 10 }
    result = evaluate_math_expression("3m+2s")
    if result.valid or result.failed_at != 2 { return 11 }
    result = evaluate_math_expression("1/0")
    if result.valid or result.failed_at != 1 { return 12 }
    result = evaluate_math_expression("tanh(true)")
    if result.valid or result.failed_at != 0 { return 13 }
    let parsed: ParsedMathExpression = parse_math_expression("cosh(0)")
    if not parsed.valid or parsed.program.count != 2 or
       parsed.program.instructions[1].opcode != 36 or
       parsed.program.instructions[1].source_start != 0 or
       parsed.program.instructions[1].source_end != 4 { return 14 }
    if parse_math_expression("sinh(1,2)").valid { return 15 }
    result = evaluate_math_expression("asinh(1)+acosh(2)+atanh(0.5)")
    if not result.valid or not close(result.result.value, 2.7476376282784144) { return 16 }
    result = evaluate_math_expression("atanh(1)")
    if result.valid or result.failed_at != 0 { return 17 }
    result = evaluate_math_expression("acosh(1m)")
    if result.valid or result.failed_at != 0 { return 18 }
    result = evaluate_math_expression("log1p(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000009999999999995) { return 19 }
    result = evaluate_math_expression("log1p(-1)")
    if result.valid or result.failed_at != 0 { return 20 }
    result = evaluate_math_expression("expm1(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000010000000000005) { return 21 }
    result = evaluate_math_expression("log1p(expm1(0.5))")
    if not result.valid or not close(result.result.value, 0.5) { return 22 }
    result = evaluate_math_expression("expm1(1m)")
    if result.valid or result.failed_at != 0 { return 23 }
    result = evaluate_math_expression("expm1(61)")
    if result.valid or result.failed_at != 0 { return 24 }
    result = evaluate_math_expression("sin(π/2)+cos(tau/2)")
    if not result.valid or not close(result.result.value, 0.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 25 }
    result = evaluate_math_expression("π+1m")
    if result.valid or result.failed_at != 2 { return 26 }
    let pi_source: ParsedMathExpression = parse_math_expression("π")
    if not pi_source.valid or pi_source.program.count != 1 or
       pi_source.program.instructions[0].source_end != 2 { return 27 }

    result = evaluate_math_expression("cbrt(-8*1m³)")
    if not result.valid or not close(result.result.value, -2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 28 }
    result = evaluate_math_expression("∛(27*1m³)")
    if not result.valid or not close(result.result.value, 3.0) { return 29 }
    result = evaluate_math_expression("cbrt(8m²)")
    if result.valid or result.failed_at != 0 { return 30 }
    let cube_source: ParsedMathExpression = parse_math_expression("∛(8)")
    if not cube_source.valid or cube_source.program.instructions[1].opcode != 44 or
       cube_source.program.instructions[1].source_end != 3 { return 31 }

    result = evaluate_math_expression("norm3(3m,4m,12m)")
    if not result.valid or not close(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 32 }
    result = evaluate_math_expression("norm3(3m,4s,12m)")
    if result.valid or result.failed_at != 0 { return 33 }
    result = evaluate_math_expression("norm3(1e20,1,1)")
    if not result.valid or not close(result.result.value / 1e20, 1.0) { return 34 }

    result = evaluate_math_expression("root4(81*1m⁴)")
    if not result.valid or not close(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 35 }
    result = evaluate_math_expression("∜(16*1m⁴)")
    if not result.valid or not close(result.result.value, 2.0) { return 36 }
    result = evaluate_math_expression("root4(-16)")
    if result.valid or result.failed_at != 0 { return 37 }
    result = evaluate_math_expression("root4(16m³)")
    if result.valid or result.failed_at != 0 { return 38 }
    let fourth_source: ParsedMathExpression = parse_math_expression("∜(16)")
    if not fourth_source.valid or fourth_source.program.instructions[1].opcode != 46 or
       fourth_source.program.instructions[1].source_end != 3 { return 39 }

    result = evaluate_math_expression("root5(-32*1m⁵)")
    if not result.valid or not close(result.result.value, -2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 40 }
    result = evaluate_math_expression("root6(64*1m⁶)")
    if not result.valid or not close(result.result.value, 2.0) { return 41 }
    result = evaluate_math_expression("root7(-128*1m⁷)")
    if not result.valid or not close(result.result.value, -2.0) { return 42 }
    result = evaluate_math_expression("root8(256*1m⁸)")
    if not result.valid or not close(result.result.value, 2.0) { return 43 }
    result = evaluate_math_expression("root8(-256)")
    if result.valid or result.failed_at != 0 { return 44 }
    result = evaluate_math_expression("root5(1m⁴)")
    if result.valid or result.failed_at != 0 { return 45 }
    let high_root_source: ParsedMathExpression = parse_math_expression("root8(256)")
    if not high_root_source.valid or high_root_source.program.instructions[1].opcode != 50 or
       high_root_source.program.instructions[1].source_end != 5 { return 46 }

    result = evaluate_math_expression("norm4(1m,2m,2m,4m)")
    if not result.valid or not close(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 47 }
    result = evaluate_math_expression("norm4(1m,2m,2s,4m)")
    if result.valid or result.failed_at != 0 { return 48 }
    result = evaluate_math_expression("norm4(1e20,1,1,1)")
    if not result.valid or not close(result.result.value / 1e20, 1.0) { return 49 }
    let fourth_norm_source: ParsedMathExpression = parse_math_expression("norm4(1,2,2,4)")
    if not fourth_norm_source.valid or fourth_norm_source.program.instructions[4].opcode != 51 or
       fourth_norm_source.program.instructions[4].source_end != 5 { return 50 }

    result = evaluate_math_expression("norm5(3m,4m,0m,0m,12m)")
    if not result.valid or not close(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 51 }
    result = evaluate_math_expression("norm6(3,4,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 52 }
    result = evaluate_math_expression("norm7(3,4,0,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 53 }
    result = evaluate_math_expression("norm8(3,4,0,0,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 54 }
    result = evaluate_math_expression("norm8(3m,4m,0m,0m,0m,0s,0m,12m)")
    if result.valid or result.failed_at != 0 { return 55 }
    let eighth_norm_source: ParsedMathExpression =
        parse_math_expression("norm8(3,4,0,0,0,0,0,12)")
    if not eighth_norm_source.valid or
       eighth_norm_source.program.instructions[8].opcode != 55 or
       eighth_norm_source.program.instructions[8].source_end != 5 { return 56 }

    # These run through the production native HTTP compiler and Monaco Run.
    result = evaluate_math_expression("1m + 2m")
    if not result.valid or not close(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 57 }
    result = evaluate_math_expression("2 × 3")
    if not result.valid or not close(result.result.value, 6.0) { return 58 }
    result = evaluate_math_expression("4 ÷ 2")
    if not result.valid or not close(result.result.value, 2.0) { return 59 }
    let spaced: ParsedMathExpression = parse_math_expression("1 + 2")
    if not spaced.valid or spaced.program.count != 3 or
       spaced.program.instructions[2].source_start != 4 or
       spaced.program.instructions[2].source_end != 5 { return 60 }
    let invisible: ParsedMathExpression = parse_math_expression("1​+2")
    if invisible.valid or invisible.failed_at != 1 { return 61 }
    result = evaluate_math_expression("2 + 3")
    if not result.valid or not close(result.result.value, 5.0) { return 62 }
    result = evaluate_math_expression("2　+　3")
    if not result.valid or not close(result.result.value, 5.0) { return 63 }

    # Production HTTP and Chromium must execute the Unicode exponent sign.
    result = evaluate_math_expression("2m^−2 * 2m²")
    if not result.valid or not close(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 64 }
    let negative_power: ParsedMathExpression = parse_math_expression("2m^−2")
    if not negative_power.valid or negative_power.program.count != 2 or
       negative_power.program.instructions[1].exponent != -2 or
       negative_power.program.instructions[1].source_start != 2 or
       negative_power.program.instructions[1].source_end != 7 { return 65 }
    let malformed_power: ParsedMathExpression = parse_math_expression("2m^−")
    if malformed_power.valid or malformed_power.failed_at != 2 { return 66 }

    # Native HTTP compilation must consume complete Unicode line whitespace,
    # not silently reinterpret a partial UTF-8 sequence.
    result = evaluate_math_expression("1m + 2m")
    if not result.valid or not close(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 67 }
    result = evaluate_math_expression("4/2")
    if not result.valid or not close(result.result.value, 2.0) { return 68 }
    let line_spaced: ParsedMathExpression = parse_math_expression("1 + 2")
    if not line_spaced.valid or line_spaced.program.count != 3 or
       line_spaced.program.instructions[2].source_start != 4 or
       line_spaced.program.instructions[2].source_end != 5 { return 69 }


    # Production HTTP compilation and Monaco Run execute the same native ** IR.
    result = evaluate_math_expression("2m**2/2m")
    if not result.valid or not close(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 70 }
    result = evaluate_math_expression("2m**−2*2m²")
    if not result.valid or not close(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 71 }
    let double_star: ParsedMathExpression = parse_math_expression("2m**−2")
    if not double_star.valid or double_star.program.count != 2 or
       double_star.program.instructions[1].exponent != -2 or
       double_star.program.instructions[1].source_start != 2 or
       double_star.program.instructions[1].source_end != 8 { return 72 }
    let invalid_star: ParsedMathExpression = parse_math_expression("2***2")
    if invalid_star.valid or invalid_star.failed_at != 1 { return 73 }

    # Derived SI units are parsed and executed by the production native compiler.
    let force: Dimension = Dimension { length: 1, mass: 1, time: -2, temperature: 0 }
    let energy: Dimension = Dimension { length: 2, mass: 1, time: -2, temperature: 0 }
    let power: Dimension = Dimension { length: 2, mass: 1, time: -3, temperature: 0 }
    result = evaluate_math_expression("2Pa*3m*1m")
    if not result.valid or not close(result.result.value, 6.0) or
       not same_dimension(result.result.dimension, force) { return 74 }
    result = evaluate_math_expression("4N*2m")
    if not result.valid or not close(result.result.value, 8.0) or
       not same_dimension(result.result.dimension, energy) { return 75 }
    result = evaluate_math_expression("6J/3s")
    if not result.valid or not close(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, power) { return 76 }
    result = evaluate_math_expression("2Hz*3s")
    if not result.valid or not close(result.result.value, 6.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 77 }
    result = evaluate_math_expression("1Pa+1N")
    if result.valid or result.failed_at != 3 { return 78 }
    let derived: ParsedMathExpression = parse_math_expression("1Pa")
    if not derived.valid or derived.program.count != 1 or
       derived.program.instructions[0].source_end != 3 { return 79 }

    # Production HTTP and Chromium compile real scaled SI quantities.
    result = evaluate_math_expression("1km+250m")
    if not result.valid or not close(result.result.value, 1250.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 80 }
    result = evaluate_math_expression("5mm/1ms")
    if not result.valid or not close(result.result.value, 5.0) { return 81 }
    result = evaluate_math_expression("2kPa*3m*1m")
    if not result.valid or not close(result.result.value, 6000.0) or
       not same_dimension(result.result.dimension, force) { return 82 }
    result = evaluate_math_expression("2kHz*500µs")
    if not result.valid or not close(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 83 }
    let micro: ParsedMathExpression = parse_math_expression("1μm")
    if not micro.valid or micro.program.instructions[0].source_end != 4 { return 84 }
    result = evaluate_math_expression("1kPa+1kN")
    if result.valid or result.failed_at != 4 { return 85 }


    # Native production HTTP execution of generalized metric SI prefixes.
    result = evaluate_math_expression("2MPa/1kPa")
    if not result.valid or not close(result.result.value, 2000.0) { return 86 }
    result = evaluate_math_expression("3GHz/1MHz")
    if not result.valid or not close(result.result.value, 3000.0) { return 87 }
    result = evaluate_math_expression("4nm/2µm")
    if not result.valid or not close(result.result.value, 0.002) { return 88 }
    result = evaluate_math_expression("2g+500mg")
    if not result.valid or not close(result.result.value, 0.0025) { return 89 }
    result = evaluate_math_expression("4mJ/2ms")
    if not result.valid or not close(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, power) { return 90 }
    result = evaluate_math_expression("1μg/1µg")
    if not result.valid or not close(result.result.value, 1.0) { return 91 }
    let expanded: ParsedMathExpression = parse_math_expression("1MPa+2μg")
    if not expanded.valid or expanded.program.instructions[0].source_end != 4 or
       expanded.program.instructions[1].source_end != 9 { return 92 }
    result = evaluate_math_expression("1mPa+1mN")
    if result.valid or result.failed_at != 4 { return 93 }
    if parse_math_expression("1mkg").valid { return 94 }
    # Real production HTTP execution of practical physical units and
    # additional metric prefixes, not editor-only syntax highlighting.
    result = evaluate_math_expression("1L/1m³")
    if not result.valid or not close(result.result.value, 0.001) or
       not same_dimension(result.result.dimension, dimensionless()) { return 95 }
    result = evaluate_math_expression("1mL/1L")
    if not result.valid or not close(result.result.value, 0.001) { return 96 }
    result = evaluate_math_expression("1bar/1kPa")
    if not result.valid or not close(result.result.value, 100.0) { return 97 }
    result = evaluate_math_expression("1h/60min")
    if not result.valid or not close(result.result.value, 1.0) { return 98 }
    result = evaluate_math_expression("1dm+20cm")
    if not result.valid or not close(result.result.value, 0.3) or
       not same_dimension(result.result.dimension, length_dimension()) { return 99 }
    result = evaluate_math_expression("1mbar+1Pa")
    if not result.valid or not close(result.result.value, 101.0) { return 100 }
    result = evaluate_math_expression("1daN/1N")
    if not result.valid or not close(result.result.value, 10.0) { return 101 }
    result = evaluate_math_expression("1pPa/1fPa")
    if not result.valid or not close(result.result.value, 1000.0) { return 102 }
    result = evaluate_math_expression("1Tm/1Gm")
    if not result.valid or not close(result.result.value, 1000.0) { return 103 }
    let volume_span: ParsedMathExpression = parse_math_expression("1µL")
    if not volume_span.valid or volume_span.program.instructions[0].source_end != 4 { return 104 }
    result = evaluate_math_expression("1min+1m")
    if result.valid or result.failed_at != 4 { return 105 }
    if parse_math_expression("1minute").valid { return 106 }


    # Production HTTP compiler/runtime must execute angular scaling and e.
    result = evaluate_math_expression("sin(90°)")
    if not result.valid or not close(result.result.value, 1.0) { return 107 }
    result = evaluate_math_expression("cos(180deg)")
    if not result.valid or not close(result.result.value, -1.0) { return 108 }
    result = evaluate_math_expression("tan(50grad)")
    if not result.valid or not close(result.result.value, 1.0) { return 109 }
    result = evaluate_math_expression("sin(0.25turn)")
    if not result.valid or not close(result.result.value, 1.0) { return 110 }
    result = evaluate_math_expression("1mrad+1rad")
    if not result.valid or not close(result.result.value, 1.001) { return 111 }
    result = evaluate_math_expression("ln(e)")
    if not result.valid or not close(result.result.value, 1.0) { return 112 }
    let angle_span: ParsedMathExpression = parse_math_expression("90°")
    if not angle_span.valid or angle_span.program.instructions[0].source_end != 4 { return 113 }
    result = evaluate_math_expression("90°+1m")
    if result.valid or result.failed_at != 4 { return 114 }

    # Production native HTTP route compiles and evaluates factorial notation.
    result = evaluate_math_expression("5!")
    if not result.valid or not close(result.result.value, 120.0) { return 115 }
    result = evaluate_math_expression("factorial(6)")
    if not result.valid or not close(result.result.value, 720.0) { return 116 }
    result = evaluate_math_expression("3!²")
    if not result.valid or not close(result.result.value, 36.0) { return 117 }
    result = evaluate_math_expression("20!")
    if not result.valid or result.result.value != 2432902008176640000.0 { return 118 }
    result = evaluate_math_expression("3!=4")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 119 }
    result = evaluate_math_expression("2m!")
    if result.valid or result.failed_at != 2 { return 120 }
    result = evaluate_math_expression("3.5!")
    if result.valid or result.failed_at != 3 { return 121 }
    result = evaluate_math_expression("21!")
    if result.valid or result.failed_at != 2 { return 122 }

    # Real native HTTP execution of implicit parenthesized products.
    result = evaluate_math_expression("2(3+4)")
    if not result.valid or not close(result.result.value, 14.0) { return 123 }
    result = evaluate_math_expression("(2+3)(4-1)")
    if not result.valid or not close(result.result.value, 15.0) { return 124 }
    result = evaluate_math_expression("2m(3s)/6s")
    if not result.valid or not close(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 125 }
    result = evaluate_math_expression("1/2(4)")
    if not result.valid or not close(result.result.value, 2.0) { return 126 }
    result = evaluate_math_expression("3!(2+1)")
    if not result.valid or not close(result.result.value, 18.0) { return 127 }
    result = evaluate_math_expression("sin(π/2)(2)")
    if not result.valid or not close(result.result.value, 2.0) { return 128 }
    result = evaluate_math_expression("2(3)^2")
    if not result.valid or not close(result.result.value, 18.0) { return 129 }
    result = evaluate_math_expression("2(true)")
    if result.valid or result.failed_at != 1 { return 130 }
    result = evaluate_math_expression("2(3m+1s)")
    if result.valid or result.failed_at != 4 { return 131 }
    let implicit_span: ParsedMathExpression = parse_math_expression("(2)(3)")
    if not implicit_span.valid or implicit_span.program.count != 3 or
       implicit_span.program.instructions[2].opcode != 3 or
       implicit_span.program.instructions[2].source_start != 3 or
       implicit_span.program.instructions[2].source_end != 3 { return 132 }
    if parse_math_expression("2(3,4)").valid { return 133 }
    result = evaluate_math_expression("2(3)(4)")
    if not result.valid or not close(result.result.value, 24.0) { return 134 }
    result = evaluate_math_expression("2(3)!²")
    if not result.valid or not close(result.result.value, 72.0) { return 135 }

    # Production HTTP executes native symbol juxtaposition, not editor text.
    result = evaluate_math_expression("2π")
    if not result.valid or not close(result.result.value, 6.283185307179586) { return 136 }
    result = evaluate_math_expression("(2+1)π")
    if not result.valid or not close(result.result.value, 9.42477796076938) { return 137 }
    result = evaluate_math_expression("2π²")
    if not result.valid or not close(result.result.value, 19.739208802178716) { return 138 }
    result = evaluate_math_expression("1/2π")
    if not result.valid or not close(result.result.value, 1.5707963267948966) { return 139 }
    result = evaluate_math_expression("2mπ")
    if not result.valid or not close(result.result.value, 6.283185307179586) or
       not same_dimension(result.result.dimension, length_dimension()) { return 140 }
    let symbol_span: ParsedMathExpression = parse_math_expression("2π")
    if not symbol_span.valid or symbol_span.program.count != 3 or
       symbol_span.program.instructions[2].opcode != 3 or
       symbol_span.program.instructions[2].source_start != 1 or
       symbol_span.program.instructions[2].source_end != 1 { return 141 }
    result = evaluate_math_expression("2π+1m")
    if result.valid or result.failed_at != 3 { return 142 }
    if parse_math_expression("2ζ").valid { return 143 }
    if parse_math_expression("2true").valid { return 144 }

    # Real HTTP compilation/execution of native signum with physical units.
    result = evaluate_math_expression("sign(-2m)")
    if not result.valid or not close(result.result.value, -1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 145 }
    result = evaluate_math_expression("sgn(0K)")
    if not result.valid or result.result.value != 0.0 { return 146 }
    result = evaluate_math_expression("sign(3m/2s)")
    if not result.valid or result.result.value != 1.0 { return 147 }
    result = evaluate_math_expression("sign(0m)")
    if not result.valid or result.result.value != 0.0 { return 148 }
    result = evaluate_math_expression("sign(true)")
    if result.valid or result.failed_at != 0 { return 149 }
    result = evaluate_math_expression("sign(2m)+1m")
    if result.valid or result.failed_at != 8 { return 150 }
    result = evaluate_math_expression("sign(3m)*2s")
    if not result.valid or result.result.value != 2.0 or
       not same_dimension(result.result.dimension, time_dimension()) { return 151 }
    result = evaluate_math_expression("sign(-0.0001)")
    if not result.valid or result.result.value != -1.0 { return 152 }
    if parse_math_expression("sign()").valid { return 153 }
    let sign_span: ParsedMathExpression = parse_math_expression("sign(2m)")
    if not sign_span.valid or sign_span.program.count != 2 or
       sign_span.program.instructions[1].opcode != 57 or
       sign_span.program.instructions[1].source_start != 0 or
       sign_span.program.instructions[1].source_end != 4 { return 154 }

    # Native HTTP path must compile and execute the typed vector contraction.
    result = evaluate_math_expression("dot2(3m,4m,2/1s,1/1s)")
    if not result.valid or not close(result.result.value, 10.0) or
       not same_dimension(result.result.dimension,
           quotient_dimension(length_dimension(), time_dimension())) { return 155 }
    result = evaluate_math_expression("dot3(1,2,3,4,5,6)")
    if not result.valid or result.result.value != 32.0 { return 156 }
    result = evaluate_math_expression("dot2(1m,2s,3m,4m)")
    if result.valid or result.failed_at != 0 { return 157 }
    let dot_span: ParsedMathExpression = parse_math_expression("dot2(1,2,3,4)")
    if not dot_span.valid or dot_span.program.instructions[4].opcode != 58 or
       dot_span.program.instructions[4].source_end != 4 { return 158 }

    # Production native HTTP bundle executes the same typed vector algebra.
    result = evaluate_math_expression("cross2(3m,4m,2/1s,1/1s)")
    if not result.valid or not close(result.result.value, -5.0) or
       not same_dimension(result.result.dimension,
           quotient_dimension(length_dimension(), time_dimension())) { return 159 }
    result = evaluate_math_expression("dot4(1,2,3,4,5,6,7,8)")
    if not result.valid or result.result.value != 70.0 { return 160 }
    result = evaluate_math_expression("cross2(true,2,3,4)")
    if result.valid or result.failed_at != 0 { return 161 }
    let cross_span: ParsedMathExpression = parse_math_expression("cross2(1,2,3,4)")
    if not cross_span.valid or cross_span.program.instructions[4].opcode != 60 or
       cross_span.program.instructions[4].source_end != 6 { return 162 }
    result = evaluate_math_expression("dot5(1,2,3,4,5,5,4,3,2,1)")
    if not result.valid or result.result.value != 35.0 { return 163 }
    result = evaluate_math_expression("dot8(1,2,3,4,5,6,7,8,8,7,6,5,4,3,2,1)")
    if not result.valid or result.result.value != 120.0 { return 164 }
    result = evaluate_math_expression("dot8(true,2,3,4,5,6,7,8,8,7,6,5,4,3,2,1)")
    if result.valid or result.failed_at != 0 { return 165 }
    println("native-math-source-ok")
    return 0
}
