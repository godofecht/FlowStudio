# Native Flow 2.0 source-to-postfix lowering for a deliberately bounded
# physical scalar expression and typed comparison subset. This is executable code, not editor text.
# Full Flow 2.0 grammar integration and PDE equations remain pending.
# UTF-8 source offsets are retained for runtime dimension diagnostics.
import std.string { ParseF64, str_parse_f64_at, str_is_ascii_ws, str_is_ascii_digit }
import .math_dimensions { Dimension, Quantity, dimensionless, length_dimension, mass_dimension, time_dimension, temperature_dimension, quantity }
import .math_expression_ir { MathInstruction, MathProgram, MathResult, evaluate_math_ir }

extern {
    function strlen(source: string) -> i64
}

export struct ParsedMathExpression {
    valid: bool,
    program: MathProgram,
    failed_at: i32
}

# Explicit, bounded symbol bindings are supplied by the caller. Names may
# contain validated Greek letters and subscript digits, but are not inferred.
# Values are
# lowered to typed IR literals; no implicit global state or name inference.
export struct MathSymbol {
    name: string,
    value: Quantity
}

export struct MathBindings {
    symbols: array<MathSymbol, 8>,
    count: i32
}

export function empty_math_bindings() -> MathBindings {
    let blank: MathSymbol = MathSymbol {
        name: "", value: quantity(0.0, dimensionless())
    }
    return MathBindings { symbols: [blank], count: 0 }
}

function identifier_start(c: u8) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

function identifier_part(c: u8) -> bool {
    return identifier_start(c) or (c >= 48 and c <= 57)
}

# A deliberately bounded UTF-8 identifier alphabet: ASCII names, Greek
# uppercase/lowercase letters (excluding the unassigned U+03A2), and
# U+2080..U+2089 subscript digits after the first letter. Match full code
# points, never continuation bytes. Names are compared byte-for-byte; no
# normalization, confusable folding or implicit symbol creation occurs.
function greek_letter_width(bytes: ptr<u8>, index: i32, length: i32) -> i32 {
    if index + 1 >= length { return 0 }
    if bytes[index] == 206 {
        let following: u8 = bytes[index + 1]
        if (following >= 145 and following <= 161) or
           (following >= 163 and following <= 169) or
           (following >= 177 and following <= 191) { return 2 }
    } elif bytes[index] == 207 {
        let following: u8 = bytes[index + 1]
        if following >= 128 and following <= 137 { return 2 }
    }
    return 0
}

function identifier_start_width(bytes: ptr<u8>, index: i32, length: i32) -> i32 {
    if index >= length { return 0 }
    if identifier_start(bytes[index]) { return 1 }
    return greek_letter_width(bytes, index, length)
}

function identifier_part_width(bytes: ptr<u8>, index: i32, length: i32) -> i32 {
    if index >= length { return 0 }
    if identifier_part(bytes[index]) { return 1 }
    if bytes[index] == 226 and index + 2 < length and
       bytes[index + 1] == 130 and
       bytes[index + 2] >= 128 and bytes[index + 2] <= 137 { return 3 }
    return greek_letter_width(bytes, index, length)
}

function identifier_matches(bytes: ptr<u8>, start: i32, end: i32, name: string) -> bool {
    let length: i32 = strlen(name) as i32
    if length != end - start { return false }
    let name_bytes: ptr<u8> = name as ptr<u8>
    let mut i: i32 = 0
    while i < length {
        if bytes[start + i] != name_bytes[i] { return false }
        i = i + 1
    }
    return true
}

function valid_symbol_name(name: string) -> bool {
    let length: i32 = strlen(name) as i32
    if length < 1 or length > 32 { return false }
    let bytes: ptr<u8> = name as ptr<u8>
    let mut i: i32 = identifier_start_width(bytes, 0, length)
    if i == 0 { return false }
    if identifier_matches(bytes, 0, length, "and") or
       identifier_matches(bytes, 0, length, "or") or
       identifier_matches(bytes, 0, length, "not") or
       identifier_matches(bytes, 0, length, "true") or
       identifier_matches(bytes, 0, length, "false") { return false }
    while i < length {
        let width: i32 = identifier_part_width(bytes, i, length)
        if width == 0 { return false }
        i = i + width
    }
    return true
}

function valid_bindings(bindings: MathBindings) -> bool {
    if bindings.count < 0 or bindings.count > 8 { return false }
    let mut i: i32 = 0
    while i < bindings.count {
        let name: string = bindings.symbols[i].name
        if not valid_symbol_name(name) { return false }
        let bytes: ptr<u8> = name as ptr<u8>
        let length: i32 = strlen(name) as i32
        let mut j: i32 = 0
        while j < i {
            if identifier_matches(bytes, 0, length, bindings.symbols[j].name) {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}


# SI unit suffixes are lowered to coherent base quantities before typed IR
# evaluation. A single suffix table is shared by all recognized prefixes.
# Gram is scaled to kilograms; kg is consequently k + g, not a special case.
struct SourceUnit {
    matched: bool,
    dimension: Dimension,
    scale: f64,
    end: i32
}

function base_source_unit(bytes: ptr<u8>, index: i32, length: i32) -> SourceUnit {
    let mut dimension: Dimension = dimensionless()
    let mut scale: f64 = 1.0
    let mut end: i32 = index
    if index < length {
        # Exact multi-byte practical units precede single-byte SI bases.
        # Coherent values are expressed in m, kg, s, K before typed IR.
        if index + 2 < length and bytes[index] == 109 and
           bytes[index + 1] == 105 and bytes[index + 2] == 110 { # min
            dimension = time_dimension()
            scale = 60.0
            end = index + 3
        } elif index + 2 < length and bytes[index] == 98 and
             bytes[index + 1] == 97 and bytes[index + 2] == 114 { # bar
            dimension = Dimension { length: -1, mass: 1, time: -2, temperature: 0 }
            scale = 100000.0
            end = index + 3
        } elif index + 3 < length and bytes[index] == 116 and
             bytes[index + 1] == 117 and bytes[index + 2] == 114 and
             bytes[index + 3] == 110 { # turn: 2π radians
            scale = 6.28318530717958647692
            end = index + 4
        } elif index + 3 < length and bytes[index] == 103 and
             bytes[index + 1] == 114 and bytes[index + 2] == 97 and
             bytes[index + 3] == 100 { # gradian: π/200 radians
            scale = 0.01570796326794896619
            end = index + 4
        } elif index + 2 < length and bytes[index] == 114 and
             bytes[index + 1] == 97 and bytes[index + 2] == 100 { # rad
            end = index + 3
        } elif index + 2 < length and bytes[index] == 100 and
             bytes[index + 1] == 101 and bytes[index + 2] == 103 { # deg: π/180 radians
            scale = 0.01745329251994329577
            end = index + 3
        } elif index + 1 < length and bytes[index] == 194 and
             bytes[index + 1] == 176 { # U+00B0 degree sign
            scale = 0.01745329251994329577
            end = index + 2
        } elif index + 1 < length and bytes[index] == 80 and bytes[index + 1] == 97 { # Pa
            dimension = Dimension { length: -1, mass: 1, time: -2, temperature: 0 }
            end = index + 2
        } elif index + 1 < length and bytes[index] == 72 and bytes[index + 1] == 122 { # Hz
            dimension = Dimension { length: 0, mass: 0, time: -1, temperature: 0 }
            end = index + 2
        } elif bytes[index] == 76 { # L = 0.001 m³
            dimension = Dimension { length: 3, mass: 0, time: 0, temperature: 0 }
            scale = 0.001
            end = index + 1
        } elif bytes[index] == 104 { # h = 3600 s
            dimension = time_dimension()
            scale = 3600.0
            end = index + 1
        } elif bytes[index] == 109 { # m
            dimension = length_dimension()
            end = index + 1
        } elif bytes[index] == 115 { # s
            dimension = time_dimension()
            end = index + 1
        } elif bytes[index] == 75 { # K
            dimension = temperature_dimension()
            end = index + 1
        } elif bytes[index] == 103 { # g = 0.001 kg
            dimension = mass_dimension()
            scale = 0.001
            end = index + 1
        } elif bytes[index] == 78 { # N
            dimension = Dimension { length: 1, mass: 1, time: -2, temperature: 0 }
            end = index + 1
        } elif bytes[index] == 74 { # J
            dimension = Dimension { length: 2, mass: 1, time: -2, temperature: 0 }
            end = index + 1
        } elif bytes[index] == 87 { # W
            dimension = Dimension { length: 2, mass: 1, time: -3, temperature: 0 }
            end = index + 1
        }
    }
    return SourceUnit { matched: end > index, dimension: dimension, scale: scale, end: end }
}

function source_unit(bytes: ptr<u8>, index: i32, length: i32) -> SourceUnit {
    let mut prefix_width: i32 = 0
    let mut prefix_scale: f64 = 1.0
    if index < length {
        # The exact two-byte da prefix must be checked before deci.
        if index + 1 < length and bytes[index] == 100 and
           bytes[index + 1] == 97 { # deca
            prefix_width = 2
            prefix_scale = 10.0
        } elif bytes[index] == 100 { # deci
            prefix_width = 1
            prefix_scale = 0.1
        } elif bytes[index] == 104 { # hecto
            prefix_width = 1
            prefix_scale = 100.0
        } elif bytes[index] == 84 { # tera
            prefix_width = 1
            prefix_scale = 1000000000000.0
        } elif bytes[index] == 112 { # pico
            prefix_width = 1
            prefix_scale = 0.000000000001
        } elif bytes[index] == 102 { # femto
            prefix_width = 1
            prefix_scale = 0.000000000000001
        } elif bytes[index] == 107 { # kilo
            prefix_width = 1
            prefix_scale = 1000.0
        } elif bytes[index] == 77 { # mega
            prefix_width = 1
            prefix_scale = 1000000.0
        } elif bytes[index] == 71 { # giga
            prefix_width = 1
            prefix_scale = 1000000000.0
        } elif bytes[index] == 99 { # centi
            prefix_width = 1
            prefix_scale = 0.01
        } elif bytes[index] == 109 { # milli; bare m remains metre
            prefix_width = 1
            prefix_scale = 0.001
        } elif bytes[index] == 110 { # nano
            prefix_width = 1
            prefix_scale = 0.000000001
        } elif index + 1 < length and
             ((bytes[index] == 194 and bytes[index + 1] == 181) or
              (bytes[index] == 206 and bytes[index + 1] == 188)) { # micro sign / Greek mu
            prefix_width = 2
            prefix_scale = 0.000001
        }
    }
    if prefix_width > 0 {
        let base: SourceUnit = base_source_unit(bytes, index + prefix_width, length)
        if base.matched {
            return SourceUnit {
                matched: true, dimension: base.dimension,
                scale: base.scale * prefix_scale, end: base.end
            }
        }
    }
    return base_source_unit(bytes, index, length)
}

# A numeral adjacent to a recognized call is a product, not a unit
# suffix. In particular 2sin(x), 2sqrt(x), 2min(a,b) would otherwise be
# consumed as seconds, seconds, and minutes. Preserve 2mcos(x): mcos is
# not a call, so the metre suffix is consumed before the cos call.
# Only complete recognized ASCII function names immediately followed by
# '(' are exempted; unknown identifiers still fail closed.
function function_call_after_number(bytes: ptr<u8>, start: i32, length: i32) -> bool {
    if start >= length or not identifier_start(bytes[start]) { return false }
    let mut end: i32 = start
    while end < length and identifier_part(bytes[end]) {
        end = end + 1
    }
    if end >= length or bytes[end] != 40 { return false }
    return identifier_matches(bytes, start, end, "abs") or
        identifier_matches(bytes, start, end, "sqrt") or
        identifier_matches(bytes, start, end, "cbrt") or
        identifier_matches(bytes, start, end, "root4") or
        identifier_matches(bytes, start, end, "root5") or
        identifier_matches(bytes, start, end, "root6") or
        identifier_matches(bytes, start, end, "root7") or
        identifier_matches(bytes, start, end, "root8") or
        identifier_matches(bytes, start, end, "factorial") or
        identifier_matches(bytes, start, end, "sign") or
        identifier_matches(bytes, start, end, "sgn") or
        identifier_matches(bytes, start, end, "sin") or
        identifier_matches(bytes, start, end, "cos") or
        identifier_matches(bytes, start, end, "tan") or
        identifier_matches(bytes, start, end, "sinh") or
        identifier_matches(bytes, start, end, "cosh") or
        identifier_matches(bytes, start, end, "tanh") or
        identifier_matches(bytes, start, end, "asinh") or
        identifier_matches(bytes, start, end, "acosh") or
        identifier_matches(bytes, start, end, "atanh") or
        identifier_matches(bytes, start, end, "asin") or
        identifier_matches(bytes, start, end, "acos") or
        identifier_matches(bytes, start, end, "atan") or
        identifier_matches(bytes, start, end, "atan2") or
        identifier_matches(bytes, start, end, "ln") or
        identifier_matches(bytes, start, end, "log") or
        identifier_matches(bytes, start, end, "log10") or
        identifier_matches(bytes, start, end, "log1p") or
        identifier_matches(bytes, start, end, "expm1") or
        identifier_matches(bytes, start, end, "exp") or
        identifier_matches(bytes, start, end, "min") or
        identifier_matches(bytes, start, end, "max") or
        identifier_matches(bytes, start, end, "norm") or
        identifier_matches(bytes, start, end, "norm3") or
        identifier_matches(bytes, start, end, "norm4") or
        identifier_matches(bytes, start, end, "norm5") or
        identifier_matches(bytes, start, end, "norm6") or
        identifier_matches(bytes, start, end, "norm7") or
        identifier_matches(bytes, start, end, "norm8") or
        identifier_matches(bytes, start, end, "dot2") or
        identifier_matches(bytes, start, end, "dot3") or
        identifier_matches(bytes, start, end, "dot4") or
        identifier_matches(bytes, start, end, "dot5") or
        identifier_matches(bytes, start, end, "dot6") or
        identifier_matches(bytes, start, end, "dot7") or
        identifier_matches(bytes, start, end, "dot8") or
        identifier_matches(bytes, start, end, "cross2") or
        identifier_matches(bytes, start, end, "det2") or
        identifier_matches(bytes, start, end, "det3") or
        identifier_matches(bytes, start, end, "det4") or
        identifier_matches(bytes, start, end, "sum") or
        identifier_matches(bytes, start, end, "product") or
        identifier_matches(bytes, start, end, "mean") or
        identifier_matches(bytes, start, end, "variance") or
        identifier_matches(bytes, start, end, "sample_variance") or
        identifier_matches(bytes, start, end, "sample_stddev") or
        identifier_matches(bytes, start, end, "stddev") or
        identifier_matches(bytes, start, end, "rms") or
        identifier_matches(bytes, start, end, "median") or
        identifier_matches(bytes, start, end, "mad") or
        identifier_matches(bytes, start, end, "quantile") or
        identifier_matches(bytes, start, end, "fd1") or
        identifier_matches(bytes, start, end, "fd2") or
        identifier_matches(bytes, start, end, "laplacian2") or
        identifier_matches(bytes, start, end, "laplacian3") or
        identifier_matches(bytes, start, end, "diffusion3") or
        identifier_matches(bytes, start, end, "lerp") or
        identifier_matches(bytes, start, end, "approx") or
        identifier_matches(bytes, start, end, "clamp") or
        identifier_matches(bytes, start, end, "where") or
        identifier_matches(bytes, start, end, "smoothstep") or
        identifier_matches(bytes, start, end, "smootherstep")
}

function blank_instruction() -> MathInstruction {
    return MathInstruction {
        opcode: 0, literal: quantity(0.0, dimensionless()),
        exponent: 0, source_start: 0, source_end: 0
    }
}

function source_error(position: i32, length: i32) -> ParsedMathExpression {
    return ParsedMathExpression {
        valid: false,
        program: MathProgram { instructions: [blank_instruction()], count: 0, source_length: length },
        failed_at: position
    }
}

function precedence(opcode: i32) -> i32 {
    if opcode == 5 or opcode == 20 or opcode == 21 or opcode == 25 or
       opcode == 26 or opcode == 27 or opcode == 28 or opcode == 29 or opcode == 30 or opcode == 31 or
       opcode == 33 or opcode == 34 or opcode == 35 or opcode == 36 or opcode == 37 or
        opcode == 38 or opcode == 39 or opcode == 40 or opcode == 42 or opcode == 43 or opcode == 44 or opcode == 46 or opcode == 56 or opcode == 57 or (opcode >= 47 and opcode <= 50) { return 3 }
    if opcode == 3 or opcode == 4 { return 2 }
    if opcode == 1 or opcode == 2 { return 1 }
    # Comparisons bind below arithmetic and lower to typed predicate IR.
    if opcode >= 10 and opcode <= 15 { return 0 }
    # Logical precedence: comparisons > not > and > or.
    if opcode == 18 { return -1 }
    if opcode == 16 { return -2 }
    if opcode == 17 { return -3 }
    return 0
}

# Fixed arities are positive; -2 denotes a bounded 1..8-argument reduction.
# Commas are legal only inside recognized calls. All operands are eager.
function function_arity(opcode: i32) -> i32 {
    if (opcode >= 73 and opcode <= 79) or (opcode >= 81 and opcode <= 83) { return -2 }
    if opcode == 80 { return -3 } # p followed by 1..7 observations
    if opcode == 20 or opcode == 21 or opcode == 25 or
       opcode == 26 or opcode == 27 or opcode == 28 or opcode == 29 or opcode == 30 or opcode == 31 or
       opcode == 33 or opcode == 34 or opcode == 35 or opcode == 36 or opcode == 37 or
        opcode == 38 or opcode == 39 or opcode == 40 or opcode == 42 or opcode == 43 or opcode == 44 or opcode == 46 or opcode == 56 or opcode == 57 or (opcode >= 47 and opcode <= 50) { return 1 }
    if opcode == 7 or opcode == 8 or opcode == 22 or opcode == 32 { return 2 }
    if opcode == 9 or opcode == 19 or opcode == 45 or opcode == 66 or opcode == 67 or opcode == 68 or opcode == 69 or opcode == 84 { return 3 }
    if opcode == 51 or opcode == 58 or opcode == 60 or opcode == 70 or opcode == 85 { return 4 }
    if opcode == 71 { return 9 }
    if opcode == 72 { return 16 }
    if opcode == 59 { return 6 }
    if opcode == 86 { return 7 }
    if opcode == 87 { return 10 }
    if opcode == 88 { return 16 }
    if opcode == 61 { return 8 }
    if opcode >= 62 and opcode <= 65 { return (opcode - 57) * 2 }
    if opcode >= 52 and opcode <= 55 { return opcode - 47 }
    return 0
}

function make_instruction(opcode: i32, value: Quantity, start: i32, end: i32) -> MathInstruction {
    return MathInstruction {
        opcode: opcode, literal: value, exponent: 0,
        source_start: start, source_end: end
    }
}

# Mathematical notation commonly uses typographic spacing. Consume only
# complete, explicitly recognized Unicode White_Space code points; do not
# normalize invisible format controls such as U+200B or U+2060.
# Return UTF-8 byte width so source diagnostics remain byte-accurate.
function math_space_width(bytes: ptr<u8>, position: i32, length: i32) -> i32 {
    if str_is_ascii_ws(bytes[position]) { return 1 }
    if position + 1 < length and bytes[position] == 194 {
        if bytes[position + 1] == 133 { return 2 } # U+0085 NEXT LINE
        if bytes[position + 1] == 160 { return 2 } # U+00A0 NBSP
    }
    if position + 2 < length {
        if bytes[position] == 226 and bytes[position + 1] == 128 {
            if bytes[position + 2] >= 128 and bytes[position + 2] <= 138 {
                return 3 # U+2000..U+200A typographic spaces
            }
            if bytes[position + 2] == 168 or bytes[position + 2] == 169 {
                return 3 # U+2028 LINE SEPARATOR / U+2029 PARAGRAPH SEPARATOR
            }
            if bytes[position + 2] == 175 { return 3 } # U+202F narrow NBSP
        }
        if bytes[position] == 226 and bytes[position + 1] == 129 and
           bytes[position + 2] == 159 { return 3 } # U+205F medium mathematical space
        if bytes[position] == 227 and bytes[position + 1] == 128 and
           bytes[position + 2] == 128 { return 3 } # U+3000 ideographic space
    }
    return 0
}

# Operators are recognized only at exact byte sequences. Supported UTF-8
# spellings include ×, ·, ⋅, ∙, ∗, ÷, ∕, −, ≤, ≥, ≠, ∧ and ∨.
# Prefix ¬ is handled separately to enforce unary placement.
# Unsupported Unicode cannot be silently normalized to another operation.
function source_operator(bytes: ptr<u8>, position: i32, length: i32) -> i32 {
    let c: u8 = bytes[position]
    if c == 43 { return 1 }
    if c == 45 { return 2 }
    if c == 42 { return 3 }
    if c == 47 { return 4 }
    if c == 60 { # < or <=
        if position + 1 < length and bytes[position + 1] == 61 { return 11 }
        return 10
    }
    if c == 62 { # > or >=
        if position + 1 < length and bytes[position + 1] == 61 { return 13 }
        return 12
    }
    if c == 61 and position + 1 < length and bytes[position + 1] == 61 { return 14 }
    if c == 33 and position + 1 < length and bytes[position + 1] == 61 { return 15 }
    if c == 194 and position + 1 < length and bytes[position + 1] == 183 { return 3 } # ·
    if c == 195 and position + 1 < length {
        if bytes[position + 1] == 151 { return 3 } # ×
        if bytes[position + 1] == 183 { return 4 } # ÷
    }
    if c == 226 and position + 2 < length {
        if bytes[position + 1] == 139 and bytes[position + 2] == 133 { return 3 } # ⋅
        if bytes[position + 1] == 136 {
            if bytes[position + 2] == 149 { return 4 } # ∕
            if bytes[position + 2] == 151 { return 3 } # ∗
            if bytes[position + 2] == 153 { return 3 } # ∙
            if bytes[position + 2] == 167 { return 16 } # ∧
            if bytes[position + 2] == 168 { return 17 } # ∨
        }
        if bytes[position + 1] == 136 and bytes[position + 2] == 146 { return 2 } # −
        if bytes[position + 1] == 137 {
            if bytes[position + 2] == 164 { return 11 } # ≤
            if bytes[position + 2] == 165 { return 13 } # ≥
            if bytes[position + 2] == 160 { return 15 } # ≠
        }
    }
    return 0
}

function operator_bytes(bytes: ptr<u8>, position: i32, length: i32) -> i32 {
    if bytes[position] == 194 or bytes[position] == 195 { return 2 }
    if bytes[position] == 226 { return 3 }
    if (bytes[position] == 61 or bytes[position] == 33) and
       position + 1 < length and bytes[position + 1] == 61 { return 2 }
    if (bytes[position] == 60 or bytes[position] == 62) and
       position + 1 < length and bytes[position + 1] == 61 { return 2 }
    return 1
}

# Superscript integer powers are lexed as complete UTF-8 code points.
# U+00B9/B2/B3 and U+2070/2074..2079 are digits; U+207A/B are signs.
# The same bounded [-8, 8] power IR is used by ASCII ^ and Unicode.
function superscript_digit(bytes: ptr<u8>, position: i32, length: i32) -> i32 {
    if position + 1 < length and bytes[position] == 194 {
        if bytes[position + 1] == 185 { return 1 } # ¹
        if bytes[position + 1] == 178 { return 2 } # ²
        if bytes[position + 1] == 179 { return 3 } # ³
    }
    if position + 2 < length and bytes[position] == 226 and
       bytes[position + 1] == 129 {
        let last: u8 = bytes[position + 2]
        if last == 176 { return 0 } # ⁰
        if last >= 180 and last <= 185 { return last as i32 - 176 } # ⁴..⁹
    }
    return -1
}

function superscript_sign(bytes: ptr<u8>, position: i32, length: i32) -> i32 {
    if position + 2 < length and bytes[position] == 226 and
       bytes[position + 1] == 129 {
        if bytes[position + 2] == 186 { return 1 } # ⁺
        if bytes[position + 2] == 187 { return -1 } # ⁻
    }
    return 0
}

export function parse_math_expression_with_bindings(source: string, bindings: MathBindings) -> ParsedMathExpression {
    let length: i32 = strlen(source) as i32
    if length < 1 or length > 512 or not valid_bindings(bindings) {
        return source_error(0, length)
    }
    let bytes: ptr<u8> = source as ptr<u8>
    let blank: MathInstruction = blank_instruction()
    let mut instructions: array<MathInstruction, 64> = [blank]
    let mut count: i32 = 0
    let mut operators: array<i32, 64> = [0]
    let mut positions: array<i32, 64> = [0]
    let mut widths: array<i32, 64> = [1]
    let mut argument_counts: array<i32, 64> = [0]
    let mut top: i32 = 0
    let mut index: i32 = 0
    let mut expect_operand: bool = true
    let mut previous_was_power: bool = false
    while index < length {
        let c: u8 = bytes[index]
        let space_width: i32 = math_space_width(bytes, index, length)
        if space_width > 0 {
            index = index + space_width
            continue
        }
        # Integer powers (^, **, and superscripts) bind to the preceding primary before pending
        # unary signs. ASCII ^ accepts immediate signed decimal integers.
        # Unicode superscript digits and optional superscript signs are
        # consumed as one exponent, never as separate numeric operands.
        # Chained powers and exponents outside [-8, 8] fail closed.
        if c == 94 or (c == 42 and index + 1 < length and bytes[index + 1] == 42) or
           superscript_digit(bytes, index, length) >= 0 or
           superscript_sign(bytes, index, length) != 0 {
            if expect_operand or previous_was_power { return source_error(index, length) }
