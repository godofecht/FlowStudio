# Native Flow 2.0 three-component physical vector norm acceptance.
# Compiled and executed by Linux/macOS CI, not an editor snippet.
# flow run src/math_norm3_smoke.flow
import .math_dimensions { Dimension, Quantity, dimensionless, length_dimension, time_dimension, quotient_dimension, quantity, same_dimension }
import .math_expression_ir { MathInstruction, MathProgram, MathResult, evaluate_math_ir }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }
import .math_static { MathInferredType, infer_math_ir, infer_math_expression_source, infer_math_equation_source }
import .math_equation { MathEquationResult, evaluate_math_equation_source }

function near(actual: f64, expected: f64) -> bool {
    let mut difference: f64 = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference < 0.000000001
}

function relative(actual: f64, expected: f64) -> bool {
    if expected == 0.0 { return actual == 0.0 }
    return near(actual / expected, 1.0)
}

function main() -> i32 {
    let metres: Dimension = length_dimension()
    let speed: Dimension = quotient_dimension(metres, time_dimension())
    let mut result: MathResult = evaluate_math_expression("norm3(3,4,12)")
    if not result.valid or not near(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 1 }
    result = evaluate_math_expression("norm3(-3,-4,-12)")
    if not result.valid or not near(result.result.value, 13.0) { return 2 }
    result = evaluate_math_expression("norm3(0,0,0)")
    if not result.valid or result.result.value != 0.0 { return 3 }
    result = evaluate_math_expression("norm3(0,0,7)")
    if not result.valid or not near(result.result.value, 7.0) { return 4 }
    result = evaluate_math_expression("norm3(0,8,0)")
    if not result.valid or not near(result.result.value, 8.0) { return 5 }
    result = evaluate_math_expression("norm3(9,0,0)")
    if not result.valid or not near(result.result.value, 9.0) { return 6 }
    result = evaluate_math_expression("norm3(1,1,1)")
    if not result.valid or not near(result.result.value, 1.7320508075688772) { return 7 }
    result = evaluate_math_expression("norm3(2,3,6)")
    if not result.valid or not near(result.result.value, 7.0) { return 8 }
    result = evaluate_math_expression("norm3(3m,4m,12m)")
    if not result.valid or not near(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, metres) { return 9 }
    result = evaluate_math_expression("norm3(0s,0s,0s)")
    if not result.valid or result.result.value != 0.0 or
       not same_dimension(result.result.dimension, time_dimension()) { return 10 }
    result = evaluate_math_expression("norm3(3m/1s,4m/1s,12m/1s)")
    if not result.valid or not near(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, speed) { return 11 }
    result = evaluate_math_expression("norm3(1e20,1,1)")
    if not result.valid or not relative(result.result.value, 1e20) { return 12 }
    result = evaluate_math_expression("norm3(1e-20,1e-20,1e-20)")
    if not result.valid or not relative(result.result.value, 1.7320508075688772e-20) { return 13 }
    result = evaluate_math_expression("norm3(1e20,1e20,1e20)")
    if not result.valid or not relative(result.result.value, 1.7320508075688772e20) { return 14 }
    result = evaluate_math_expression("norm3(1e-20,0,0)")
    if not result.valid or not relative(result.result.value, 1e-20) { return 15 }
    result = evaluate_math_expression("norm3(3,4,12)+norm3(0,0,7)")
    if not result.valid or not near(result.result.value, 20.0) { return 16 }
    result = evaluate_math_expression("norm3(norm(3,4),0,12)")
    if not result.valid or not near(result.result.value, 13.0) { return 17 }
    result = evaluate_math_expression("norm3(3m,4s,12m)")
    if result.valid or result.failed_at != 0 { return 18 }
    result = evaluate_math_expression("norm3(3m,4m,12s)")
    if result.valid or result.failed_at != 0 { return 19 }
    result = evaluate_math_expression("norm3(true,4,12)")
    if result.valid or result.failed_at != 0 { return 20 }
    result = evaluate_math_expression("norm3(3,false,12)")
    if result.valid or result.failed_at != 0 { return 21 }
    result = evaluate_math_expression("norm3(3,4,true)")
    if result.valid or result.failed_at != 0 { return 22 }
    if parse_math_expression("norm3()").valid { return 23 }
    if parse_math_expression("norm3(1)").valid { return 24 }
    if parse_math_expression("norm3(1,2)").valid { return 25 }
    if parse_math_expression("norm3(1,2,3,4)").valid { return 26 }
    if parse_math_expression("norm3(1,2,)").valid { return 27 }
    if parse_math_expression("norm3(,2,3)").valid { return 28 }
    if parse_math_expression("norm3(1,,3)").valid { return 29 }
    if parse_math_expression("norm3 (1,2,3)").valid { return 30 }
    if parse_math_expression("norm3(1,2,3").valid { return 31 }
    let parsed: ParsedMathExpression = parse_math_expression("norm3(3,4,12)")
    if not parsed.valid or parsed.program.count != 4 or
       parsed.program.instructions[3].opcode != 45 or
       parsed.program.instructions[3].source_start != 0 or
       parsed.program.instructions[3].source_end != 5 { return 32 }
    let mut inferred: MathInferredType = infer_math_expression_source("norm3(3m,4m,12m)")
    if not inferred.valid or inferred.is_predicate or
       not same_dimension(inferred.dimension, metres) { return 33 }
    inferred = infer_math_expression_source("norm3(3m,4s,12m)")
    if inferred.valid or inferred.failed_at != 0 { return 34 }
    inferred = infer_math_expression_source("norm3(3m,4m,12s)")
    if inferred.valid or inferred.failed_at != 0 { return 35 }
    inferred = infer_math_expression_source("norm3(true,4,12)")
    if inferred.valid or inferred.failed_at != 0 { return 36 }
    inferred = infer_math_expression_source("norm3(0,0,0)")
    if not inferred.valid { return 37 }
    inferred = infer_math_equation_source("norm3(3m,4m,12m) = 13m")
    if not inferred.valid or not same_dimension(inferred.dimension, metres) { return 38 }
    inferred = infer_math_equation_source("norm3(3m,4s,12m) = 13m")
    if inferred.valid { return 39 }
    let mut equation: MathEquationResult = evaluate_math_equation_source(
        "norm3(3m,4m,12m) = 13m", quantity(1e-10, metres))
    if not equation.valid or not equation.satisfied or
       not same_dimension(equation.residual.dimension, metres) { return 40 }
    equation = evaluate_math_equation_source(
        "norm3(3m,4m,12m) = 14m", quantity(1e-10, metres))
    if not equation.valid or equation.satisfied { return 41 }

    # Direct IR execution covers hundreds of scaled analytic 3-4-12 triples
    # independently of the source parser and checks dimensional inference.
    let blank: MathInstruction = MathInstruction {
        opcode: 0, literal: quantity(0.0, metres), exponent: 0,
        source_start: 0, source_end: 1
    }
    let mut instructions: array<MathInstruction, 64> = [blank]
    instructions[3] = MathInstruction {
        opcode: 45, literal: quantity(0.0, dimensionless()), exponent: 0,
        source_start: 2, source_end: 7
    }
    let mut i: i32 = 1
    while i <= 200 {
        let scale: f64 = (i as f64) * 0.125
        instructions[0] = MathInstruction {
            opcode: 0, literal: quantity(3.0 * scale, metres), exponent: 0,
            source_start: 0, source_end: 1
        }
        instructions[1] = MathInstruction {
            opcode: 0, literal: quantity(-4.0 * scale, metres), exponent: 0,
            source_start: 1, source_end: 2
        }
        instructions[2] = MathInstruction {
            opcode: 0, literal: quantity(12.0 * scale, metres), exponent: 0,
            source_start: 2, source_end: 3
        }
        let program: MathProgram = MathProgram {
            instructions: instructions, count: 4, source_length: 10
        }
        result = evaluate_math_ir(program)
        if not result.valid or not relative(result.result.value, 13.0 * scale) or
           not same_dimension(result.result.dimension, metres) { return 42 }
        inferred = infer_math_ir(program)
        if not inferred.valid or not same_dimension(inferred.dimension, metres) { return 43 }
        i = i + 1
    }
    instructions[2] = MathInstruction {
        opcode: 0, literal: quantity(1.0, time_dimension()), exponent: 0,
        source_start: 2, source_end: 3
    }
    let invalid_program: MathProgram = MathProgram {
        instructions: instructions, count: 4, source_length: 10
    }
    result = evaluate_math_ir(invalid_program)
    if result.valid or result.failed_at != 2 { return 44 }
    inferred = infer_math_ir(invalid_program)
    if inferred.valid or inferred.failed_at != 2 { return 45 }
    println("native-math-norm3-ok")
    return 0
}
