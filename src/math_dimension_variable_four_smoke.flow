# Native executable regression tests for overdetermined four-unknown SI inference.
import .math_dimensions { Dimension, length_dimension, time_dimension, product_dimension, same_dimension }
import .math_static { MathDimensionBindings, MathDimensionSymbol, empty_math_dimension_bindings }
import .math_dimension_four { MathFourDimensionSolution }
import .math_dimension_variable_four { MathFourConstraintSystem, empty_math_four_constraint_system, solve_math_equations_variable_constraints_four_unknown_dimensions }

function main() -> i32 {
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let area: Dimension = product_dimension(length, length)
    let mut known: MathDimensionBindings = empty_math_dimension_bindings()
    let mut system: MathFourConstraintSystem = empty_math_four_constraint_system()
    system.count = 6
    system.equations[0] = "x+y = 2m"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    system.equations[4] = "x*y*z*w = 1m*1m*1m*1m"
    system.equations[5] = "x+z = 2m"
    let mut result: MathFourDimensionSolution =
        solve_math_equations_variable_constraints_four_unknown_dimensions(
            system, known, "x", "y", "z", "w")
    if not result.valid or result.failed_equation != -1 or
       not same_dimension(result.first, length) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, length) or
       not same_dimension(result.fourth, length) { return 1 }

    system.equations[5] = "x+z = 2s"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid or result.failed_equation != 5 { return 2 }

    system.equations[5] = "x+=1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid or result.failed_equation != 5 { return 3 }

    system.equations[5] = "x+z = 2m"
    system.equations[0] = "x+=1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid or result.failed_equation != 0 { return 4 }

    system = empty_math_four_constraint_system()
    system.count = 7
    system.equations[0] = "x/y = 1"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "x+y = 2m"
    system.equations[3] = "y/z = 1"
    system.equations[4] = "z/w = 1"
    system.equations[5] = "x*y*z*w = 1m*1m*1m*1m"
    system.equations[6] = "x = 1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if not result.valid or not same_dimension(result.fourth, length) { return 5 }

    system.equations[6] = "x = 1s"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid or result.failed_equation != 6 { return 6 }

    system = empty_math_four_constraint_system()
    system.count = 16
    system.equations[0] = "x*y*z*w = 1m*1m*1m*1m"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    let mut index: i32 = 4
    while index < 16 {
        system.equations[index] = "x+y = 2m"
        index = index + 1
    }
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if not result.valid or not same_dimension(result.first, length) { return 7 }

    system.equations[15] = "x+y = 2s"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid or result.failed_equation != 15 { return 8 }

    system.equations[15] = "x+y = 2m"
    system.count = 17
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid { return 9 }
    system.count = 3
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid { return 10 }

    system = empty_math_four_constraint_system()
    system.count = 5
    system.equations[0] = "δ₀*ρ*ζ*ω = 1m*1m*1m*1m"
    system.equations[1] = "δ₀/ρ = 1"
    system.equations[2] = "ρ/ζ = 1"
    system.equations[3] = "ζ/ω = 1"
    system.equations[4] = "δ₀ = 1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "δ₀", "ρ", "ζ", "ω")
    if not result.valid or not same_dimension(result.first, length) or
       not same_dimension(result.fourth, length) { return 11 }

    system.equations[0] = "sqrt(x)*y*z*w = 1m*1m*1m*1m"
    system.equations[1] = "x/y = 1m"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    system.equations[4] = "x = 1m²"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if not result.valid or not same_dimension(result.first, area) or
       not same_dimension(result.second, length) { return 12 }

    system.equations[0] = "x/y = 1"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    system.equations[4] = "z/w = 1"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid { return 13 }

    system.equations[0] = "x*y*z*w = 1m³"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    system.equations[4] = "x = 1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid { return 14 }

    known.count = 1
    known.symbols[0] = MathDimensionSymbol { name: "duration", dimension: time }
    system.equations[0] = "x*y*z*w = duration³*duration*1m³*1m"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "z/w = 1"
    system.equations[4] = "x = duration*1m"
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    let length_time: Dimension = product_dimension(length, time)
    if not result.valid or not same_dimension(result.first, length_time) or
       not same_dimension(result.fourth, length_time) { return 15 }

    known.count = 5
    result = solve_math_equations_variable_constraints_four_unknown_dimensions(
        system, known, "x", "y", "z", "w")
    if result.valid { return 16 }

    print("native-math-variable-four-constraints-ok")
    return 0
}
