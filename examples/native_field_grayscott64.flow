# Coupled nonlinear Gray-Scott reaction-diffusion: two genuine compiler-backed
# 64-cell Dirichlet fields with explicit local cross-field reaction coupling.
# Every U/V cell at 32, 128 and 256 Euler steps is independently asserted.
# 1024 steps * 128 field-cells = 131072 cell-step resource ceiling.
# Run: flow run examples/native_field_grayscott64.flow
import "stdlib/dynamics/pde.flow"

const N: i32 = 64
const DIFF_U: f64 = 0.22
const DIFF_V: f64 = 0.09
const FEED: f64 = 0.035
const KILL: f64 = 0.062

field U : f64[64] on Line
U evolves as laplacian(U)
boundary U { left = 1.0  right = 1.0 }

field V : f64[64] on Line
V evolves as laplacian(V)
boundary V { left = 0.0  right = 0.0 }

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

# Asymmetric deterministic initial perturbation (no external random source).
function initialise(u: ptr<f64>, v: ptr<f64>) -> void {
    for i in 0 to N {
        u[i] = 1.0
        v[i] = 0.0
        if i >= 22 and i < 42 {
            let offset: f64 = (i - 22) as f64
            u[i] = 0.47 + 0.004 * offset
            v[i] = 0.27 - 0.003 * offset
        }
    }
}

# Lie splitting is NOT used: both diffusion and nonlinear reaction terms use
# the same old state in each explicit Euler step. The field DSL generates
# both spatial diffusion kernels; local kinetics couples the two fields.
# Fail closed before changing either output, including on mid-run overflow.
function integrate(initialU: ptr<f64>, initialV: ptr<f64>,
                   outputU: ptr<f64>, outputV: ptr<f64>,
                   ratioU: f64, ratioV: f64, feed: f64, kill: f64,
                   steps: i32) -> bool {
    if steps < 0 or steps > 1024 or
       ratioU != ratioU or ratioV != ratioV or
       feed != feed or kill != kill or
       ratioU < 0.0 or ratioU > 0.5 or
       ratioV < 0.0 or ratioV > 0.5 or
       feed < 0.0 or feed > 0.1 or
       kill < 0.0 or kill > 0.1 { return false }
    let currentU: array<f64, 64> = [0.0]
    let currentV: array<f64, 64> = [0.0]
    let nextU: array<f64, 64> = [0.0]
    let nextV: array<f64, 64> = [0.0]
    for i in 0 to N {
        if initialU[i] != initialU[i] or initialV[i] != initialV[i] or
           initialU[i] < 0.0 or initialU[i] > 1.5 or
           initialV[i] < 0.0 or initialV[i] > 1.5 { return false }
        currentU[i] = initialU[i]
        currentV[i] = initialV[i]
    }
    if currentU[0] != 1.0 or currentU[N - 1] != 1.0 or
       currentV[0] != 0.0 or currentV[N - 1] != 0.0 { return false }
    for step in 0 to steps {
        U_field_step(currentU, nextU, ratioU)
        V_field_step(currentV, nextV, ratioV)
        for i in 1 to N - 1 {
            let reaction: f64 = currentU[i] * currentV[i] * currentV[i]
            nextU[i] = nextU[i] - reaction + feed * (1.0 - currentU[i])
            nextV[i] = nextV[i] + reaction - (feed + kill) * currentV[i]
        }
        field_copy_1d(nextU, currentU, N)
        field_copy_1d(nextV, currentV, N)
        for i in 0 to N {
            if currentU[i] != currentU[i] or currentV[i] != currentV[i] or
               currentU[i] < 0.0 or currentU[i] > 1.5 or
               currentV[i] < 0.0 or currentV[i] > 1.5 { return false }
        }
    }
    for i in 0 to N {
        outputU[i] = currentU[i]
        outputV[i] = currentV[i]
    }
    return true
}

