    let afterU32: array<f64, 64> = [0.0]
    let afterV32: array<f64, 64> = [0.0]
    let afterU128: array<f64, 64> = [0.0]
    let afterV128: array<f64, 64> = [0.0]
    let afterU256: array<f64, 64> = [0.0]
    let afterV256: array<f64, 64> = [0.0]
    if not integrate(initialU, initialV, afterU32, afterV32,
                     DIFF_U, DIFF_V, FEED, KILL, 32) { return 1 }
    if not integrate(initialU, initialV, afterU128, afterV128,
                     DIFF_U, DIFF_V, FEED, KILL, 128) { return 2 }
    if not integrate(initialU, initialV, afterU256, afterV256,
                     DIFF_U, DIFF_V, FEED, KILL, 256) { return 3 }
    for i in 0 to N {
        if absolute(afterU32[i] - expectedU32[i]) > 0.0000000002 or
           absolute(afterV32[i] - expectedV32[i]) > 0.0000000002 { return 4 }
        if absolute(afterU128[i] - expectedU128[i]) > 0.0000000002 or
           absolute(afterV128[i] - expectedV128[i]) > 0.0000000002 { return 5 }
        if absolute(afterU256[i] - expectedU256[i]) > 0.0000000002 or
           absolute(afterV256[i] - expectedV256[i]) > 0.0000000002 { return 6 }
        if afterU256[i] < 0.0 or afterV256[i] < 0.0 { return 7 }
    }
    if afterU256[0] != 1.0 or afterU256[63] != 1.0 or
       afterV256[0] != 0.0 or afterV256[63] != 0.0 { return 8 }
    # Semigroup and deterministic replay must agree at all 128 cells.
    let composedU: array<f64, 64> = [0.0]
    let composedV: array<f64, 64> = [0.0]
    let replayU: array<f64, 64> = [0.0]
    let replayV: array<f64, 64> = [0.0]
    if not integrate(afterU128, afterV128, composedU, composedV,
                     DIFF_U, DIFF_V, FEED, KILL, 128) { return 9 }
    if not integrate(initialU, initialV, replayU, replayV,
                     DIFF_U, DIFF_V, FEED, KILL, 256) { return 10 }
    for i in 0 to N {
        if absolute(composedU[i] - afterU256[i]) > 0.000000000001 or
           absolute(composedV[i] - afterV256[i]) > 0.000000000001 { return 11 }
        if replayU[i] != afterU256[i] or replayV[i] != afterV256[i] { return 12 }
    }
    # Zero-time identity and distinct diffusion/reaction parameter sensitivity.
    if not integrate(initialU, initialV, replayU, replayV,
                     DIFF_U, DIFF_V, FEED, KILL, 0) { return 13 }
    for i in 0 to N {
        if replayU[i] != initialU[i] or replayV[i] != initialV[i] { return 14 }
    }
    if not integrate(initialU, initialV, replayU, replayV,
                     0.11, DIFF_V, FEED, KILL, 256) { return 15 }
    if absolute(replayU[32] - afterU256[32]) < 0.0001 { return 16 }
    if not integrate(initialU, initialV, replayU, replayV,
                     DIFF_U, DIFF_V, FEED, 0.07, 256) { return 17 }
    let mut maxKillDifference: f64 = 0.0
    for i in 0 to N {
        let difference: f64 = absolute(replayV[i] - afterV256[i])
        if difference > maxKillDifference { maxKillDifference = difference }
    }
    if maxKillDifference < 0.001 { return 18 }
    # Negative cases must preserve BOTH output arrays.
    let sentinelU: array<f64, 64> = [0.0]
    let sentinelV: array<f64, 64> = [0.0]
    for i in 0 to N {
        sentinelU[i] = 777.0
        sentinelV[i] = 777.0
    }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 -0.01, DIFF_V, FEED, KILL, 32) { return 19 }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 0.500001, DIFF_V, FEED, KILL, 32) { return 20 }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, -0.01, KILL, 32) { return 21 }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, FEED, 0.101, 32) { return 22 }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, FEED, KILL, -1) { return 23 }
    if integrate(initialU, initialV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, FEED, KILL, 1025) { return 24 }
    let badU: array<f64, 64> = [0.0]
    let badV: array<f64, 64> = [0.0]
    field_copy_1d(initialU, badU, N)
    field_copy_1d(initialV, badV, N)
    badU[0] = 0.9
    if integrate(badU, badV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, FEED, KILL, 32) { return 25 }
    badU[0] = 1.0
    badV[31] = -0.1
    if integrate(badU, badV, sentinelU, sentinelV,
                 DIFF_U, DIFF_V, FEED, KILL, 32) { return 26 }
    for i in 0 to N {
        if sentinelU[i] != 777.0 or sentinelV[i] != 777.0 { return 27 }
    }
    println("native-field-grayscott64-ok")
    # Machine-readable data from the actual compiler-executed PDE state.
    # The browser validates count, finite values and complete framing.
    println("FLOWSTUDIO_FIELD_V1 64 2")
    print("U")
    for i in 0 to N {
        print(" ")
        print(afterU256[i])
    }
    println("")
    print("V")
    for i in 0 to N {
        print(" ")
        print(afterV256[i])
    }
    println("")
    println("FLOWSTUDIO_FIELD_END")
    return 0
}
