# Executable, bounded mathematical expression IR for the native Flow 2.0 runtime.
# The upstream Flow grammar does not yet lower source expressions to this IR.
# Instructions are postfix; source spans are UTF-8 byte offsets into original source.
# Opcodes: 0 literal, 1 add, 2 subtract, 3 multiply, 4 divide,
#          5 negate, 6 integer power, 7 minimum, 8 maximum,
#          9 clamp (value, lower, upper), 10-15 ordered/equality comparisons,
#          16 logical and, 17 logical or, 18 logical not,
#          19 where(predicate, true_branch, false_branch),
#          20 absolute, 21 physical square root, 22 stable two-component norm,
#          24 typed Boolean literal (0 or 1, dimensionless),
#          25 exponential, 26 natural logarithm, 27 base-10 logarithm,
#          28 sine, 29 cosine, 30 tangent, 31 arctangent,
#          32 atan2(y, x), including matching physical dimensions,
#          33 asin(x), 34 acos(x), principal angles with |x| <= 1,
#          35 sinh(x), 36 cosh(x), 37 tanh(x), dimensionless |x| <= 60,
#          38 asinh(x), 39 acosh(x), 40 atanh(x), dimensionless with domain guards,
#          42 log1p(x), stable natural logarithm of 1+x for x > -1,
#          43 expm1(x), stable exp(x)-1 for dimensionless |x| <= 60,
#          44 cbrt(x), signed physical cube root with SI exponents divisible by 3,
#          45 norm3(x, y, z), stable three-component Euclidean norm with matched units,\n#          46 root4(x), real fourth root with SI exponents divisible by 4.\n#          47-50 root5(x)..root8(x), real nth roots with exact SI divisibility.
#          51 norm4(x, y, z, w), stable four-component Euclidean norm with matched units.
#          52-55 norm5(x1,..,x5)..norm8(x1,..,x8), scale-stable physical vector norms.
#          56 factorial(x) / postfix !, dimensionless integer 0..20.
#          57 sign/sgn, 58 dot2(ax,ay,bx,by), 59 dot3(ax,ay,az,bx,by,bz).
#          60 cross2(ax,ay,bx,by): signed 2D exterior product.
#          61 dot4(ax,ay,az,aw,bx,by,bz,bw): four-component contraction.
#          62-65 dot5..dot8: five-through-eight-component typed contractions.
#          66 lerp(a, b, t): bounded physical linear interpolation, 0 <= t <= 1.
#          67 smoothstep(edge0, edge1, x): cubic C1 transition, dimensionless output.
#          68 smootherstep(edge0, edge1, x): quintic C2 transition, dimensionless output.
#          69 approx(a, b, tolerance): typed absolute-tolerance predicate, same SI units.
# Predicate values are dimensionless 0/1 with a separate runtime type bit.
# where and logical operators evaluate operands eagerly (no short circuit).
# Unsupported instructions and type mismatches fail closed.
import .math_dimensions { Dimension, Quantity, CheckedQuantity, dimensionless, quantity, quantity_add, quantity_subtract, quantity_multiply, quantity_divide, same_dimension, product_dimension }

export struct MathInstruction {
    opcode: i32,
    literal: Quantity,
    exponent: i32,
    source_start: i32,
    source_end: i32
}

export struct MathProgram {
    instructions: array<MathInstruction, 64>,
    count: i32,
    source_length: i32
}

export struct MathResult {
    valid: bool,
    result: Quantity,
    failed_at: i32,
    is_predicate: bool
}

function magnitude(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

function bounded_value(value: f64) -> bool {
    # Reject NaN, infinity and runaway arithmetic, including intermediate results.
    return magnitude(value) <= 1000000000000000000000000000000.0
}

function bounded_dimension(dimension: Dimension) -> bool {
    return dimension.length >= -32 and dimension.length <= 32 and
        dimension.mass >= -32 and dimension.mass <= 32 and
        dimension.time >= -32 and dimension.time <= 32 and
        dimension.temperature >= -32 and dimension.temperature <= 32
}

function failed(position: i32) -> MathResult {
    return MathResult {
        valid: false,
        result: quantity(0.0, dimensionless()),
        failed_at: position,
        is_predicate: false
    }
}

function powered_dimension(dimension: Dimension, exponent: i32) -> Dimension {
    return Dimension {
        length: dimension.length * exponent,
        mass: dimension.mass * exponent,
        time: dimension.time * exponent,
        temperature: dimension.temperature * exponent
    }
}

function integer_power(base: Quantity, exponent: i32) -> CheckedQuantity {
    if exponent < -8 or exponent > 8 or not bounded_value(base.value) {
        return CheckedQuantity { valid: false, quantity: base }
    }
    if exponent < 0 and base.value == 0.0 {
        return CheckedQuantity { valid: false, quantity: base }
    }
    let dimension: Dimension = powered_dimension(base.dimension, exponent)
    if not bounded_dimension(dimension) {
        return CheckedQuantity { valid: false, quantity: base }
    }
    let mut power: i32 = exponent
    if power < 0 { power = -power }
    let mut value: f64 = 1.0
    let mut index: i32 = 0
    while index < power {
        value = value * base.value
        if not bounded_value(value) {
            return CheckedQuantity { valid: false, quantity: base }
        }
        index = index + 1
    }
    if exponent < 0 {
        value = 1.0 / value
        if not bounded_value(value) {
            return CheckedQuantity { valid: false, quantity: base }
        }
    }
    return CheckedQuantity {
        valid: true,
        quantity: quantity(value, dimension)
    }
}

# Bounded Newton iteration avoids an external math library dependency. All
# inputs are nonnegative and <= 1e30. The iteration budget covers both
# 1e-30 and 1e30 without a tolerance-dependent termination path.
function positive_square_root(value: f64) -> f64 {
    if value == 0.0 { return 0.0 }
    let mut estimate: f64 = 1.0
    if value > 1.0 { estimate = value }
    let mut iteration: i32 = 0
    while iteration < 72 {
        estimate = 0.5 * (estimate + value / estimate)
        iteration = iteration + 1
    }
    return estimate
}

# Normalize by exact powers of eight so Newton iteration is well-conditioned
# for tiny and large finite values without libm or a cancellation-prone
# exp(log(x)/3) approximation. Negative radicands retain their real sign.
# Real principal fourth root, normalized by exact powers of sixteen to
# keep Newton iteration stable for the supported finite numeric range.
# Negative radicands have no real fourth root and are rejected by the caller.
function real_fourth_root(value: f64) -> f64 {
    if value == 0.0 { return 0.0 }
    let mut normalized: f64 = value
    let mut scale: f64 = 1.0
    while normalized > 16.0 {
        normalized = normalized * 0.0625
        scale = scale * 2.0
    }
    while normalized < 0.0625 {
        normalized = normalized * 16.0
        scale = scale * 0.5
    }
    let mut estimate: f64 = 1.0
    let mut iteration: i32 = 0
    while iteration < 40 {
        estimate = (3.0 * estimate + normalized /
            (estimate * estimate * estimate)) * 0.25
        iteration = iteration + 1
    }
    return estimate * scale
}

# General real fifth-through-eighth roots. Power-of-two range reduction keeps
# Newton iterates bounded even for 1e-30 and 1e30 inputs. Odd roots are signed.
function real_high_root(value: f64, degree: i32) -> f64 {
    if value == 0.0 { return 0.0 }
    let mut base: f64 = 1.0
    let mut power_index: i32 = 0
    while power_index < degree {
        base = base * 2.0
        power_index = power_index + 1
    }
    let mut normalized: f64 = magnitude(value)
    let mut scale: f64 = 1.0
    while normalized > base {
        normalized = normalized / base
        scale = scale * 2.0
    }
    while normalized < 1.0 / base {
        normalized = normalized * base
        scale = scale * 0.5
    }
    let mut estimate: f64 = 1.0
    let mut iteration: i32 = 0
    while iteration < 64 {
        let mut denominator: f64 = 1.0
        let mut j: i32 = 1
        while j < degree {
            denominator = denominator * estimate
            j = j + 1
        }
        estimate = (((degree - 1) as f64) * estimate +
            normalized / denominator) / (degree as f64)
        iteration = iteration + 1
    }
    let root: f64 = estimate * scale
    if value < 0.0 { return -root }
    return root
}

function real_cube_root(value: f64) -> f64 {
    if value == 0.0 { return 0.0 }
    let mut normalized: f64 = magnitude(value)
    let mut scale: f64 = 1.0
    while normalized > 8.0 {
        normalized = normalized * 0.125
        scale = scale * 2.0
    }
    while normalized < 0.125 {
        normalized = normalized * 8.0
        scale = scale * 0.5
    }
    let mut estimate: f64 = 1.0
    let mut iteration: i32 = 0
    while iteration < 30 {
        estimate = (2.0 * estimate + normalized / (estimate * estimate)) / 3.0
        iteration = iteration + 1
    }
    let root: f64 = estimate * scale
    if value < 0.0 { return -root }
    return root
}

# Dimensionless exponential, bounded to [-60, 60]. Range reduction to
# [0, 0.5] and a 24-term Taylor series avoid platform libm dependencies.
# Squaring reconstructs the positive exponential; reciprocal handles negatives.
function bounded_exponential(value: f64) -> f64 {
    let mut reduced: f64 = value
    let mut negative: bool = false
    if reduced < 0.0 {
        reduced = -reduced
        negative = true
    }
    let mut halvings: i32 = 0
    while reduced > 0.5 {
        reduced = reduced * 0.5
        halvings = halvings + 1
    }
    let mut sum: f64 = 1.0
    let mut term: f64 = 1.0
    let mut n: i32 = 1
    while n <= 24 {
        term = term * reduced / (n as f64)
        sum = sum + term
        n = n + 1
    }
    let mut i: i32 = 0
    while i < halvings {
        sum = sum * sum
        i = i + 1
    }
    if negative { return 1.0 / sum }
    return sum
}

# Preserve small exponential increments: exp(x)-1 loses significant digits
# if exp(x) rounds to 1. On [-0.5,0.5], the direct Taylor series has
# truncation error below double precision after 24 terms. Larger arguments
# reuse the bounded, range-reduced exponential kernel.
function bounded_exponential_minus_one(value: f64) -> f64 {
    if magnitude(value) > 0.5 { return bounded_exponential(value) - 1.0 }
    let mut term: f64 = value
    let mut sum: f64 = value
    let mut n: i32 = 2
    while n <= 24 {
        term = term * value / (n as f64)
        sum = sum + term
        n = n + 1
    }
    return sum
}

# Dimensionless hyperbolic functions. Small arguments use direct Taylor
# series to avoid cancellation in sinh and tanh. For larger arguments,
# range-reduced native exp evaluates positive magnitudes only; tanh uses
# exp(-2|x|), avoiding overflow and saturating correctly for |x| >= 20.
# The evaluator enforces the same [-60,60] input range as exp and trig.
function bounded_hyperbolic_series(value: f64, cosine: bool) -> f64 {
    let mut term: f64 = value
    if cosine { term = 1.0 }
    let mut sum: f64 = term
    let mut n: i32 = 1
    while n <= 16 {
        if cosine {
            term = term * value * value / (((2 * n - 1) * (2 * n)) as f64)
        } else {
            term = term * value * value / (((2 * n) * (2 * n + 1)) as f64)
        }
        sum = sum + term
        n = n + 1
    }
    return sum
}

function bounded_hyperbolic(value: f64, opcode: i32) -> f64 {
    let absolute: f64 = magnitude(value)
    if absolute <= 0.5 {
        let sine: f64 = bounded_hyperbolic_series(value, false)
        if opcode == 35 { return sine }
        let cosine: f64 = bounded_hyperbolic_series(value, true)
        if opcode == 36 { return cosine }
        return sine / cosine
    }
    if opcode == 37 {
        if absolute >= 20.0 {
            if value < 0.0 { return -1.0 }
            return 1.0
        }
        let decay: f64 = bounded_exponential(-2.0 * absolute)
        let mut result: f64 = (1.0 - decay) / (1.0 + decay)
        if value < 0.0 { result = -result }
        return result
    }
    let exponential: f64 = bounded_exponential(absolute)
    let reciprocal: f64 = 1.0 / exponential
    if opcode == 35 {
        let mut result: f64 = 0.5 * (exponential - reciprocal)
        if value < 0.0 { result = -result }
        return result
    }
    return 0.5 * (exponential + reciprocal)
}

# The logarithm accepts positive finite dimensionless inputs <= 1e30. Repeated
# binary scaling reduces the mantissa to [1,2); then |z| <= 1/3 in
# ln(m) = 2*(z + z^3/3 + z^5/5 + ...). Twenty-five odd terms are enough
# for double precision; finite f64 inputs need at most 1074 shifts.
function bounded_natural_log(value: f64) -> f64 {
    let mut mantissa: f64 = value
    let mut binary_exponent: i32 = 0
    while mantissa >= 2.0 {
        mantissa = mantissa * 0.5
        binary_exponent = binary_exponent + 1
    }
    while mantissa < 1.0 {
        mantissa = mantissa * 2.0
        binary_exponent = binary_exponent - 1
    }
    let z: f64 = (mantissa - 1.0) / (mantissa + 1.0)
    let z_squared: f64 = z * z
    let mut term: f64 = z
    let mut sum: f64 = 0.0
    let mut n: i32 = 1
    while n <= 25 {
        sum = sum + term / ((2 * n - 1) as f64)
        term = term * z_squared
        n = n + 1
    }
    return 2.0 * sum + (binary_exponent as f64) * 0.69314718055994530942
}

# Preserve small increments in ln(1+x) without rounding 1+x to 1.
# For |x| <= 0.5, z=x/(2+x) has |z| <= 1/3 and the odd atanh
# series converges rapidly. Larger valid inputs use the native ln kernel.
function bounded_log_one_plus(value: f64) -> f64 {
    if magnitude(value) > 0.5 {
        return bounded_natural_log(1.0 + value)
    }
    let z: f64 = value / (2.0 + value)
    let z_squared: f64 = z * z
    let mut term: f64 = z
    let mut sum: f64 = 0.0
    let mut n: i32 = 1
    while n <= 25 {
        sum = sum + term / ((2 * n - 1) as f64)
        term = term * z_squared
        n = n + 1
    }
    return 2.0 * sum
}

# Inverse hyperbolic functions use the same bounded native logarithm and
# square-root kernels. Small inputs use convergent series to avoid loss of
# significance; atanh rejects its singular endpoints and exterior domain.
function bounded_inverse_hyperbolic(value: f64, opcode: i32) -> f64 {
    let absolute: f64 = magnitude(value)
    if opcode == 38 {
        if absolute <= 0.5 {
            let mut term: f64 = value
            let mut sum: f64 = term
            let mut n: i32 = 1
            while n <= 25 {
                let odd: f64 = (2 * n - 1) as f64
                term = term * (-odd * odd * value * value) /
                    ((2 * n * (2 * n + 1)) as f64)
                sum = sum + term
                n = n + 1
            }
            return sum
        }
        let mut result: f64 = bounded_natural_log(
            absolute + positive_square_root(absolute * absolute + 1.0))
        if value < 0.0 { result = -result }
        return result
    }
    if opcode == 39 {
        return bounded_natural_log(
            value + positive_square_root((value - 1.0) * (value + 1.0)))
    }
    if absolute <= 0.5 {
        let mut term: f64 = absolute
        let mut sum: f64 = term
        let mut n: i32 = 1
        while n <= 30 {
            term = term * absolute * absolute
            sum = sum + term / ((2 * n + 1) as f64)
            n = n + 1
        }
        if value < 0.0 { sum = -sum }
        return sum
    }
    let mut result: f64 = 0.5 * bounded_natural_log(
        (1.0 + absolute) / (1.0 - absolute))
    if value < 0.0 { result = -result }
    return result
}

# Native bounded dimensionless trigonometry. Reduce [-60,60] to [-pi,pi],
# then reflect into [-pi/2,pi/2] before the alternating Taylor series.
# Sixteen correction terms give f64 accuracy on this bounded interval.
function bounded_trigonometric(value: f64, cosine: bool) -> f64 {
    let pi: f64 = 3.14159265358979323846264338327950288
    let half_pi: f64 = 1.57079632679489661923132169163975144
    let two_pi: f64 = 6.28318530717958647692528676655900576
    let mut angle: f64 = value
    while angle > pi { angle = angle - two_pi }
    while angle < -pi { angle = angle + two_pi }
    let mut sign: f64 = 1.0
    if angle > half_pi {
        angle = pi - angle
        if cosine { sign = -1.0 }
    } elif angle < -half_pi {
        angle = -pi - angle
        if cosine { sign = -1.0 }
    }
    let mut term: f64 = angle
    if cosine { term = 1.0 }
    let mut sum: f64 = term
    let mut n: i32 = 1
    while n <= 16 {
        if cosine {
            term = -term * angle * angle / (((2 * n - 1) * (2 * n)) as f64)
        } else {
            term = -term * angle * angle / (((2 * n) * (2 * n + 1)) as f64)
        }
        sum = sum + term
        n = n + 1
    }
    return sign * sum
}

# Dimensionless inverse tangent. Reciprocal reduction handles |x| > 1 without
# squaring a large argument; the half-angle identity brings |x| <= 1 to
# |tan(theta/2)| <= sqrt(2)-1. Thirty alternating corrections then give
# double-precision accuracy without an external trigonometric library.
function bounded_arctangent(value: f64) -> f64 {
    let mut input: f64 = magnitude(value)
    let mut reciprocal: bool = false
    if input > 1.0 {
        input = 1.0 / input
        reciprocal = true
    }
    let reduced: f64 = input / (1.0 + positive_square_root(1.0 + input * input))
    let mut term: f64 = reduced
    let mut sum: f64 = reduced
    let mut n: i32 = 1
    while n <= 30 {
        term = -term * reduced * reduced
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    }
    let mut angle: f64 = 2.0 * sum
    if reciprocal { angle = 1.57079632679489661923132169163975144 - angle }
    if value < 0.0 { return -angle }
    return angle
}

# Principal polar angle in (-pi, pi]. Scale by the larger magnitude before
# dividing, so even highly unequal bounded operands cannot overflow.
function bounded_arctangent2(y: f64, x: f64) -> f64 {
    let half_pi: f64 = 1.57079632679489661923132169163975144
    let pi: f64 = 3.14159265358979323846264338327950288
    if x == 0.0 {
        if y > 0.0 { return half_pi }
        return -half_pi
    }
    let absolute_x: f64 = magnitude(x)
    let absolute_y: f64 = magnitude(y)
    let mut acute: f64 = 0.0
    if absolute_x >= absolute_y {
        acute = bounded_arctangent(absolute_y / absolute_x)
    } else {
        acute = half_pi - bounded_arctangent(absolute_x / absolute_y)
    }
    if x > 0.0 {
        if y < 0.0 { return -acute }
        return acute
    }
    if y < 0.0 { return acute - pi }
    return pi - acute
}

function even_dimension(dimension: Dimension) -> bool {
    return dimension.length == (dimension.length / 2) * 2 and
        dimension.mass == (dimension.mass / 2) * 2 and
        dimension.time == (dimension.time / 2) * 2 and
        dimension.temperature == (dimension.temperature / 2) * 2
}

function divisible_by_root_degree(d: Dimension, degree: i32) -> bool {
    return d.length == (d.length / degree) * degree and
        d.mass == (d.mass / degree) * degree and
        d.time == (d.time / degree) * degree and
        d.temperature == (d.temperature / degree) * degree
}

function root_dimension(d: Dimension, degree: i32) -> Dimension {
    return Dimension {
        length: d.length / degree, mass: d.mass / degree,
        time: d.time / degree, temperature: d.temperature / degree
    }
}

function fourth_dimension(dimension: Dimension) -> Dimension {
    return Dimension {
        length: dimension.length / 4, mass: dimension.mass / 4,
        time: dimension.time / 4, temperature: dimension.temperature / 4
    }
}

function divisible_by_four_dimension(dimension: Dimension) -> bool {
    return dimension.length == (dimension.length / 4) * 4 and
        dimension.mass == (dimension.mass / 4) * 4 and
        dimension.time == (dimension.time / 4) * 4 and
        dimension.temperature == (dimension.temperature / 4) * 4
}

function third_dimension(dimension: Dimension) -> Dimension {
    return Dimension {
        length: dimension.length / 3, mass: dimension.mass / 3,
        time: dimension.time / 3, temperature: dimension.temperature / 3
    }
}

function divisible_by_three_dimension(dimension: Dimension) -> bool {
    return dimension.length == (dimension.length / 3) * 3 and
        dimension.mass == (dimension.mass / 3) * 3 and
        dimension.time == (dimension.time / 3) * 3 and
        dimension.temperature == (dimension.temperature / 3) * 3
}

function half_dimension(dimension: Dimension) -> Dimension {
    return Dimension {
        length: dimension.length / 2,
        mass: dimension.mass / 2,
        time: dimension.time / 2,
        temperature: dimension.temperature / 2
    }
}

export function evaluate_math_ir(program: MathProgram) -> MathResult {
    if program.count < 1 or program.count > 64 or program.source_length < 0 {
        return failed(0)
    }
    let mut stack: array<Quantity, 64> = [quantity(0.0, dimensionless())]
    let mut predicate: array<bool, 64> = [false]
    let mut depth: i32 = 0
    let mut index: i32 = 0
    while index < program.count {
        let instruction: MathInstruction = program.instructions[index]
        if instruction.source_start < 0 or instruction.source_end < instruction.source_start or
           instruction.source_end > program.source_length {
            return failed(index)
        }
        let opcode: i32 = instruction.opcode
        if opcode == 0 {
            if depth >= 64 or not bounded_value(instruction.literal.value) or
               not bounded_dimension(instruction.literal.dimension) {
                return failed(instruction.source_start)
            }
            stack[depth] = instruction.literal
            predicate[depth] = false
            depth = depth + 1
        } elif opcode == 24 {
            # A Boolean is a distinct predicate type, not a numeric 0/1.
            if depth >= 64 or instruction.exponent != 0 or
               not same_dimension(instruction.literal.dimension, dimensionless()) or
               (instruction.literal.value != 0.0 and instruction.literal.value != 1.0) {
                return failed(instruction.source_start)
            }
            stack[depth] = quantity(instruction.literal.value, dimensionless())
            predicate[depth] = true
            depth = depth + 1
        } elif opcode == 5 or opcode == 6 or opcode == 18 or opcode == 20 or opcode == 21 or opcode == 25 or
             opcode == 26 or opcode == 27 or opcode == 28 or opcode == 29 or opcode == 30 or opcode == 31 or
             opcode == 33 or opcode == 34 or opcode == 35 or opcode == 36 or opcode == 37 or
             opcode == 38 or opcode == 39 or opcode == 40 or opcode == 42 or opcode == 43 or opcode == 44 or opcode == 46 or opcode == 56 or opcode == 57 or (opcode >= 47 and opcode <= 50) {
            if depth < 1 { return failed(instruction.source_start) }
            let input: Quantity = stack[depth - 1]
            if opcode == 18 {
                if not predicate[depth - 1] { return failed(instruction.source_start) }
                let mut inverted: f64 = 1.0
                if input.value != 0.0 { inverted = 0.0 }
                stack[depth - 1] = quantity(inverted, dimensionless())
            } else {
                if predicate[depth - 1] { return failed(instruction.source_start) }
                if opcode == 5 {
                    stack[depth - 1] = quantity(-input.value, input.dimension)
                } elif opcode == 20 {
                    stack[depth - 1] = quantity(magnitude(input.value), input.dimension)
                } elif opcode == 57 {
                    # sign/sgn accepts finite physical scalars and returns
                    # a dimensionless numeric direction, including zero.
                    let mut direction: f64 = 0.0
                    if input.value < 0.0 { direction = -1.0 }
                    elif input.value > 0.0 { direction = 1.0 }
                    stack[depth - 1] = quantity(direction, dimensionless())
                } elif opcode == 56 {
                    # Bounded integer combinatorics: reject fractional, negative,
                    # dimensional, predicate, and overflow-prone operands.
                    if not same_dimension(input.dimension, dimensionless()) or
                       input.value < 0.0 or input.value > 20.0 or
                       input.value != ((input.value as i32) as f64) {
                        return failed(instruction.source_start)
                    }
                    let mut factorial: f64 = 1.0
                    let mut factor: i32 = 2
                    let n: i32 = input.value as i32
                    while factor <= n {
                        factorial = factorial * (factor as f64)
                        factor = factor + 1
                    }
                    stack[depth - 1] = quantity(factorial, dimensionless())
                } elif opcode == 21 {
                    if input.value < 0.0 or not even_dimension(input.dimension) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        positive_square_root(input.value), half_dimension(input.dimension))
                } elif opcode >= 47 and opcode <= 50 {
                    let degree: i32 = opcode - 42
                    if (degree % 2 == 0 and input.value < 0.0) or
                       not divisible_by_root_degree(input.dimension, degree) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        real_high_root(input.value, degree),
                        root_dimension(input.dimension, degree))
                } elif opcode == 46 {
                    if input.value < 0.0 or not divisible_by_four_dimension(input.dimension) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        real_fourth_root(input.value), fourth_dimension(input.dimension))
                } elif opcode == 44 {
                    if not divisible_by_three_dimension(input.dimension) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        real_cube_root(input.value), third_dimension(input.dimension))
                } elif opcode == 25 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       magnitude(input.value) > 60.0 {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(bounded_exponential(input.value), dimensionless())
                } elif opcode == 43 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       magnitude(input.value) > 60.0 {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(bounded_exponential_minus_one(input.value), dimensionless())
                } elif opcode == 26 or opcode == 27 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       input.value <= 0.0 or input.value > 1e30 {
                        return failed(instruction.source_start)
                    }
                    let mut logged: f64 = bounded_natural_log(input.value)
                    if opcode == 27 { logged = logged / 2.30258509299404568402 }
                    stack[depth - 1] = quantity(logged, dimensionless())
                } elif opcode == 42 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       input.value <= -1.0 or input.value > 1e30 {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(bounded_log_one_plus(input.value), dimensionless())
                } elif opcode == 38 or opcode == 39 or opcode == 40 {
                    if not same_dimension(input.dimension, dimensionless()) {
                        return failed(instruction.source_start)
                    }
                    if (opcode == 38 and magnitude(input.value) > 100000000000000.0) or
                       (opcode == 39 and (input.value < 1.0 or input.value > 100000000000000.0)) or
                       (opcode == 40 and magnitude(input.value) >= 1.0) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        bounded_inverse_hyperbolic(input.value, opcode), dimensionless())
                } elif opcode == 35 or opcode == 36 or opcode == 37 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       magnitude(input.value) > 60.0 {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(
                        bounded_hyperbolic(input.value, opcode), dimensionless())
                } elif opcode == 31 {
                    if not same_dimension(input.dimension, dimensionless()) {
                        return failed(instruction.source_start)
                    }
                    stack[depth - 1] = quantity(bounded_arctangent(input.value), dimensionless())
                } elif opcode == 33 or opcode == 34 {
                    # Stable inverse-trigonometric principal values. Compute
                    # sqrt(1-x*x) as sqrt((1-|x|)*(1+|x|)) to retain
                    # precision close to both endpoints. atan2 determines
                    # the correct quadrant without subtractive cancellation.
                    if not same_dimension(input.dimension, dimensionless()) or
                       magnitude(input.value) > 1.0 {
                        return failed(instruction.source_start)
                    }
                    let absolute: f64 = magnitude(input.value)
                    let complement: f64 = positive_square_root((1.0 - absolute) * (1.0 + absolute))
                    let mut angle: f64 = bounded_arctangent2(input.value, complement)
                    if opcode == 34 {
                        angle = bounded_arctangent2(complement, input.value)
                    }
                    stack[depth - 1] = quantity(angle, dimensionless())
                } elif opcode == 28 or opcode == 29 or opcode == 30 {
                    if not same_dimension(input.dimension, dimensionless()) or
                       magnitude(input.value) > 60.0 {
                        return failed(instruction.source_start)
                    }
                    let mut trigonometric: f64 = bounded_trigonometric(input.value, opcode == 29)
                    if opcode == 30 {
                        # Tangent has poles at odd multiples of pi/2. Reject
                        # near-pole inputs rather than return unstable magnitudes.
                        let denominator: f64 = bounded_trigonometric(input.value, true)
                        if magnitude(denominator) <= 0.000000000001 {
                            return failed(instruction.source_start)
                        }
                        trigonometric = bounded_trigonometric(input.value, false) / denominator
                    }
                    stack[depth - 1] = quantity(trigonometric, dimensionless())
                } else {
                    let powered: CheckedQuantity = integer_power(input, instruction.exponent)
                    if not powered.valid { return failed(instruction.source_start) }
                    stack[depth - 1] = powered.quantity
                }
            }
            if not bounded_value(stack[depth - 1].value) or
               not bounded_dimension(stack[depth - 1].dimension) {
                return failed(instruction.source_start)
            }
        } elif (opcode >= 1 and opcode <= 4) or opcode == 7 or opcode == 8 or
             (opcode >= 10 and opcode <= 17) or opcode == 22 or opcode == 32 {
            if depth < 2 { return failed(instruction.source_start) }
            let right: Quantity = stack[depth - 1]
            let left: Quantity = stack[depth - 2]
            let left_predicate: bool = predicate[depth - 2]
            let right_predicate: bool = predicate[depth - 1]
            let mut result: CheckedQuantity = CheckedQuantity { valid: false, quantity: left }
            let mut result_predicate: bool = false
            if opcode == 32 {
                # atan2(y, x) accepts a matched physical pair, but the
                # resulting angle is dimensionless. The origin is undefined.
                if left_predicate or right_predicate or
                   not same_dimension(left.dimension, right.dimension) or
                   (left.value == 0.0 and right.value == 0.0) {
                    return failed(instruction.source_start)
                }
                result = CheckedQuantity {
                    valid: true,
                    quantity: quantity(bounded_arctangent2(left.value, right.value), dimensionless())
                }
            } elif opcode == 16 or opcode == 17 {
                if not left_predicate or not right_predicate {
                    return failed(instruction.source_start)
                }
                let left_true: bool = left.value != 0.0
                let right_true: bool = right.value != 0.0
                let mut truth: bool = left_true and right_true
                if opcode == 17 { truth = left_true or right_true }
                let mut numeric: f64 = 0.0
                if truth { numeric = 1.0 }
                result = CheckedQuantity { valid: true, quantity: quantity(numeric, dimensionless()) }
                result_predicate = true
            } elif opcode >= 10 and opcode <= 15 {
                if left_predicate or right_predicate or
                   not same_dimension(left.dimension, right.dimension) {
                    return failed(instruction.source_start)
                }
                let mut truth: bool = false
                if opcode == 10 { truth = left.value < right.value }
                if opcode == 11 { truth = left.value <= right.value }
                if opcode == 12 { truth = left.value > right.value }
                if opcode == 13 { truth = left.value >= right.value }
                if opcode == 14 { truth = left.value == right.value }
                if opcode == 15 { truth = left.value != right.value }
                let mut numeric: f64 = 0.0
                if truth { numeric = 1.0 }
                result = CheckedQuantity { valid: true, quantity: quantity(numeric, dimensionless()) }
                result_predicate = true
            } else {
                if left_predicate or right_predicate {
                    return failed(instruction.source_start)
                }
                if opcode == 22 {
                    if not same_dimension(left.dimension, right.dimension) {
                        return failed(instruction.source_start)
                    }
                    let first: f64 = magnitude(left.value)
                    let second: f64 = magnitude(right.value)
                    let mut largest: f64 = first
                    let mut smallest: f64 = second
                    if second > first {
                        largest = second
                        smallest = first
                    }
                    let mut norm: f64 = 0.0
                    if largest > 0.0 {
                        let ratio: f64 = smallest / largest
                        norm = largest * positive_square_root(1.0 + ratio * ratio)
                    }
                    result = CheckedQuantity { valid: true, quantity: quantity(norm, left.dimension) }
                }
                if opcode == 1 { result = quantity_add(left, right) }
                if opcode == 2 { result = quantity_subtract(left, right) }
                if opcode == 3 {
                    result = CheckedQuantity { valid: true, quantity: quantity_multiply(left, right) }
                }
                if opcode == 4 { result = quantity_divide(left, right) }
                if opcode == 7 or opcode == 8 {
                    if not same_dimension(left.dimension, right.dimension) {
                        return failed(instruction.source_start)
                    }
                    let mut selected: Quantity = left
                    if (opcode == 7 and right.value < left.value) or
                       (opcode == 8 and right.value > left.value) {
                        selected = right
                    }
                    result = CheckedQuantity { valid: true, quantity: selected }
                }
            }
            if not result.valid or not bounded_value(result.quantity.value) or
               not bounded_dimension(result.quantity.dimension) {
                return failed(instruction.source_start)
            }
            depth = depth - 1
            stack[depth - 1] = result.quantity
            predicate[depth - 1] = result_predicate
        } elif opcode == 58 or opcode == 59 or opcode == 60 or opcode == 61 or
             (opcode >= 62 and opcode <= 65) {
            # Native physical contractions. The first half of the arguments
            # forms one vector and the second half forms the other. Both
            # vectors must be internally dimensionally homogeneous.
            let mut components: i32 = 2
            if opcode == 59 { components = 3 }
            if opcode == 61 { components = 4 }
            if opcode >= 62 and opcode <= 65 { components = opcode - 57 }
            let arity: i32 = components * 2
            if depth < arity { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - arity]
            let second: Quantity = stack[depth - components]
            let output_dimension: Dimension = product_dimension(first.dimension, second.dimension)
            if not bounded_dimension(output_dimension) { return failed(instruction.source_start) }
            let mut sum: f64 = 0.0
            let mut component: i32 = 0
            while component < components {
                let left_index: i32 = depth - arity + component
                let right_index: i32 = depth - components + component
                let left: Quantity = stack[left_index]
                let right: Quantity = stack[right_index]
                if predicate[left_index] or predicate[right_index] or
                   not same_dimension(left.dimension, first.dimension) or
                   not same_dimension(right.dimension, second.dimension) {
                    return failed(instruction.source_start)
                }
                if opcode != 60 {
                    sum = sum + left.value * right.value
                    if not bounded_value(sum) { return failed(instruction.source_start) }
                }
                component = component + 1
            }
            if opcode == 60 {
                # ax*by - ay*bx, rejecting overflow in either intermediate.
                let positive: f64 = stack[depth - 4].value * stack[depth - 1].value
                let negative: f64 = stack[depth - 3].value * stack[depth - 2].value
                if not bounded_value(positive) or not bounded_value(negative) {
                    return failed(instruction.source_start)
                }
                sum = positive - negative
                if not bounded_value(sum) { return failed(instruction.source_start) }
            }
            depth = depth - arity + 1
            stack[depth - 1] = quantity(sum, output_dimension)
            predicate[depth - 1] = false
        } elif opcode >= 52 and opcode <= 55 {
            # Bounded five-through-eight component vector norms. Scale before
            # squaring to avoid overflow/underflow in the intermediate sum.
            let arity: i32 = opcode - 47
            if depth < arity { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - arity]
            let mut scale: f64 = 0.0
            let mut component: i32 = 0
            while component < arity {
                let position: i32 = depth - arity + component
                let value: Quantity = stack[position]
                if predicate[position] or
                   not same_dimension(first.dimension, value.dimension) {
                    return failed(instruction.source_start)
                }
                let absolute: f64 = magnitude(value.value)
                if absolute > scale { scale = absolute }
                component = component + 1
            }
            let mut norm: f64 = 0.0
            if scale > 0.0 {
                let mut sum: f64 = 0.0
                component = 0
                while component < arity {
                    let normalized: f64 = stack[depth - arity + component].value / scale
                    sum = sum + normalized * normalized
                    component = component + 1
                }
                norm = scale * positive_square_root(sum)
            }
            if not bounded_value(norm) { return failed(instruction.source_start) }
            depth = depth - arity + 1
            stack[depth - 1] = quantity(norm, first.dimension)
            predicate[depth - 1] = false
        } elif opcode == 51 {
            if depth < 4 { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - 4]
            let second: Quantity = stack[depth - 3]
            let third: Quantity = stack[depth - 2]
            let fourth: Quantity = stack[depth - 1]
            if predicate[depth - 4] or predicate[depth - 3] or
               predicate[depth - 2] or predicate[depth - 1] or
               not same_dimension(first.dimension, second.dimension) or
               not same_dimension(first.dimension, third.dimension) or
               not same_dimension(first.dimension, fourth.dimension) {
                return failed(instruction.source_start)
            }
            let a: f64 = magnitude(first.value)
            let b: f64 = magnitude(second.value)
            let c: f64 = magnitude(third.value)
            let d: f64 = magnitude(fourth.value)
            let mut scale: f64 = a
            if b > scale { scale = b }
            if c > scale { scale = c }
            if d > scale { scale = d }
            let mut norm: f64 = 0.0
            if scale > 0.0 {
                let x: f64 = a / scale
                let y: f64 = b / scale
                let z: f64 = c / scale
                let w: f64 = d / scale
                norm = scale * positive_square_root(x * x + y * y + z * z + w * w)
            }
            if not bounded_value(norm) { return failed(instruction.source_start) }
            depth = depth - 3
            stack[depth - 1] = quantity(norm, first.dimension)
            predicate[depth - 1] = false
        } elif opcode == 45 {
            if depth < 3 { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - 3]
            let second: Quantity = stack[depth - 2]
            let third: Quantity = stack[depth - 1]
            if predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
               not same_dimension(first.dimension, second.dimension) or
               not same_dimension(first.dimension, third.dimension) {
                return failed(instruction.source_start)
            }
            let a: f64 = magnitude(first.value)
            let b: f64 = magnitude(second.value)
            let c: f64 = magnitude(third.value)
            let mut scale: f64 = a
            if b > scale { scale = b }
            if c > scale { scale = c }
            let mut norm: f64 = 0.0
            if scale > 0.0 {
                let x: f64 = a / scale
                let y: f64 = b / scale
                let z: f64 = c / scale
                norm = scale * positive_square_root(x * x + y * y + z * z)
            }
            if not bounded_value(norm) { return failed(instruction.source_start) }
            depth = depth - 2
            stack[depth - 1] = quantity(norm, first.dimension)
            predicate[depth - 1] = false
        } elif opcode == 69 {
            # Explicit absolute tolerance, never an implicit epsilon. Inputs
            # share physical dimensions; negative tolerance and predicates
            # are invalid. The result is a typed Boolean, not a scalar.
            if depth < 3 { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - 3]
            let second: Quantity = stack[depth - 2]
            let tolerance: Quantity = stack[depth - 1]
            if predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
               not same_dimension(first.dimension, second.dimension) or
               not same_dimension(first.dimension, tolerance.dimension) or
               tolerance.value < 0.0 {
                return failed(instruction.source_start)
            }
            let mut matched: f64 = 0.0
            if magnitude(first.value - second.value) <= tolerance.value {
                matched = 1.0
            }
            depth = depth - 2
            stack[depth - 1] = quantity(matched, dimensionless())
            predicate[depth - 1] = true
        } elif opcode == 67 or opcode == 68 {
            # Dimensioned transition coordinates, dimensionless result. The
            # endpoint tests ensure exact saturation and avoid cancellation.
            # Both polynomials are monotone on [0,1], with zero endpoint
            # derivatives (C1 cubic; C2 quintic).
            if depth < 3 { return failed(instruction.source_start) }
            let lower: Quantity = stack[depth - 3]
            let upper: Quantity = stack[depth - 2]
            let sample: Quantity = stack[depth - 1]
            if predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
               not same_dimension(lower.dimension, upper.dimension) or
               not same_dimension(lower.dimension, sample.dimension) or
               upper.value <= lower.value {
                return failed(instruction.source_start)
            }
            let mut value: f64 = 0.0
            if sample.value >= upper.value {
                value = 1.0
            } elif sample.value > lower.value {
                let t: f64 = (sample.value - lower.value) / (upper.value - lower.value)
                if opcode == 67 {
                    value = t * t * (3.0 - 2.0 * t)
                } else {
                    value = t * t * t * (t * (6.0 * t - 15.0) + 10.0)
                }
            }
            if not bounded_value(value) { return failed(instruction.source_start) }
            depth = depth - 2
            stack[depth - 1] = quantity(value, dimensionless())
            predicate[depth - 1] = false
        } elif opcode == 66 {
            # Convex interpolation avoids forming b-a, which may overflow
            # even when both endpoints and the interpolated result are bounded.
            if depth < 3 { return failed(instruction.source_start) }
            let first: Quantity = stack[depth - 3]
            let second: Quantity = stack[depth - 2]
            let weight: Quantity = stack[depth - 1]
            if predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
               not same_dimension(first.dimension, second.dimension) or
               not same_dimension(weight.dimension, dimensionless()) or
               weight.value < 0.0 or weight.value > 1.0 {
                return failed(instruction.source_start)
            }
            let value: f64 = first.value * (1.0 - weight.value) + second.value * weight.value
            if not bounded_value(value) { return failed(instruction.source_start) }
            depth = depth - 2
            stack[depth - 1] = quantity(value, first.dimension)
            predicate[depth - 1] = false
        } elif opcode == 9 or opcode == 19 {
            if depth < 3 { return failed(instruction.source_start) }
            let third: Quantity = stack[depth - 1]
            let second: Quantity = stack[depth - 2]
            let first: Quantity = stack[depth - 3]
            let mut selected: Quantity = first
            if opcode == 9 {
                if predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
                   not same_dimension(first.dimension, second.dimension) or
                   not same_dimension(first.dimension, third.dimension) or
                   second.value > third.value {
                    return failed(instruction.source_start)
                }
                if selected.value < second.value { selected = second }
                if selected.value > third.value { selected = third }
            } else {
                if not predicate[depth - 3] or predicate[depth - 2] or predicate[depth - 1] or
                   not same_dimension(second.dimension, third.dimension) {
                    return failed(instruction.source_start)
                }
                selected = third
                if first.value != 0.0 { selected = second }
            }
            depth = depth - 2
            stack[depth - 1] = selected
            predicate[depth - 1] = false
        } else {
            return failed(instruction.source_start)
        }
        index = index + 1
    }
    if depth != 1 { return failed(program.source_length) }
    return MathResult {
        valid: true, result: stack[0], failed_at: -1, is_predicate: predicate[0]
    }
}
