# Executable native Flow expm1 regression, not an editor completion.
# flow run src/math_expm1_smoke.flow
import .math_dimensions { Quantity, dimensionless, length_dimension, quantity, same_dimension }
import .math_expression_ir { MathInstruction, MathProgram, MathResult, evaluate_math_ir }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }
import .math_static { MathInferredType, infer_math_ir, infer_math_expression_source, infer_math_equation_source }
import .math_equation { MathEquationResult, evaluate_math_equation_source }

function close(actual: f64, expected: f64, tolerance: f64) -> bool {
    let mut difference: f64 = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference <= tolerance
}

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("expm1(0)")
    if not result.valid or not close(result.result.value, 0.0, 0.000000000000001) { return 1 }
    result = evaluate_math_expression("expm1(1)")
    if not result.valid or not close(result.result.value, 1.718281828459045, 0.00000000000001) { return 2 }
    result = evaluate_math_expression("expm1(-1)")
    if not result.valid or not close(result.result.value, -0.6321205588285577, 0.00000000000001) { return 3 }
    result = evaluate_math_expression("expm1(0.5)")
    if not result.valid or not close(result.result.value, 0.6487212707001282, 0.00000000000001) { return 4 }
    result = evaluate_math_expression("expm1(-0.5)")
    if not result.valid or not close(result.result.value, -0.3934693402873666, 0.00000000000001) { return 5 }
    result = evaluate_math_expression("expm1(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000010000000000005, 0.000000000000000000000001) { return 6 }
    result = evaluate_math_expression("expm1(-0.000000000001)")
    if not result.valid or not close(result.result.value, -0.0000000000009999999999995, 0.000000000000000000000001) { return 7 }
    result = evaluate_math_expression("expm1(0.0000000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000000001, 0.0000000000000000000000000001) { return 8 }
    result = evaluate_math_expression("expm1(-0.0000000000000001)")
    if not result.valid or not close(result.result.value, -0.0000000000000001, 0.0000000000000000000000000001) { return 9 }
    result = evaluate_math_expression("expm1(20)")
    if not result.valid or not close(result.result.value / 485165194.4097903, 1.0, 0.00000000001) { return 10 }
    result = evaluate_math_expression("expm1(-20)")
    if not result.valid or not close(result.result.value, -0.9999999979388464, 0.00000000001) { return 11 }
    result = evaluate_math_expression("expm1(60)/exp(60)")
    if not result.valid or not close(result.result.value, 1.0, 0.00000000001) { return 12 }
    result = evaluate_math_expression("expm1(-60)")
    if not result.valid or not close(result.result.value, -1.0, 0.00000000001) { return 13 }
    result = evaluate_math_expression("log1p(expm1(0.5))")
    if not result.valid or not close(result.result.value, 0.5, 0.00000000001) { return 14 }
    result = evaluate_math_expression("expm1(log1p(0.5))")
    if not result.valid or not close(result.result.value, 0.5, 0.00000000001) { return 15 }
    result = evaluate_math_expression("expm1(1m/1m)")
    if not result.valid or not close(result.result.value, 1.718281828459045, 0.00000000001) or
       not same_dimension(result.result.dimension, dimensionless()) { return 16 }
    result = evaluate_math_expression("expm1(1m)")
    if result.valid or result.failed_at != 0 { return 17 }
    result = evaluate_math_expression("expm1(true)")
    if result.valid or result.failed_at != 0 { return 18 }
    result = evaluate_math_expression("expm1(1<2)")
    if result.valid or result.failed_at != 0 { return 19 }
    result = evaluate_math_expression("expm1(61)")
    if result.valid or result.failed_at != 0 { return 20 }
    result = evaluate_math_expression("expm1(-61)")
    if result.valid or result.failed_at != 0 { return 21 }
    result = evaluate_math_expression("1+expm1(1m)")
    if result.valid or result.failed_at != 2 { return 22 }
    if parse_math_expression("expm1()").valid { return 23 }
    if parse_math_expression("expm1(1,2)").valid { return 24 }
    if parse_math_expression("expm1 (1)").valid { return 25 }
    if parse_math_expression("expm1(1").valid { return 26 }
    let parsed: ParsedMathExpression = parse_math_expression("expm1(1)")
    if not parsed.valid or parsed.program.count != 2 or
       parsed.program.instructions[1].opcode != 43 or
       parsed.program.instructions[1].source_start != 0 or
       parsed.program.instructions[1].source_end != 5 { return 27 }
    let mut inferred: MathInferredType = infer_math_expression_source("expm1(1)")
    if not inferred.valid or inferred.is_predicate or
       not same_dimension(inferred.dimension, dimensionless()) { return 28 }
    inferred = infer_math_expression_source("expm1(61)")
    if not inferred.valid or inferred.is_predicate { return 29 }
    inferred = infer_math_expression_source("expm1(1m)")
    if inferred.valid or inferred.failed_at != 0 { return 30 }
    inferred = infer_math_expression_source("expm1(true)")
    if inferred.valid or inferred.failed_at != 0 { return 31 }
    let tolerance: Quantity = quantity(0.00000000001, dimensionless())
    let mut equation: MathEquationResult = evaluate_math_equation_source("expm1(0) = 0", tolerance)
    if not equation.valid or not equation.satisfied { return 32 }
    equation = evaluate_math_equation_source("expm1(1) = exp(1)-1", tolerance)
    if not equation.valid or not equation.satisfied { return 33 }
    equation = evaluate_math_equation_source("expm1(1m) = 0", tolerance)
    if equation.valid { return 34 }
    inferred = infer_math_equation_source("expm1(0) = 0")
    if not inferred.valid or not same_dimension(inferred.dimension, dimensionless()) { return 35 }
    let blank: MathInstruction = MathInstruction {
        opcode: 0, literal: quantity(0.0, dimensionless()),
        exponent: 0, source_start: 0, source_end: 0
    }
    let mut instructions: array<MathInstruction, 64> = [blank]
    instructions[0] = MathInstruction {
        opcode: 0, literal: quantity(0.5, dimensionless()),
        exponent: 0, source_start: 0, source_end: 1
    }
    instructions[1] = MathInstruction {
        opcode: 43, literal: quantity(0.0, dimensionless()),
        exponent: 0, source_start: 1, source_end: 2
    }
    let program: MathProgram = MathProgram { instructions: instructions, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, 0.6487212707001282, 0.00000000000001) { return 36 }
    inferred = infer_math_ir(program)
    if not inferred.valid or not same_dimension(inferred.dimension, dimensionless()) { return 37 }
    instructions[0] = MathInstruction {
        opcode: 0, literal: quantity(0.5, length_dimension()),
        exponent: 0, source_start: 0, source_end: 1
    }
    let invalid_program: MathProgram = MathProgram { instructions: instructions, count: 2, source_length: 2 }
    result = evaluate_math_ir(invalid_program)
    if result.valid or result.failed_at != 1 { return 38 }
    inferred = infer_math_ir(invalid_program)
    if inferred.valid or inferred.failed_at != 1 { return 39 }
    println("native-math-expm1-ok")
    return 0
}
