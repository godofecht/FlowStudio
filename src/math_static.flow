# Native Flow 2.0 static physical-type inference for bounded mathematical postfix IR.
# Operates on opcode structure and SI exponents without evaluating numeric values.
# It does not perform value-range analysis, symbolic algebra, or PDE inference.
import .math_dimensions { Dimension, dimensionless, same_dimension, quantity, product_dimension, quotient_dimension, length_dimension }
import .math_expression_ir { MathInstruction, MathProgram, MathPermutation4, math_permutation4 }
import .math_expression_source { MathSymbol, MathBindings, ParsedMathExpression, parse_math_expression_with_bindings, empty_math_bindings }
import .math_equation { MathEquation, parse_math_equation_with_bindings }

export struct MathInferredType {
    valid: bool,
    dimension: Dimension,
    is_predicate: bool,
    failed_at: i32
}

function static_error(position: i32) -> MathInferredType {
    return MathInferredType {
        valid: false, dimension: dimensionless(),
        is_predicate: false, failed_at: position
    }
}

function static_bounded_dimension(d: Dimension) -> bool {
    return d.length >= -32 and d.length <= 32 and
        d.mass >= -32 and d.mass <= 32 and
        d.time >= -32 and d.time <= 32 and
        d.temperature >= -32 and d.temperature <= 32
}

function static_even_dimension(d: Dimension) -> bool {
    return d.length == (d.length / 2) * 2 and
        d.mass == (d.mass / 2) * 2 and
        d.time == (d.time / 2) * 2 and
        d.temperature == (d.temperature / 2) * 2
}

function static_half_dimension(d: Dimension) -> Dimension {
    return Dimension {
        length: d.length / 2, mass: d.mass / 2,
        time: d.time / 2, temperature: d.temperature / 2
    }
}

function static_divisible_by_root_degree(d: Dimension, degree: i32) -> bool {
    return d.length == (d.length / degree) * degree and
        d.mass == (d.mass / degree) * degree and
        d.time == (d.time / degree) * degree and
        d.temperature == (d.temperature / degree) * degree
}

function static_root_dimension(d: Dimension, degree: i32) -> Dimension {
    return Dimension {
        length: d.length / degree, mass: d.mass / degree,
        time: d.time / degree, temperature: d.temperature / degree
    }
}

function static_fourth_dimension(d: Dimension) -> Dimension {
    return Dimension {
        length: d.length / 4, mass: d.mass / 4,
        time: d.time / 4, temperature: d.temperature / 4
    }
}

function static_divisible_by_four_dimension(d: Dimension) -> bool {
    return d.length == (d.length / 4) * 4 and
        d.mass == (d.mass / 4) * 4 and
        d.time == (d.time / 4) * 4 and
        d.temperature == (d.temperature / 4) * 4
}

function static_third_dimension(d: Dimension) -> Dimension {
    return Dimension {
        length: d.length / 3, mass: d.mass / 3,
        time: d.time / 3, temperature: d.temperature / 3
    }
}

function static_divisible_by_three_dimension(d: Dimension) -> bool {
    return d.length == (d.length / 3) * 3 and
        d.mass == (d.mass / 3) * 3 and
        d.time == (d.time / 3) * 3 and
        d.temperature == (d.temperature / 3) * 3
}

function static_powered_dimension(d: Dimension, exponent: i32) -> Dimension {
    return Dimension {
        length: d.length * exponent, mass: d.mass * exponent,
        time: d.time * exponent, temperature: d.temperature * exponent
    }
}

# Unlike evaluate_math_ir, this checks every operand's physical type
# without dividing, taking a square root, comparing values or selecting a
# branch. Thus it can accept well-typed expressions with runtime domain errors.
export function infer_math_ir(program: MathProgram) -> MathInferredType {
    if program.count < 1 or program.count > 64 or program.source_length < 0 {
        return static_error(0)
    }
    let mut dimensions: array<Dimension, 64> = [dimensionless()]
    let mut predicates: array<bool, 64> = [false]
    let mut depth: i32 = 0
    let mut index: i32 = 0
    while index < program.count {
        let instruction: MathInstruction = program.instructions[index]
        if instruction.source_start < 0 or
           instruction.source_end < instruction.source_start or
           instruction.source_end > program.source_length {
            return static_error(index)
        }
        let opcode: i32 = instruction.opcode
        if opcode == 0 {
            if depth >= 64 or not static_bounded_dimension(instruction.literal.dimension) {
                return static_error(instruction.source_start)
            }
            dimensions[depth] = instruction.literal.dimension
            predicates[depth] = false
            depth = depth + 1
        } elif opcode == 24 {
            # Validate the typed literal representation without evaluating expressions.
            if depth >= 64 or instruction.exponent != 0 or
               not same_dimension(instruction.literal.dimension, dimensionless()) or
               (instruction.literal.value != 0.0 and instruction.literal.value != 1.0) {
                return static_error(instruction.source_start)
            }
            dimensions[depth] = dimensionless()
            predicates[depth] = true
            depth = depth + 1
        } elif opcode == 5 or opcode == 6 or opcode == 18 or opcode == 20 or opcode == 21 or opcode == 25 or
             opcode == 26 or opcode == 27 or opcode == 28 or opcode == 29 or opcode == 30 or opcode == 31 or
             opcode == 33 or opcode == 34 or opcode == 35 or opcode == 36 or opcode == 37 or
             opcode == 38 or opcode == 39 or opcode == 40 or opcode == 42 or opcode == 43 or opcode == 44 or opcode == 46 or opcode == 56 or opcode == 57 or (opcode >= 47 and opcode <= 50) {
            if depth < 1 { return static_error(instruction.source_start) }
            let input: Dimension = dimensions[depth - 1]
            if opcode == 18 {
                if not predicates[depth - 1] { return static_error(instruction.source_start) }
                dimensions[depth - 1] = dimensionless()
            } else {
                if predicates[depth - 1] { return static_error(instruction.source_start) }
                if opcode == 57 {
                    dimensions[depth - 1] = dimensionless()
                } elif opcode == 6 {
                    if instruction.exponent < -8 or instruction.exponent > 8 {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = static_powered_dimension(input, instruction.exponent)
                } elif opcode == 21 {
                    if not static_even_dimension(input) {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = static_half_dimension(input)
                } elif opcode >= 47 and opcode <= 50 {
                    let degree: i32 = opcode - 42
                    if not static_divisible_by_root_degree(input, degree) {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = static_root_dimension(input, degree)
                } elif opcode == 46 {
                    if not static_divisible_by_four_dimension(input) {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = static_fourth_dimension(input)
                } elif opcode == 44 {
                    if not static_divisible_by_three_dimension(input) {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = static_third_dimension(input)
                } elif opcode == 25 or opcode == 26 or opcode == 27 or opcode == 28 or opcode == 29 or opcode == 30 or opcode == 31 or
                       opcode == 33 or opcode == 34 or opcode == 35 or opcode == 36 or opcode == 37 or
                       opcode == 38 or opcode == 39 or opcode == 40 or opcode == 42 or opcode == 43 or opcode == 56 {
                    if not same_dimension(input, dimensionless()) {
                        return static_error(instruction.source_start)
                    }
                    dimensions[depth - 1] = dimensionless()
                }
            }
            if not static_bounded_dimension(dimensions[depth - 1]) {
                return static_error(instruction.source_start)
            }
        } elif (opcode >= 1 and opcode <= 4) or opcode == 7 or opcode == 8 or
             (opcode >= 10 and opcode <= 17) or opcode == 22 or opcode == 32 {
            if depth < 2 { return static_error(instruction.source_start) }
            let left: Dimension = dimensions[depth - 2]
            let right: Dimension = dimensions[depth - 1]
            let left_predicate: bool = predicates[depth - 2]
            let right_predicate: bool = predicates[depth - 1]
            let mut result: Dimension = left
            let mut result_predicate: bool = false
            if opcode == 32 {
                # atan2(y, x) is an angle; its inputs must have equal units.
                # The zero/zero domain error is deliberately runtime-only.
                if left_predicate or right_predicate or not same_dimension(left, right) {
                    return static_error(instruction.source_start)
                }
                result = dimensionless()
            } elif opcode == 16 or opcode == 17 {
                if not left_predicate or not right_predicate {
                    return static_error(instruction.source_start)
                }
                result = dimensionless()
                result_predicate = true
            } elif opcode >= 10 and opcode <= 15 {
                if left_predicate or right_predicate or not same_dimension(left, right) {
                    return static_error(instruction.source_start)
                }
                result = dimensionless()
                result_predicate = true
            } else {
                if left_predicate or right_predicate {
                    return static_error(instruction.source_start)
                }
                if opcode == 3 {
                    result = Dimension {
                        length: left.length + right.length,
                        mass: left.mass + right.mass,
                        time: left.time + right.time,
                        temperature: left.temperature + right.temperature
                    }
                } elif opcode == 4 {
                    result = Dimension {
                        length: left.length - right.length,
                        mass: left.mass - right.mass,
                        time: left.time - right.time,
                        temperature: left.temperature - right.temperature
                    }
                } else {
                    if not same_dimension(left, right) {
                        return static_error(instruction.source_start)
                    }
                }
            }
            if not static_bounded_dimension(result) {
                return static_error(instruction.source_start)
            }
            depth = depth - 1
            dimensions[depth - 1] = result
            predicates[depth - 1] = result_predicate
        } elif opcode == 58 or opcode == 59 or opcode == 60 or opcode == 61 or
             (opcode >= 62 and opcode <= 65) {
            let mut components: i32 = 2
            if opcode == 59 { components = 3 }
            if opcode == 61 { components = 4 }
            if opcode >= 62 and opcode <= 65 { components = opcode - 57 }
            let arity: i32 = components * 2
            if depth < arity { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - arity]
            let second: Dimension = dimensions[depth - components]
            let output_dimension: Dimension = product_dimension(first, second)
            let mut component: i32 = 0
            while component < components {
                let left_index: i32 = depth - arity + component
                let right_index: i32 = depth - components + component
                if predicates[left_index] or predicates[right_index] or
                   not same_dimension(dimensions[left_index], first) or
                   not same_dimension(dimensions[right_index], second) {
                    return static_error(instruction.source_start)
                }
                component = component + 1
            }
            if not static_bounded_dimension(output_dimension) {
                return static_error(instruction.source_start)
            }
            depth = depth - arity + 1
            dimensions[depth - 1] = output_dimension
            predicates[depth - 1] = false
        } elif opcode == 73 or opcode == 74 {
            # Infer variadic reduction dimensions without evaluating values.
            let arity: i32 = instruction.exponent
            if arity < 1 or arity > 8 or depth < arity {
                return static_error(instruction.source_start)
            }
            let base: i32 = depth - arity
            let mut output_dimension: Dimension = dimensionless()
            let mut component: i32 = 0
            while component < arity {
                let position: i32 = base + component
                if predicates[position] { return static_error(instruction.source_start) }
                if opcode == 73 {
                    if component == 0 {
                        output_dimension = dimensions[position]
                    } elif not same_dimension(output_dimension, dimensions[position]) {
                        return static_error(instruction.source_start)
                    }
                } else {
                    output_dimension = product_dimension(output_dimension, dimensions[position])
                }
                if not static_bounded_dimension(output_dimension) {
                    return static_error(instruction.source_start)
                }
                component = component + 1
            }
            depth = base + 1
            dimensions[base] = output_dimension
            predicates[base] = false
        } elif (opcode >= 75 and opcode <= 79) or opcode == 80 {
            # Infer statistical reductions without evaluating inputs.
            # Type-7 quantile takes a dimensionless, non-predicate probability
            # followed by physical observations of one common SI dimension.
            let arity: i32 = instruction.exponent
            if arity < 1 or arity > 8 or depth < arity or
               (opcode == 80 and arity < 2) {
                return static_error(instruction.source_start)
            }
            let base: i32 = depth - arity
            let mut first_sample: i32 = base
            if opcode == 80 {
                if predicates[base] or
                   not same_dimension(dimensions[base], dimensionless()) {
                    return static_error(instruction.source_start)
                }
                first_sample = base + 1
            }
            let input_dimension: Dimension = dimensions[first_sample]
            let mut position: i32 = first_sample
            while position < depth {
                if predicates[position] or
                   not same_dimension(dimensions[position], input_dimension) {
                    return static_error(instruction.source_start)
                }
                position = position + 1
            }
            let mut output_dimension: Dimension = input_dimension
            if opcode == 76 {
                output_dimension = product_dimension(input_dimension, input_dimension)
            }
            if not static_bounded_dimension(output_dimension) {
                return static_error(instruction.source_start)
            }
            depth = base + 1
            dimensions[base] = output_dimension
            predicates[base] = false
        } elif opcode == 81 or opcode == 82 or opcode == 83 {
            # Infer derivative dimensions without evaluating step sizes.
            let mut arity: i32 = 3
            let mut fields: i32 = 2
            if opcode == 82 {
                arity = 4
                fields = 3
            }
            if opcode == 83 {
                arity = 7
                fields = 5
            }
            if depth < arity { return static_error(instruction.source_start) }
            let base: i32 = depth - arity
            let field_dimension: Dimension = dimensions[base]
            let mut component: i32 = 0
            while component < fields {
                let position: i32 = base + component
                if predicates[position] or
                   not same_dimension(dimensions[position], field_dimension) {
                    return static_error(instruction.source_start)
                }
                component = component + 1
            }
            let step_position: i32 = base + fields
            let step_dimension: Dimension = dimensions[step_position]
            if predicates[step_position] { return static_error(instruction.source_start) }
            if opcode == 83 {
                if predicates[step_position + 1] or
                   not same_dimension(step_dimension, length_dimension()) or
                   not same_dimension(dimensions[step_position + 1], length_dimension()) {
                    return static_error(instruction.source_start)
                }
            }
            let mut output_dimension: Dimension = quotient_dimension(field_dimension, step_dimension)
            if opcode != 81 {
                output_dimension = quotient_dimension(output_dimension, step_dimension)
            }
            if not static_bounded_dimension(output_dimension) {
                return static_error(instruction.source_start)
            }
            depth = base + 1
            dimensions[base] = output_dimension
            predicates[base] = false
        } elif opcode == 70 or opcode == 71 or opcode == 72 {
            let mut arity: i32 = 4
            if opcode == 71 { arity = 9 }
            if opcode == 72 { arity = 16 }
            if depth < arity { return static_error(instruction.source_start) }
            let base: i32 = depth - arity
            let mut component: i32 = 0
            while component < arity {
                if predicates[base + component] {
                    return static_error(instruction.source_start)
                }
                component = component + 1
            }
            let mut output_dimension: Dimension = dimensionless()
            if opcode == 70 {
                output_dimension = product_dimension(dimensions[base], dimensions[base + 3])
                let alternative: Dimension = product_dimension(
                    dimensions[base + 1], dimensions[base + 2])
                if not same_dimension(output_dimension, alternative) {
                    return static_error(instruction.source_start)
                }
            } elif opcode == 71 {
                let permutations: array<i32, 18> = [
                    0,4,8, 0,5,7, 1,3,8, 1,5,6, 2,3,7, 2,4,6
                ]
                let mut term_index: i32 = 0
                while term_index < 6 {
                    let offset: i32 = term_index * 3
                    let term_dimension: Dimension = product_dimension(
                        product_dimension(dimensions[base + permutations[offset]],
                            dimensions[base + permutations[offset + 1]]),
                        dimensions[base + permutations[offset + 2]])
                    if term_index == 0 {
                        output_dimension = term_dimension
                    } elif not same_dimension(output_dimension, term_dimension) {
                        return static_error(instruction.source_start)
                    }
                    term_index = term_index + 1
                }
            } else {
                let mut term_index: i32 = 0
                while term_index < 24 {
                    let permutation: MathPermutation4 = math_permutation4(term_index)
                    let mut term_dimension: Dimension = dimensionless()
                    let mut row: i32 = 0
                    while row < 4 {
                        term_dimension = product_dimension(term_dimension,
                            dimensions[base + row * 4 + permutation.columns[row]])
                        row = row + 1
                    }
                    if term_index == 0 {
                        output_dimension = term_dimension
                    } elif not same_dimension(output_dimension, term_dimension) {
                        return static_error(instruction.source_start)
                    }
                    term_index = term_index + 1
                }
            }
            if not static_bounded_dimension(output_dimension) {
                return static_error(instruction.source_start)
            }
            depth = base + 1
            dimensions[base] = output_dimension
            predicates[base] = false
        } elif opcode >= 52 and opcode <= 55 {
            let arity: i32 = opcode - 47
            if depth < arity { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - arity]
            let mut component: i32 = 0
            while component < arity {
                let position: i32 = depth - arity + component
                if predicates[position] or
                   not same_dimension(first, dimensions[position]) {
                    return static_error(instruction.source_start)
                }
                component = component + 1
            }
            depth = depth - arity + 1
            dimensions[depth - 1] = first
            predicates[depth - 1] = false
        } elif opcode == 51 {
            if depth < 4 { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - 4]
            let second: Dimension = dimensions[depth - 3]
            let third: Dimension = dimensions[depth - 2]
            let fourth: Dimension = dimensions[depth - 1]
            if predicates[depth - 4] or predicates[depth - 3] or
               predicates[depth - 2] or predicates[depth - 1] or
               not same_dimension(first, second) or not same_dimension(first, third) or
               not same_dimension(first, fourth) {
                return static_error(instruction.source_start)
            }
            depth = depth - 3
            dimensions[depth - 1] = first
            predicates[depth - 1] = false
        } elif opcode == 45 {
            if depth < 3 { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - 3]
            let second: Dimension = dimensions[depth - 2]
            let third: Dimension = dimensions[depth - 1]
            if predicates[depth - 3] or predicates[depth - 2] or predicates[depth - 1] or
               not same_dimension(first, second) or not same_dimension(first, third) {
                return static_error(instruction.source_start)
            }
            depth = depth - 2
            dimensions[depth - 1] = first
            predicates[depth - 1] = false
        } elif opcode == 69 {
            # Numeric tolerance bounds are runtime-only. All three operands
            # must be scalars of the same SI dimension, not predicates.
            if depth < 3 { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - 3]
            let second: Dimension = dimensions[depth - 2]
            let tolerance: Dimension = dimensions[depth - 1]
            if predicates[depth - 3] or predicates[depth - 2] or predicates[depth - 1] or
               not same_dimension(first, second) or
               not same_dimension(first, tolerance) {
                return static_error(instruction.source_start)
            }
            depth = depth - 2
            dimensions[depth - 1] = dimensionless()
            predicates[depth - 1] = true
        } elif opcode == 67 or opcode == 68 {
            if depth < 3 { return static_error(instruction.source_start) }
            let lower: Dimension = dimensions[depth - 3]
            let upper: Dimension = dimensions[depth - 2]
            let sample: Dimension = dimensions[depth - 1]
            if predicates[depth - 3] or predicates[depth - 2] or predicates[depth - 1] or
               not same_dimension(lower, upper) or not same_dimension(lower, sample) {
                return static_error(instruction.source_start)
            }
            depth = depth - 2
            dimensions[depth - 1] = dimensionless()
            predicates[depth - 1] = false
        } elif opcode == 66 {
            if depth < 3 { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - 3]
            let second: Dimension = dimensions[depth - 2]
            let weight: Dimension = dimensions[depth - 1]
            if predicates[depth - 3] or predicates[depth - 2] or predicates[depth - 1] or
               not same_dimension(first, second) or
               not same_dimension(weight, dimensionless()) {
                return static_error(instruction.source_start)
            }
            depth = depth - 2
            dimensions[depth - 1] = first
            predicates[depth - 1] = false
        } elif opcode == 9 or opcode == 19 {
            if depth < 3 { return static_error(instruction.source_start) }
            let first: Dimension = dimensions[depth - 3]
            let second: Dimension = dimensions[depth - 2]
            let third: Dimension = dimensions[depth - 1]
            let mut result: Dimension = first
            if opcode == 9 {
                if predicates[depth - 3] or predicates[depth - 2] or
                   predicates[depth - 1] or not same_dimension(first, second) or
                   not same_dimension(first, third) {
                    return static_error(instruction.source_start)
                }
            } else {
                if not predicates[depth - 3] or predicates[depth - 2] or
                   predicates[depth - 1] or not same_dimension(second, third) {
                    return static_error(instruction.source_start)
                }
                result = second
            }
            depth = depth - 2
            dimensions[depth - 1] = result
            predicates[depth - 1] = false
        } else {
            return static_error(instruction.source_start)
        }
        index = index + 1
    }
    if depth != 1 { return static_error(program.source_length) }
    return MathInferredType {
        valid: true, dimension: dimensions[0],
        is_predicate: predicates[0], failed_at: -1
    }
}

export function infer_math_expression_source_with_bindings(source: string, bindings: MathBindings) -> MathInferredType {
    let parsed: ParsedMathExpression = parse_math_expression_with_bindings(source, bindings)
    if not parsed.valid { return static_error(parsed.failed_at) }
    return infer_math_ir(parsed.program)
}

export function infer_math_expression_source(source: string) -> MathInferredType {
    return infer_math_expression_source_with_bindings(source, empty_math_bindings())
}

export function infer_math_equation(equation: MathEquation) -> MathInferredType {
    if not equation.valid { return static_error(equation.failed_at) }
    if equation.equality_at < 0 or equation.equality_at >= equation.left.source_length or
       equation.left.source_length != equation.right.source_length {
        return static_error(0)
    }
    let left: MathInferredType = infer_math_ir(equation.left)
    if not left.valid { return left }
    let right: MathInferredType = infer_math_ir(equation.right)
    if not right.valid { return right }
    if left.is_predicate or right.is_predicate or
       not same_dimension(left.dimension, right.dimension) {
        return static_error(equation.equality_at)
    }
    return MathInferredType {
        valid: true, dimension: left.dimension,
        is_predicate: false, failed_at: -1
    }
}

export function infer_math_equation_source_with_bindings(source: string, bindings: MathBindings) -> MathInferredType {
    return infer_math_equation(parse_math_equation_with_bindings(source, bindings))
}

export function infer_math_equation_source(source: string) -> MathInferredType {
    return infer_math_equation_source_with_bindings(source, empty_math_bindings())
}


# Type-only declarations are not numerical bindings. They let callers
# validate physical dimensions before any runtime symbol values exist.
# The source parser still validates names, duplicate declarations, UTF-8
# positions and expression syntax. Dummy literal magnitudes are never
# evaluated by this inference path.
export struct MathDimensionSymbol {
    name: string,
    dimension: Dimension
}

export struct MathDimensionBindings {
    symbols: array<MathDimensionSymbol, 8>,
    count: i32
}

export function empty_math_dimension_bindings() -> MathDimensionBindings {
    let blank: MathDimensionSymbol = MathDimensionSymbol {
        name: "", dimension: dimensionless()
    }
    return MathDimensionBindings { symbols: [blank], count: 0 }
}

function declared_dimension_bindings(declarations: MathDimensionBindings) -> MathBindings {
    let mut bindings: MathBindings = empty_math_bindings()
    bindings.count = declarations.count
    let mut index: i32 = 0
    while index < declarations.count {
        bindings.symbols[index] = MathSymbol {
            name: declarations.symbols[index].name,
            value: quantity(1.0, declarations.symbols[index].dimension)
        }
        index = index + 1
    }
    return bindings
}

export function infer_math_expression_source_with_dimensions(
    source: string, declarations: MathDimensionBindings) -> MathInferredType {
    if declarations.count < 0 or declarations.count > 8 { return static_error(0) }
    return infer_math_expression_source_with_bindings(
        source, declared_dimension_bindings(declarations))
}

export function infer_math_equation_source_with_dimensions(
    source: string, declarations: MathDimensionBindings) -> MathInferredType {
    if declarations.count < 0 or declarations.count > 8 { return static_error(0) }
    return infer_math_equation_source_with_bindings(
        source, declared_dimension_bindings(declarations))
}
