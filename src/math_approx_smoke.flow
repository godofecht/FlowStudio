# Native Flow 2.0 typed absolute-tolerance comparison, not editor syntax.
# flow run src/math_approx_smoke.flow
import .math_dimensions { dimensionless, length_dimension, same_dimension }
import .math_expression_ir { MathResult }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }
import .math_static { MathInferredType, infer_math_expression_source }

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("approx(1m,2m,1m)")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 or
       not same_dimension(result.result.dimension, dimensionless()) { return 1 }
    result = evaluate_math_expression("approx(1m,2m,0.5m)")
    if not result.valid or not result.is_predicate or result.result.value != 0.0 { return 2 }
    result = evaluate_math_expression("approx(1m,1m,0m)")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 3 }
    result = evaluate_math_expression("approx(1,2,0)")
    if not result.valid or result.result.value != 0.0 { return 4 }
    result = evaluate_math_expression("approx(1,1,0)")
    if not result.valid or result.result.value != 1.0 { return 5 }
    result = evaluate_math_expression("approx(1,2,1)")
    if not result.valid or result.result.value != 1.0 { return 6 }
    result = evaluate_math_expression("approx(1,2,0.999)")
    if not result.valid or result.result.value != 0.0 { return 7 }
    result = evaluate_math_expression("approx(1,2,-1)")
    if result.valid or result.failed_at != 0 { return 8 }
    result = evaluate_math_expression("approx(1m,2s,1m)")
    if result.valid or result.failed_at != 0 { return 9 }
    result = evaluate_math_expression("approx(1m,2m,1s)")
    if result.valid or result.failed_at != 0 { return 10 }
    result = evaluate_math_expression("approx(true,2,1)")
    if result.valid or result.failed_at != 0 { return 11 }
    result = evaluate_math_expression("approx(1,2,true)")
    if result.valid or result.failed_at != 0 { return 12 }
    result = evaluate_math_expression("not approx(1,2,0.5)")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 13 }
    result = evaluate_math_expression("approx(1,2,1) and approx(2,3,1)")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 14 }
    result = evaluate_math_expression("where(approx(1,2,1),3m,4m)")
    if not result.valid or result.is_predicate or result.result.value != 3.0 or
       not same_dimension(result.result.dimension, length_dimension()) { return 15 }
    result = evaluate_math_expression("approx(π,pi,0)")
    if not result.valid or result.result.value != 1.0 { return 16 }
    if parse_math_expression("approx(1,2)").valid { return 17 }
    if parse_math_expression("approx(1,2,3,4)").valid { return 18 }
    if parse_math_expression("approx(1,,3)").valid { return 19 }
    if parse_math_expression("approx()").valid { return 20 }
    let parsed: ParsedMathExpression = parse_math_expression("approx(1m,2m,1m)")
    if not parsed.valid or parsed.program.count != 4 or
       parsed.program.instructions[3].opcode != 69 or
       parsed.program.instructions[3].source_start != 0 or
       parsed.program.instructions[3].source_end != 6 { return 21 }
    let mut inferred: MathInferredType = infer_math_expression_source("approx(1m,2m,1m)")
    if not inferred.valid or not inferred.is_predicate or
       not same_dimension(inferred.dimension, dimensionless()) { return 22 }
    inferred = infer_math_expression_source("approx(1m,2m,1s)")
    if inferred.valid or inferred.failed_at != 0 { return 23 }
    inferred = infer_math_expression_source("approx(1m,2s,1m)")
    if inferred.valid or inferred.failed_at != 0 { return 24 }
    inferred = infer_math_expression_source("approx(true,2,1)")
    if inferred.valid or inferred.failed_at != 0 { return 25 }
    inferred = infer_math_expression_source("approx(1,2,-1)")
    if not inferred.valid or not inferred.is_predicate { return 26 }
    result = evaluate_math_expression("approx(1,2,1)+1")
    if result.valid { return 27 }
    result = evaluate_math_expression("2approx(1,2,1)")
    if result.valid { return 28 }
    inferred = infer_math_expression_source("not approx(1,2,0.5)")
    if not inferred.valid or not inferred.is_predicate { return 29 }
    return 0
}
