# Native Flow 2.0 equation compiler invariants; no Python evaluator.
# flow run src/math_equation_invariants_smoke.flow
import .math_dimensions { Dimension, Quantity, dimensionless, length_dimension, time_dimension, quotient_dimension, quantity, same_dimension }
import .math_expression_source { MathSymbol, MathBindings, empty_math_bindings }
import .math_equation { MathEquation, MathEquationResult, parse_math_equation, evaluate_math_equation_source, evaluate_math_equation_source_with_bindings }

function near(a: f64, b: f64) -> bool {
    let mut difference: f64 = a - b
    if difference < 0.0 { difference = -difference }
    return difference < 0.00000000001
}

function main() -> i32 {
    let metres: Dimension = length_dimension()
    let seconds: Dimension = time_dimension()
    let speed: Dimension = quotient_dimension(metres, seconds)
    let exact_speed: Quantity = quantity(0.0, speed)
    let exact_length: Quantity = quantity(0.0, metres)
    let mut bindings: MathBindings = empty_math_bindings()
    bindings.count = 3
    bindings.symbols[0] = MathSymbol { name: "u₁", value: quantity(3.0, speed) }
    bindings.symbols[1] = MathSymbol { name: "u₂", value: quantity(4.0, speed) }
    bindings.symbols[2] = MathSymbol { name: "ρ", value: quantity(2.0, metres) }

    # The native equation parser must preserve Greek/subscript symbol identity.
    let mut result: MathEquationResult = evaluate_math_equation_source_with_bindings(
        "u₁ + u₂ = 7m/1s", bindings, exact_speed)
    if not result.valid or not result.satisfied or not near(result.residual.value, 0.0) { return 1 }
    result = evaluate_math_equation_source_with_bindings(
        "u₁ + u₁ = 7m/1s", bindings, exact_speed)
    if not result.valid or result.satisfied or not near(result.residual.value, -1.0) { return 2 }

    # A length is not a velocity, even when its numerical value matches.
    result = evaluate_math_equation_source_with_bindings(
        "ρ = 2m", bindings, exact_length)
    if not result.valid or not result.satisfied { return 3 }
    result = evaluate_math_equation_source_with_bindings(
        "ρ = 2m/1s", bindings, exact_speed)
    if result.valid { return 4 }

    # Residual sign reverses when both sides of an equation are exchanged.
    let forward: MathEquationResult = evaluate_math_equation_source(
        "5m = 3m", exact_length)
    let reverse: MathEquationResult = evaluate_math_equation_source(
        "3m = 5m", exact_length)
    if not forward.valid or not reverse.valid { return 5 }
    if forward.satisfied or reverse.satisfied { return 6 }
    if not near(forward.residual.value, 2.0) or
       not near(reverse.residual.value, -2.0) { return 7 }
    if not same_dimension(forward.residual.dimension, metres) or
       not same_dimension(reverse.residual.dimension, metres) { return 8 }

    # Unicode operators must lower through the same executable native path.
    result = evaluate_math_equation_source(
        "2×(3m−1m) = 4m", exact_length)
    if not result.valid or not result.satisfied { return 9 }
    result = evaluate_math_equation_source(
        "where(¬(1<2) ∨ 3<4,3m,4m) = 3m", exact_length)
    if not result.valid or not result.satisfied { return 10 }
    result = evaluate_math_equation_source(
        "1m⋅2s = 2m", exact_length)
    if result.valid { return 11 }
    result = evaluate_math_equation_source(
        "true = false", quantity(0.0, dimensionless()))
    if result.valid { return 12 }
    # Fullwidth equality must lower through the executable native equation parser.
    result = evaluate_math_equation_source("2m＝2m", exact_length)
    if not result.valid or not result.satisfied { return 13 }
    # Multiple top-level equation separators must not silently discard a clause.
    result = evaluate_math_equation_source("1m = 1m = 1m", exact_length)
    if result.valid { return 14 }
    # Unbalanced grouping is rejected before compiling either expression.
    result = evaluate_math_equation_source("(1m + 2m = 3m", exact_length)
    if result.valid { return 15 }
    # Native parser diagnostics retain byte offsets, including UTF-8 operators.
    let parsed: MathEquation = parse_math_equation("2m＝2m")
    if not parsed.valid or parsed.equality_at != 2 or parsed.failed_at != -1 { return 16 }
    parsed = parse_math_equation("2m = 3m = 4m")
    if parsed.valid or parsed.failed_at != 8 { return 17 }
    parsed = parse_math_equation("2m = (3m")
    if parsed.valid or parsed.failed_at != 8 { return 18 }

    # The equation tolerance is a typed, nonnegative quantity.
    result = evaluate_math_equation_source("3m = 2m", quantity(1.0, metres))
    if not result.valid or not result.satisfied or not near(result.residual.value, 1.0) { return 19 }
    result = evaluate_math_equation_source("3m = 2m", quantity(0.999, metres))
    if not result.valid or result.satisfied { return 20 }
    result = evaluate_math_equation_source("3m = 2m", quantity(-1.0, metres))
    if result.valid { return 21 }
    result = evaluate_math_equation_source("3m = 2m", quantity(1.0, seconds))
    if result.valid { return 22 }
    # Both compiled operand programs must retain absolute UTF-8 source spans.
    # This is checked on executable native IR, not editor tokenization.
    parsed = parse_math_equation("2m＝3m")
    if not parsed.valid or parsed.left.count != 1 or parsed.right.count != 1 { return 23 }
    if parsed.left.instructions[0].source_start != 0 or
       parsed.left.instructions[0].source_end != 2 { return 24 }
    if parsed.right.instructions[0].source_start != 5 or
       parsed.right.instructions[0].source_end != 7 { return 25 }
    parsed = parse_math_equation("2m = 3m")
    if not parsed.valid or parsed.right.count != 1 or
       parsed.right.instructions[0].source_start != 5 or
       parsed.right.instructions[0].source_end != 7 { return 26 }
    return 0
}
