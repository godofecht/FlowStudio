    # Natural and base-ten logarithms: analytic values and strict domains.
    operations[0] = instruction(0, quantity(2.718281828459045, dimensionless()), 0, 0)
    operations[1] = instruction(26, quantity(0.0, dimensionless()), 0, 1)
