        return StaticAsset { path: "web/debug_panel.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/workspace_panels.js" {
        return StaticAsset { path: "web/workspace_panels.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ide_completion_core.js" {
        return StaticAsset { path: "web/ide_completion_core.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/terminal_render.js" {
        return StaticAsset { path: "web/terminal_render.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ide_symbols.js" {
        return StaticAsset { path: "web/ide_symbols.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ide_outline.js" {
        return StaticAsset { path: "web/ide_outline.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/ide_shell.js" {
        return StaticAsset { path: "web/ide_shell.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    # Serve the same browser workspace under the native Flow-owned loopback server.
    # Every asset is allowlisted; URL paths are never used as filesystem paths.
    if url == "/app" or url == "/app/" or url == "/app/index.html" {
        return StaticAsset { path: "docs/app/index.html", mime: "text/html; charset=utf-8", found: true }
    }
    if url == "/app/editor_find.js" {
        return StaticAsset { path: "docs/app/editor_find.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/app/find_panel.js" {
        return StaticAsset { path: "docs/app/find_panel.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/app/completion.js" {
        return StaticAsset { path: "docs/app/completion.js", mime: "text/javascript; charset=utf-8", found: true }
    }
    if url == "/app/console_repl.js" {
