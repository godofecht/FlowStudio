# Bounded variable-count constraint systems for three unknown physical dimensions.
# Find a full-rank triple in the actual parsed native equation IR, then validate
# EVERY original equation with native static dimensional inference.
# Only monomial equations can determine the unknown dimensions; additive and
# other supported typed equations may be consistency constraints.
import .math_dimensions { dimensionless }
import .math_static { MathDimensionBindings, MathDimensionSymbol, MathInferredType, infer_math_equation_source_with_dimensions }
import .math_dimension_triple { MathThreeDimensionSolution, solve_math_equations_three_unknown_dimensions }

export struct MathThreeConstraintSystem {
    count: i32,
    equations: array<string, 16>
}

export function empty_math_three_constraint_system() -> MathThreeConstraintSystem {
    return MathThreeConstraintSystem { count: 0, equations: [""] }
}

function constraint_failure(index: i32, position: i32) -> MathThreeDimensionSolution {
    return MathThreeDimensionSolution {
        valid: false, first: dimensionless(), second: dimensionless(),
        third: dimensionless(), failed_equation: index, failed_at: position
    }
}

# At most 16 equations, three unknowns, and five known symbols.
# O(n^3) independent-triple search, followed by O(n) static verification.
# No numerical equation solving, approximate rank decisions or silent skipping.
export function solve_math_equations_variable_constraints_three_unknown_dimensions(
    system: MathThreeConstraintSystem, known: MathDimensionBindings,
    first_unknown: string, second_unknown: string,
    third_unknown: string) -> MathThreeDimensionSolution {
    if system.count < 3 or system.count > 16 or
       known.count < 0 or known.count > 5 {
        return constraint_failure(-1, 0)
    }
    let mut first_index: i32 = 0
    while first_index < system.count - 2 {
        let mut second_index: i32 = first_index + 1
        while second_index < system.count - 1 {
            let mut third_index: i32 = second_index + 1
            while third_index < system.count {
                let candidate: MathThreeDimensionSolution =
                    solve_math_equations_three_unknown_dimensions(
                        system.equations[first_index],
                        system.equations[second_index],
                        system.equations[third_index],
                        known, first_unknown, second_unknown, third_unknown)
                if candidate.valid {
                    let mut declarations: MathDimensionBindings = known
                    declarations.symbols[known.count] = MathDimensionSymbol {
                        name: first_unknown, dimension: candidate.first
                    }
                    declarations.symbols[known.count + 1] = MathDimensionSymbol {
                        name: second_unknown, dimension: candidate.second
                    }
                    declarations.symbols[known.count + 2] = MathDimensionSymbol {
                        name: third_unknown, dimension: candidate.third
                    }
                    declarations.count = known.count + 3
                    let mut check_index: i32 = 0
                    while check_index < system.count {
                        let checked: MathInferredType =
                            infer_math_equation_source_with_dimensions(
                                system.equations[check_index], declarations)
                        if not checked.valid or checked.is_predicate {
                            return constraint_failure(check_index, checked.failed_at)
                        }
                        check_index = check_index + 1
                    }
                    return candidate
                }
                third_index = third_index + 1
            }
            second_index = second_index + 1
        }
        first_index = first_index + 1
    }
    return constraint_failure(-1, 0)
}
