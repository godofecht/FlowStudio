# Native compiler execution of actual mathematical source -> typed postfix IR.
# Run: flow run src/math_expression_source_smoke.flow
import .math_dimensions { Dimension, dimensionless, length_dimension, mass_dimension, time_dimension, temperature_dimension, quotient_dimension, product_dimension, same_dimension, quantity }
import .math_expression_ir { MathResult }
import .math_expression_source { ParsedMathExpression, MathSymbol, MathBindings, empty_math_bindings, parse_math_expression, parse_math_expression_with_bindings, evaluate_math_expression, evaluate_math_expression_with_bindings }

function near(a: f64, b: f64) -> bool {
    let mut error: f64 = a - b
    if error < 0.0 { error = -error }
    return error < 0.00000000001
}

function main() -> i32 {
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let speed: Dimension = quotient_dimension(length, time)
    let mut result: MathResult = evaluate_math_expression("3m / 2s + 4m/1s")
    if not result.valid or not near(result.result.value, 5.5) or
       not same_dimension(result.result.dimension, speed) { return 1 }

    result = evaluate_math_expression("2*(3+4)")
    if not result.valid or not near(result.result.value, 14.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 2 }

    result = evaluate_math_expression("-(2+3)*4")
    if not result.valid or not near(result.result.value, -20.0) { return 3 }
    result = evaluate_math_expression("2--3")
    if not result.valid or not near(result.result.value, 5.0) { return 4 }
    result = evaluate_math_expression("2×(3−1)÷2")
    if not result.valid or not near(result.result.value, 2.0) { return 5 }

    let momentum: Dimension = quotient_dimension(product_dimension(mass_dimension(), length), time)
    result = evaluate_math_expression("3kg * 2m / 6s")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, momentum) { return 6 }

    result = evaluate_math_expression("2K+3K")
    if not result.valid or not near(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, temperature_dimension()) { return 7 }

    result = evaluate_math_expression("3m + 2s")
    if result.valid or result.failed_at != 3 { return 8 }
    result = evaluate_math_expression("2m / 0s")
    if result.valid or result.failed_at != 3 { return 9 }
    result = evaluate_math_expression("3+")
    if result.valid or result.failed_at != 2 { return 10 }
    result = evaluate_math_expression("3(4)")
    if result.valid or result.failed_at != 1 { return 11 }
    result = evaluate_math_expression("(3+4")
    if result.valid or result.failed_at != 0 { return 12 }
    result = evaluate_math_expression("3+4)")
    if result.valid or result.failed_at != 3 { return 13 }
    result = evaluate_math_expression("3**2")
    if result.valid or result.failed_at != 2 { return 14 }
    result = evaluate_math_expression("3^2")
    if not result.valid or not near(result.result.value, 9.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 15 }
    result = evaluate_math_expression("foo")
    if result.valid or result.failed_at != 0 { return 16 }
    result = evaluate_math_expression("1e+")
    if result.valid or result.failed_at != 0 { return 17 }
    result = evaluate_math_expression("1m2")
    if result.valid or result.failed_at != 2 { return 18 }
    result = evaluate_math_expression("1e999")
    if result.valid or result.failed_at != 0 { return 19 }

    result = evaluate_math_expression("-(-3m)")
    if not result.valid or not near(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 20 }
    result = evaluate_math_expression("1/0")
    if result.valid or result.failed_at != 1 { return 21 }
    result = evaluate_math_expression("1e20 * 1e20")
    if result.valid or result.failed_at != 5 { return 22 }
    result = evaluate_math_expression("1e-12/2e-12")
    if not result.valid or not near(result.result.value, 0.5) { return 23 }
    result = evaluate_math_expression("3.5+0.5")
    if not result.valid or not near(result.result.value, 4.0) { return 24 }
    result = evaluate_math_expression("1 + (2 * 3) - 4")
    if not result.valid or not near(result.result.value, 3.0) { return 25 }

    let parsed: ParsedMathExpression = parse_math_expression("2m+3m")
    if not parsed.valid or parsed.program.count != 3 or
       parsed.program.instructions[0].source_start != 0 or
       parsed.program.instructions[1].source_start != 3 or
       parsed.program.instructions[2].source_start != 2 { return 26 }
    result = evaluate_math_expression("2m+3m")
    if not result.valid or not near(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, length) { return 27 }

    result = evaluate_math_expression("(-2m) / (-4s)")
    if not result.valid or not near(result.result.value, 0.5) or
       not same_dimension(result.result.dimension, speed) { return 28 }
    result = evaluate_math_expression("2m + 3kg")
    if result.valid or result.failed_at != 3 { return 29 }
    result = evaluate_math_expression("2 + 3 × 4")
    if not result.valid or not near(result.result.value, 14.0) { return 30 }
    result = evaluate_math_expression("2 + (3 × 4)")
    if not result.valid or not near(result.result.value, 14.0) { return 31 }
    result = evaluate_math_expression("2 + (3 × 4")
    if result.valid or result.failed_at != 4 { return 32 }
    let area: Dimension = product_dimension(length, length)
    result = evaluate_math_expression("2m²")
    if not result.valid or not near(result.result.value, 4.0) or
       not same_dimension(result.result.dimension, area) { return 33 }

    let unicode: ParsedMathExpression = parse_math_expression("2×3−1")
    if not unicode.valid or unicode.program.count != 5 or
       unicode.program.instructions[2].source_start != 1 or
       unicode.program.instructions[2].source_end != 3 or
       unicode.program.instructions[4].source_start != 4 or
       unicode.program.instructions[4].source_end != 7 { return 34 }
    result = evaluate_math_expression("2×3−1")
    if not result.valid or not near(result.result.value, 5.0) { return 35 }

    # Powers are executed by the same typed native postfix IR. The
    # exponent belongs to the preceding primary, not the pending unary sign.
    result = evaluate_math_expression("2m^2")
    if not result.valid or not near(result.result.value, 4.0) or
       not same_dimension(result.result.dimension, area) { return 36 }
    let inverse_area: Dimension = quotient_dimension(dimensionless(), area)
    result = evaluate_math_expression("2m^-2")
    if not result.valid or not near(result.result.value, 0.25) or
       not same_dimension(result.result.dimension, inverse_area) { return 37 }
    result = evaluate_math_expression("-2m^2")
    if not result.valid or not near(result.result.value, -4.0) or
       not same_dimension(result.result.dimension, area) { return 38 }
    result = evaluate_math_expression("(-2m)^2")
    if not result.valid or not near(result.result.value, 4.0) or
       not same_dimension(result.result.dimension, area) { return 39 }
    result = evaluate_math_expression("3²+4²")
    if not result.valid or not near(result.result.value, 25.0) { return 40 }
    result = evaluate_math_expression("2³")
    if not result.valid or not near(result.result.value, 8.0) { return 41 }
    result = evaluate_math_expression("2^3*4^2")
    if not result.valid or not near(result.result.value, 128.0) { return 42 }
    result = evaluate_math_expression("2^0+3^1")
    if not result.valid or not near(result.result.value, 4.0) { return 43 }
    result = evaluate_math_expression("2^-3")
    if not result.valid or not near(result.result.value, 0.125) { return 44 }
    result = evaluate_math_expression("2^+3")
    if not result.valid or not near(result.result.value, 8.0) { return 45 }

    # Invalid exponents fail at their source byte offset. No unbounded
    # integer parsing, implicit products, chained powers or zero inversion.
    result = evaluate_math_expression("0^-1")
    if result.valid or result.failed_at != 1 { return 46 }
    result = evaluate_math_expression("2^9")
    if result.valid or result.failed_at != 1 { return 47 }
    result = evaluate_math_expression("2^-9")
    if result.valid or result.failed_at != 1 { return 48 }
    result = evaluate_math_expression("2^")
    if result.valid or result.failed_at != 1 { return 49 }
    result = evaluate_math_expression("2^+")
    if result.valid or result.failed_at != 1 { return 50 }
    result = evaluate_math_expression("2^2^3")
    if result.valid or result.failed_at != 3 { return 51 }
    result = evaluate_math_expression("2²³")
    if result.valid or result.failed_at != 3 { return 52 }
    result = evaluate_math_expression("2^2.5")
    if result.valid or result.failed_at != 3 { return 53 }
    result = evaluate_math_expression("2m^2 + 3m")
    if result.valid or result.failed_at != 5 { return 54 }
    result = evaluate_math_expression("2^3m")
    if result.valid or result.failed_at != 3 { return 55 }

    result = evaluate_math_expression("2m² + 3m²")
    if not result.valid or not near(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, area) { return 56 }
    result = evaluate_math_expression("2m^-2 * 2m^2")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 57 }
    result = evaluate_math_expression("(-2m)^3")
    let volume: Dimension = product_dimension(area, length)
    if not result.valid or not near(result.result.value, -8.0) or
       not same_dimension(result.result.dimension, volume) { return 58 }
    result = evaluate_math_expression("1e20^2")
    if result.valid or result.failed_at != 4 { return 59 }
    result = evaluate_math_expression("2m³ / 4m²")
    if not result.valid or not near(result.result.value, 0.5) or
       not same_dimension(result.result.dimension, length) { return 60 }
    result = evaluate_math_expression("2m⁴")
    if result.valid or result.failed_at != 2 { return 61 }

    # Original UTF-8 byte spans survive both ASCII and superscript lowering.
    let powered: ParsedMathExpression = parse_math_expression("2m^-2")
    if not powered.valid or powered.program.count != 2 or
       powered.program.instructions[1].opcode != 6 or
       powered.program.instructions[1].exponent != -2 or
       powered.program.instructions[1].source_start != 2 or
       powered.program.instructions[1].source_end != 5 { return 62 }
    let superscript: ParsedMathExpression = parse_math_expression("3²")
    if not superscript.valid or superscript.program.count != 2 or
       superscript.program.instructions[1].opcode != 6 or
       superscript.program.instructions[1].exponent != 2 or
       superscript.program.instructions[1].source_start != 1 or
       superscript.program.instructions[1].source_end != 3 { return 63 }

    result = evaluate_math_expression("2m²+3s²")
    if result.valid or result.failed_at != 4 { return 64 }
    result = evaluate_math_expression("2^ 3")
    if result.valid or result.failed_at != 1 { return 65 }
    result = evaluate_math_expression("2³^2")
    if result.valid or result.failed_at != 3 { return 66 }
    result = evaluate_math_expression("2²*3²")
    if not result.valid or not near(result.result.value, 36.0) { return 67 }
    result = evaluate_math_expression("2^-2*4")
    if not result.valid or not near(result.result.value, 1.0) { return 68 }
    result = evaluate_math_expression("((2m²+3m²)/(5s²))*4s²")
    if not result.valid or not near(result.result.value, 8.32) or
       not same_dimension(result.result.dimension, area) { return 69 }
    result = evaluate_math_expression("2^00000000000000000000000009")
    if result.valid or result.failed_at != 1 { return 70 }

    # Native source functions use IR opcodes 20/21, preserving physical
    # units, source byte offsets and the primary/power precedence boundary.
    result = evaluate_math_expression("abs(-3m)")
    if not result.valid or not near(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 71 }
    result = evaluate_math_expression("sqrt(9m²)")
    if not result.valid or not near(result.result.value, 9.0) or
       not same_dimension(result.result.dimension, length) { return 72 }
    result = evaluate_math_expression("√9m²")
    if not result.valid or not near(result.result.value, 9.0) or
       not same_dimension(result.result.dimension, length) { return 73 }
    result = evaluate_math_expression("√(9m²)^2")
    if not result.valid or not near(result.result.value, 81.0) or
       not same_dimension(result.result.dimension, area) { return 74 }
    result = evaluate_math_expression("-sqrt(9m²)^2")
    if not result.valid or not near(result.result.value, -81.0) or
       not same_dimension(result.result.dimension, area) { return 75 }
    result = evaluate_math_expression("abs(-3m)+sqrt(16m²)")
    if not result.valid or not near(result.result.value, 19.0) or
       not same_dimension(result.result.dimension, length) { return 76 }
    result = evaluate_math_expression("abs(-3m)/sqrt(9s²)")
    if not result.valid or not near(result.result.value, 1.0 / 3.0) or
       not same_dimension(result.result.dimension, speed) { return 77 }
    result = evaluate_math_expression("abs(-2m)^-1")
    if not result.valid or not near(result.result.value, 0.5) or
       not same_dimension(result.result.dimension, quotient_dimension(dimensionless(), length)) { return 78 }
    result = evaluate_math_expression("sqrt(0)+abs(-2)^2")
    if not result.valid or not near(result.result.value, 4.0) { return 79 }
    result = evaluate_math_expression("√(4m²)+2m")
    if not result.valid or not near(result.result.value, 6.0) or
       not same_dimension(result.result.dimension, length) { return 80 }
    result = evaluate_math_expression("sqrt(1e20)")
    if not result.valid or not near(result.result.value, 10000000000.0) { return 81 }
    result = evaluate_math_expression("abs(-1e20)")
    if not result.valid or not near(result.result.value, 1e20) { return 82 }
    result = evaluate_math_expression("sqrt(-1)")
    if result.valid or result.failed_at != 0 { return 83 }
    result = evaluate_math_expression("√(-1)")
    if result.valid or result.failed_at != 0 { return 84 }
    result = evaluate_math_expression("sqrt(3m)")
    if result.valid or result.failed_at != 0 { return 85 }
    result = evaluate_math_expression("sqrt(9m^3)")
    if result.valid or result.failed_at != 0 { return 86 }
    result = evaluate_math_expression("abs(2m)+3s")
    if result.valid or result.failed_at != 7 { return 87 }
    result = evaluate_math_expression("abs()")
    if result.valid or result.failed_at != 4 { return 88 }
    result = evaluate_math_expression("sqrt()")
    if result.valid or result.failed_at != 5 { return 89 }
    result = evaluate_math_expression("abs  (3)")
    if result.valid or result.failed_at != 0 { return 90 }
    result = evaluate_math_expression("sqrt  (4)")
    if result.valid or result.failed_at != 0 { return 91 }
    result = evaluate_math_expression("abs(-3m")
    if result.valid or result.failed_at != 3 { return 92 }
    result = evaluate_math_expression("√")
    if result.valid or result.failed_at != 3 { return 93 }
    let root: ParsedMathExpression = parse_math_expression("√(9m²)^2")
    if not root.valid or root.program.count != 4 or
       root.program.instructions[2].opcode != 21 or
       root.program.instructions[2].source_start != 0 or
       root.program.instructions[2].source_end != 3 or
       root.program.instructions[3].opcode != 6 or
       root.program.instructions[3].source_start != 9 { return 94 }
    let absolute: ParsedMathExpression = parse_math_expression("abs(-3m)")
    if not absolute.valid or absolute.program.count != 3 or
       absolute.program.instructions[2].opcode != 20 or
       absolute.program.instructions[2].source_start != 0 or
       absolute.program.instructions[2].source_end != 3 { return 95 }

    result = evaluate_math_expression("√9m²+2m")
    if not result.valid or not near(result.result.value, 11.0) or
       not same_dimension(result.result.dimension, length) { return 96 }
    result = evaluate_math_expression("√9m²*2")
    if not result.valid or not near(result.result.value, 18.0) or
       not same_dimension(result.result.dimension, length) { return 97 }
    result = evaluate_math_expression("√9m²/3")
    if not result.valid or not near(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 98 }

    # Explicit typed identifiers are lowered to the SAME bounded native IR
    # as literals. Names have strict ASCII syntax and unique definitions.
    let blank_symbol: MathSymbol = MathSymbol {
        name: "", value: quantity(0.0, dimensionless())
    }
    let mut symbols: array<MathSymbol, 8> = [blank_symbol]
    symbols[0] = MathSymbol { name: "distance", value: quantity(12.0, length) }
    symbols[1] = MathSymbol { name: "duration", value: quantity(3.0, time) }
    symbols[2] = MathSymbol { name: "speed", value: quantity(1.0, speed) }
    symbols[3] = MathSymbol { name: "zero", value: quantity(0.0, time) }
    symbols[4] = MathSymbol { name: "mass", value: quantity(2.0, mass_dimension()) }
    let bindings: MathBindings = MathBindings { symbols: symbols, count: 5 }

    result = evaluate_math_expression_with_bindings("distance/duration+speed", bindings)
    if not result.valid or not near(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, speed) { return 99 }
    result = evaluate_math_expression_with_bindings("sqrt(distance²)+distance", bindings)
    if not result.valid or not near(result.result.value, 24.0) or
       not same_dimension(result.result.dimension, length) { return 100 }
    result = evaluate_math_expression_with_bindings("√distance²", bindings)
    if not result.valid or not near(result.result.value, 12.0) or
       not same_dimension(result.result.dimension, length) { return 101 }
    result = evaluate_math_expression_with_bindings("distance^3/distance^2", bindings)
    if not result.valid or not near(result.result.value, 12.0) or
       not same_dimension(result.result.dimension, length) { return 102 }
    result = evaluate_math_expression_with_bindings("mass*distance/duration²", bindings)
    let force: Dimension = quotient_dimension(
        product_dimension(mass_dimension(), length), product_dimension(time, time))
    if not result.valid or not near(result.result.value, 24.0 / 9.0) or
       not same_dimension(result.result.dimension, force) { return 103 }
    result = evaluate_math_expression_with_bindings("abs(-distance)+distance", bindings)
    if not result.valid or not near(result.result.value, 24.0) or
       not same_dimension(result.result.dimension, length) { return 104 }
    result = evaluate_math_expression_with_bindings("(distance/duration+speed)^2", bindings)
    if not result.valid or not near(result.result.value, 25.0) or
       not same_dimension(result.result.dimension, product_dimension(speed, speed)) { return 105 }
    result = evaluate_math_expression_with_bindings("distance^-1*distance", bindings)
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 106 }
    result = evaluate_math_expression_with_bindings("distance²", bindings)
    if not result.valid or not near(result.result.value, 144.0) or
       not same_dimension(result.result.dimension, area) { return 107 }
    result = evaluate_math_expression_with_bindings("distance^0", bindings)
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 108 }
    result = evaluate_math_expression_with_bindings("distance+distance", bindings)
    if not result.valid or not near(result.result.value, 24.0) { return 109 }

    let bound_source: ParsedMathExpression =
        parse_math_expression_with_bindings("distance/duration", bindings)
    if not bound_source.valid or bound_source.program.count != 3 or
       bound_source.program.instructions[0].source_start != 0 or
       bound_source.program.instructions[0].source_end != 8 or
       bound_source.program.instructions[1].source_start != 9 or
       bound_source.program.instructions[1].source_end != 17 or
       bound_source.program.instructions[2].source_start != 8 or
       bound_source.program.instructions[2].source_end != 9 { return 110 }
    let unicode_bound: ParsedMathExpression =
        parse_math_expression_with_bindings("√distance²", bindings)
    if not unicode_bound.valid or unicode_bound.program.count != 3 or
       unicode_bound.program.instructions[0].source_start != 3 or
       unicode_bound.program.instructions[0].source_end != 11 or
       unicode_bound.program.instructions[1].source_start != 11 or
       unicode_bound.program.instructions[1].source_end != 13 or
       unicode_bound.program.instructions[2].opcode != 21 or
       unicode_bound.program.instructions[2].source_start != 0 or
       unicode_bound.program.instructions[2].source_end != 3 { return 111 }

    result = evaluate_math_expression_with_bindings("distance+duration", bindings)
    if result.valid or result.failed_at != 8 { return 112 }
    result = evaluate_math_expression_with_bindings("distance/zero", bindings)
    if result.valid or result.failed_at != 8 { return 113 }
    result = evaluate_math_expression_with_bindings("distance+missing", bindings)
    if result.valid or result.failed_at != 9 { return 114 }
    result = evaluate_math_expression_with_bindings("2distance", bindings)
    if result.valid or result.failed_at != 1 { return 115 }
    result = evaluate_math_expression_with_bindings("distance duration", bindings)
    if result.valid or result.failed_at != 9 { return 116 }
    result = evaluate_math_expression_with_bindings("distance^9", bindings)
    if result.valid or result.failed_at != 8 { return 117 }
    result = evaluate_math_expression_with_bindings("distance+π", bindings)
    if result.valid or result.failed_at != 9 { return 118 }
    result = evaluate_math_expression_with_bindings("distance+1e999", bindings)
    if result.valid or result.failed_at != 9 { return 119 }
    result = evaluate_math_expression_with_bindings("distance*1e30", bindings)
    if result.valid or result.failed_at != 8 { return 120 }
    result = evaluate_math_expression_with_bindings("sqrt(-distance)", bindings)
    if result.valid or result.failed_at != 0 { return 121 }
    result = evaluate_math_expression_with_bindings("speed+distance", bindings)
    if result.valid or result.failed_at != 5 { return 122 }
    result = evaluate_math_expression_with_bindings("unknown", bindings)
    if result.valid or result.failed_at != 0 { return 123 }
    result = evaluate_math_expression_with_bindings("distance^8*distance^8*distance^8*distance^8", bindings)
    if result.valid { return 124 }

    let mut invalid_symbols: array<MathSymbol, 8> = symbols
    invalid_symbols[5] = MathSymbol { name: "distance", value: quantity(3.0, length) }
    let invalid_duplicates: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("distance", invalid_duplicates)
    if result.valid or result.failed_at != 0 { return 125 }
    invalid_symbols[5] = MathSymbol { name: "2invalid", value: quantity(3.0, length) }
    let invalid_name: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("distance", invalid_name)
    if result.valid or result.failed_at != 0 { return 126 }
    invalid_symbols[5] = MathSymbol {
        name: "this_identifier_is_over_thirty_two_characters",
        value: quantity(3.0, length)
    }
    let invalid_length: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("distance", invalid_length)
    if result.valid or result.failed_at != 0 { return 127 }
    let invalid_count: MathBindings = MathBindings { symbols: symbols, count: 9 }
    result = evaluate_math_expression_with_bindings("distance", invalid_count)
    if result.valid or result.failed_at != 0 { return 128 }
    let negative_count: MathBindings = MathBindings { symbols: symbols, count: -1 }
    result = evaluate_math_expression_with_bindings("distance", negative_count)
    if result.valid or result.failed_at != 0 { return 129 }
    result = evaluate_math_expression_with_bindings("distance", empty_math_bindings())
    if result.valid or result.failed_at != 0 { return 130 }
    result = evaluate_math_expression("distance")
    if result.valid or result.failed_at != 0 { return 131 }
    invalid_symbols[5] = MathSymbol { name: "overflow", value: quantity(1e31, length) }
    let overflow_binding: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("overflow", overflow_binding)
    if result.valid or result.failed_at != 0 { return 132 }


    # Comparisons compile from source to the existing typed predicate IR,
    # including dimensional rejection and UTF-8 source byte diagnostics.
    result = evaluate_math_expression("3m<4m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 133 }
    result = evaluate_math_expression("4m<=4m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 134 }
    result = evaluate_math_expression("4m>3m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 135 }
    result = evaluate_math_expression("4m>=4m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 136 }
    result = evaluate_math_expression("4m==4m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 137 }
    result = evaluate_math_expression("4m!=4m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 138 }
    result = evaluate_math_expression("2m≤3m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 139 }
    result = evaluate_math_expression("2m≥3m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 140 }
    result = evaluate_math_expression("2m≠3m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 141 }
    result = evaluate_math_expression("2m+3m<=6m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 142 }
    result = evaluate_math_expression("1+2<2*2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 143 }
    result = evaluate_math_expression("(2m<3m)")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 144 }
    result = evaluate_math_expression_with_bindings("distance/duration>speed", bindings)
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 145 }
    result = evaluate_math_expression_with_bindings("distance==distance", bindings)
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 146 }

    let comparison: ParsedMathExpression = parse_math_expression("2m≠3m")
    if not comparison.valid or comparison.program.count != 3 or
       comparison.program.instructions[2].opcode != 15 or
       comparison.program.instructions[2].source_start != 2 or
       comparison.program.instructions[2].source_end != 5 { return 147 }
    let less_equal: ParsedMathExpression = parse_math_expression("2m<=3m")
    if not less_equal.valid or less_equal.program.count != 3 or
       less_equal.program.instructions[2].opcode != 11 or
       less_equal.program.instructions[2].source_start != 2 or
       less_equal.program.instructions[2].source_end != 4 { return 148 }

    result = evaluate_math_expression("2m<3s")
    if result.valid or result.failed_at != 2 { return 149 }
    result = evaluate_math_expression("2m==3s")
    if result.valid or result.failed_at != 2 { return 150 }
    result = evaluate_math_expression("1<2<3")
    if result.valid or result.failed_at != 3 { return 151 }
    result = evaluate_math_expression("1<2+3m")
    if result.valid or result.failed_at != 3 { return 152 }
    result = evaluate_math_expression("1=1")
    if result.valid or result.failed_at != 1 { return 153 }
    result = evaluate_math_expression("1!1")
    if result.valid or result.failed_at != 1 { return 154 }
    result = evaluate_math_expression("1<=")
    if result.valid or result.failed_at != 3 { return 155 }
    result = evaluate_math_expression("<=2")
    if result.valid or result.failed_at != 0 { return 156 }
    result = evaluate_math_expression("1<>2")
    if result.valid or result.failed_at != 2 { return 157 }
    result = evaluate_math_expression("1<2+")
    if result.valid or result.failed_at != 4 { return 158 }
    result = evaluate_math_expression("1==1+1")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 159 }
    result = evaluate_math_expression("2m≠2m")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 160 }


    # Native logical source operators retain predicate types and are eager.
    # Precedence: arithmetic > comparison > not > and > or.
    result = evaluate_math_expression("1<2 and 2<3")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 161 }
    result = evaluate_math_expression("1<2 and 3<2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 162 }
    result = evaluate_math_expression("1<2 or 3<2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 163 }
    result = evaluate_math_expression("1>2 or 3>4")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 164 }
    result = evaluate_math_expression("not 1<2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 165 }
    result = evaluate_math_expression("not 2<1")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 166 }
    result = evaluate_math_expression("not not 1<2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 167 }
    result = evaluate_math_expression("1<2 or 3<2 and 4<5")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 168 }
    result = evaluate_math_expression("1>2 or 3<2 and 4<5")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 169 }
    result = evaluate_math_expression("(1<2 or 3<2) and 4<5")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 170 }
    result = evaluate_math_expression("not (1<2 and 2<3)")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 171 }
    result = evaluate_math_expression("1<2 and not 3<2")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 172 }
    result = evaluate_math_expression("not 1<2 or 3<4")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 173 }
    result = evaluate_math_expression_with_bindings(
        "distance/duration>speed and distance>3m", bindings)
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 174 }
    result = evaluate_math_expression_with_bindings("not (distance<3m)", bindings)
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 175 }
    result = evaluate_math_expression("1<2 and 2<3 and 3<4")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 176 }
    result = evaluate_math_expression("1<2 or 2<3 and 3<4")
    if not result.valid or not result.is_predicate or not near(result.result.value, 1.0) { return 177 }
    result = evaluate_math_expression("not 1<2 and not 3<4")
    if not result.valid or not result.is_predicate or not near(result.result.value, 0.0) { return 178 }

    let logical: ParsedMathExpression = parse_math_expression("1<2 and 3<4")
    if not logical.valid or logical.program.count != 7 or
       logical.program.instructions[6].opcode != 16 or
       logical.program.instructions[6].source_start != 4 or
       logical.program.instructions[6].source_end != 7 { return 179 }
    let negated: ParsedMathExpression = parse_math_expression("not (1<2)")
    if not negated.valid or negated.program.count != 4 or
       negated.program.instructions[3].opcode != 18 or
       negated.program.instructions[3].source_start != 0 or
       negated.program.instructions[3].source_end != 3 { return 180 }
    let disjunction: ParsedMathExpression = parse_math_expression("1<2 or 3<4")
    if not disjunction.valid or disjunction.program.count != 7 or
       disjunction.program.instructions[6].opcode != 17 or
       disjunction.program.instructions[6].source_start != 4 or
       disjunction.program.instructions[6].source_end != 6 { return 181 }

    result = evaluate_math_expression("not 1")
    if result.valid or result.failed_at != 0 { return 182 }
    result = evaluate_math_expression("1 and 2")
    if result.valid or result.failed_at != 2 { return 183 }
    result = evaluate_math_expression("1<2 and 2")
    if result.valid or result.failed_at != 4 { return 184 }
    result = evaluate_math_expression("1<2 or 3")
    if result.valid or result.failed_at != 4 { return 185 }
    result = evaluate_math_expression("1<2 and")
    if result.valid or result.failed_at != 7 { return 186 }
    result = evaluate_math_expression("and 1<2")
    if result.valid or result.failed_at != 0 { return 187 }
    result = evaluate_math_expression("1<2 not 3<4")
    if result.valid or result.failed_at != 4 { return 188 }
    result = evaluate_math_expression("not")
    if result.valid or result.failed_at != 3 { return 189 }
    result = evaluate_math_expression("1<2 xor 2<3")
    if result.valid or result.failed_at != 4 { return 190 }
    result = evaluate_math_expression("1<2 and (2<3")
    if result.valid or result.failed_at != 8 { return 191 }
    result = evaluate_math_expression("1<2 and 2m<3s")
    if result.valid or result.failed_at != 10 { return 192 }
    result = evaluate_math_expression("1<2 and 1/0>0")
    if result.valid or result.failed_at != 9 { return 193 }
    result = evaluate_math_expression("1<2 or 1/0>0")
    if result.valid or result.failed_at != 8 { return 194 }

    invalid_symbols[5] = MathSymbol { name: "and", value: quantity(1.0, dimensionless()) }
    let invalid_keyword: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("distance", invalid_keyword)
    if result.valid or result.failed_at != 0 { return 195 }
    invalid_symbols[5] = MathSymbol { name: "not", value: quantity(1.0, dimensionless()) }
    let invalid_not: MathBindings = MathBindings { symbols: invalid_symbols, count: 6 }
    result = evaluate_math_expression_with_bindings("distance", invalid_not)
    if result.valid or result.failed_at != 0 { return 196 }

    println("native-math-source-ok")
    return 0
}
