# Twelve-state nonlinear reaction-diffusion SIR model on a periodic four-cell ring.
# Actual upstream Flow 2.0 compiler-generated RK4; no Python runtime fallback.
# The numerical reference is an independent 32768-step Python integration,
# cross-checked against 65536 steps to < 1e-13.
# Run: flow run examples/native_spatial_sir4.flow
flow SpatialSIR4 {
    state susceptibleNorth: f64 = 0.96
    state infectedNorth: f64 = 0.04
    state recoveredNorth: f64 = 0.00
    state susceptibleEast: f64 = 0.91
    state infectedEast: f64 = 0.07
    state recoveredEast: f64 = 0.02
    state susceptibleSouth: f64 = 0.85
    state infectedSouth: f64 = 0.10
    state recoveredSouth: f64 = 0.05
    state susceptibleWest: f64 = 0.98
    state infectedWest: f64 = 0.01
    state recoveredWest: f64 = 0.01
    param infectionRate: f64 = 1.3
    param recoveryRate: f64 = 0.4
    param diffusionSusceptible: f64 = 0.15
    param diffusionInfected: f64 = 0.09
    param diffusionRecovered: f64 = 0.06
    solver { dt 1 ms method rk4 }

    susceptibleNorth evolves as -infectionRate * susceptibleNorth * infectedNorth + diffusionSusceptible * (susceptibleWest + susceptibleEast - 2.0 * susceptibleNorth)
    infectedNorth evolves as infectionRate * susceptibleNorth * infectedNorth - recoveryRate * infectedNorth + diffusionInfected * (infectedWest + infectedEast - 2.0 * infectedNorth)
    recoveredNorth evolves as recoveryRate * infectedNorth + diffusionRecovered * (recoveredWest + recoveredEast - 2.0 * recoveredNorth)
    susceptibleEast evolves as -infectionRate * susceptibleEast * infectedEast + diffusionSusceptible * (susceptibleNorth + susceptibleSouth - 2.0 * susceptibleEast)
    infectedEast evolves as infectionRate * susceptibleEast * infectedEast - recoveryRate * infectedEast + diffusionInfected * (infectedNorth + infectedSouth - 2.0 * infectedEast)
    recoveredEast evolves as recoveryRate * infectedEast + diffusionRecovered * (recoveredNorth + recoveredSouth - 2.0 * recoveredEast)
    susceptibleSouth evolves as -infectionRate * susceptibleSouth * infectedSouth + diffusionSusceptible * (susceptibleEast + susceptibleWest - 2.0 * susceptibleSouth)
    infectedSouth evolves as infectionRate * susceptibleSouth * infectedSouth - recoveryRate * infectedSouth + diffusionInfected * (infectedEast + infectedWest - 2.0 * infectedSouth)
    recoveredSouth evolves as recoveryRate * infectedSouth + diffusionRecovered * (recoveredEast + recoveredWest - 2.0 * recoveredSouth)
    susceptibleWest evolves as -infectionRate * susceptibleWest * infectedWest + diffusionSusceptible * (susceptibleSouth + susceptibleNorth - 2.0 * susceptibleWest)
    infectedWest evolves as infectionRate * susceptibleWest * infectedWest - recoveryRate * infectedWest + diffusionInfected * (infectedSouth + infectedNorth - 2.0 * infectedWest)
    recoveredWest evolves as recoveryRate * infectedWest + diffusionRecovered * (recoveredSouth + recoveredNorth - 2.0 * recoveredWest)
}

struct SpatialSIR4Run {
    valid: bool,
    state: SpatialSIR4
}

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

function maximum(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

function difference(a: SpatialSIR4, b: SpatialSIR4) -> f64 {
    let mut error: f64 = absolute(a.susceptibleNorth - b.susceptibleNorth)
    error = maximum(error, absolute(a.infectedNorth - b.infectedNorth))
    error = maximum(error, absolute(a.recoveredNorth - b.recoveredNorth))
    error = maximum(error, absolute(a.susceptibleEast - b.susceptibleEast))
    error = maximum(error, absolute(a.infectedEast - b.infectedEast))
    error = maximum(error, absolute(a.recoveredEast - b.recoveredEast))
    error = maximum(error, absolute(a.susceptibleSouth - b.susceptibleSouth))
    error = maximum(error, absolute(a.infectedSouth - b.infectedSouth))
    error = maximum(error, absolute(a.recoveredSouth - b.recoveredSouth))
    error = maximum(error, absolute(a.susceptibleWest - b.susceptibleWest))
    error = maximum(error, absolute(a.infectedWest - b.infectedWest))
    error = maximum(error, absolute(a.recoveredWest - b.recoveredWest))
    return error
}

function total(state: SpatialSIR4) -> f64 {
    return state.susceptibleNorth +
         state.infectedNorth +
         state.recoveredNorth +
         state.susceptibleEast +
         state.infectedEast +
         state.recoveredEast +
         state.susceptibleSouth +
         state.infectedSouth +
         state.recoveredSouth +
         state.susceptibleWest +
         state.infectedWest +
         state.recoveredWest
}

function validRun(initial: SpatialSIR4, duration: f64, steps: i32) -> bool {
    if steps <= 0 or steps > 8192 { return false }
    if not (duration >= 0.0 and duration <= 10.0) { return false }
    if not (initial.infectionRate >= 0.0 and initial.infectionRate <= 10.0) { return false }
    if not (initial.recoveryRate >= 0.0 and initial.recoveryRate <= 10.0) { return false }
    if not (initial.diffusionSusceptible >= 0.0 and initial.diffusionSusceptible <= 10.0) { return false }
    if not (initial.diffusionInfected >= 0.0 and initial.diffusionInfected <= 10.0) { return false }
    if not (initial.diffusionRecovered >= 0.0 and initial.diffusionRecovered <= 10.0) { return false }
    if not (initial.susceptibleNorth >= 0.0 and initial.susceptibleNorth <= 2.0) { return false }
    if not (initial.infectedNorth >= 0.0 and initial.infectedNorth <= 2.0) { return false }
    if not (initial.recoveredNorth >= 0.0 and initial.recoveredNorth <= 2.0) { return false }
    if not (initial.susceptibleEast >= 0.0 and initial.susceptibleEast <= 2.0) { return false }
    if not (initial.infectedEast >= 0.0 and initial.infectedEast <= 2.0) { return false }
    if not (initial.recoveredEast >= 0.0 and initial.recoveredEast <= 2.0) { return false }
    if not (initial.susceptibleSouth >= 0.0 and initial.susceptibleSouth <= 2.0) { return false }
    if not (initial.infectedSouth >= 0.0 and initial.infectedSouth <= 2.0) { return false }
    if not (initial.recoveredSouth >= 0.0 and initial.recoveredSouth <= 2.0) { return false }
    if not (initial.susceptibleWest >= 0.0 and initial.susceptibleWest <= 2.0) { return false }
    if not (initial.infectedWest >= 0.0 and initial.infectedWest <= 2.0) { return false }
    if not (initial.recoveredWest >= 0.0 and initial.recoveredWest <= 2.0) { return false }
    if absolute(total(initial) - 4.0) > 0.0000000001 { return false }
    let rateBound: f64 = initial.infectionRate + initial.recoveryRate +
        2.0 * (initial.diffusionSusceptible + initial.diffusionInfected + initial.diffusionRecovered)
    if duration * rateBound / (steps as f64) > 1.0 { return false }
    return true
}

function runFrom(initial: SpatialSIR4, duration: f64, steps: i32) -> SpatialSIR4Run {
    if not validRun(initial, duration, steps) {
        return SpatialSIR4Run { valid: false, state: initial }
    }
    let mut state: SpatialSIR4 = initial
    let dt: f64 = duration / (steps as f64)
    for index in 0 to steps {
        SpatialSIR4_step(&state, dt)
    }
    return SpatialSIR4Run { valid: true, state: state }
}

function integrate(duration: f64, steps: i32) -> SpatialSIR4Run {
    return runFrom(SpatialSIR4_new(), duration, steps)
}

function independentReference() -> SpatialSIR4 {
    let mut expected: SpatialSIR4 = SpatialSIR4_new()
    expected.susceptibleNorth = 0.8512131670893781
    expected.infectedNorth = 0.10761895312753027
    expected.recoveredNorth = 0.036936354005300966
    expected.susceptibleEast = 0.7595416951105664
    expected.infectedEast = 0.1649662674466057
    expected.recoveredEast = 0.07701117570155275
    expected.susceptibleSouth = 0.708726989315325
    expected.infectedSouth = 0.19369292435313012
    expected.recoveredSouth = 0.11481430705314233
    expected.susceptibleWest = 0.898972072511941
    expected.infectedWest = 0.05733620947118931
    expected.recoveredWest = 0.029169884814343995
    return expected
}

function rotated(original: SpatialSIR4) -> SpatialSIR4 {
    let mut state: SpatialSIR4 = original
    state.susceptibleNorth = original.susceptibleWest
    state.infectedNorth = original.infectedWest
    state.recoveredNorth = original.recoveredWest
    state.susceptibleEast = original.susceptibleNorth
    state.infectedEast = original.infectedNorth
    state.recoveredEast = original.recoveredNorth
    state.susceptibleSouth = original.susceptibleEast
    state.infectedSouth = original.infectedEast
    state.recoveredSouth = original.recoveredEast
    state.susceptibleWest = original.susceptibleSouth
    state.infectedWest = original.infectedSouth
    state.recoveredWest = original.recoveredSouth
    return state
}

function main() -> i32 {
    let reference: SpatialSIR4 = independentReference()
    let coarse: SpatialSIR4Run = integrate(1.25, 4)
    let medium: SpatialSIR4Run = integrate(1.25, 8)
    let fine: SpatialSIR4Run = integrate(1.25, 16)
    let finer: SpatialSIR4Run = integrate(1.25, 32)
    let finest: SpatialSIR4Run = integrate(1.25, 64)
    if not coarse.valid or not medium.valid or not fine.valid or not finer.valid or not finest.valid { return 1 }
    let error4: f64 = difference(coarse.state, reference)
    let error8: f64 = difference(medium.state, reference)
    let error16: f64 = difference(fine.state, reference)
    let error32: f64 = difference(finer.state, reference)
    let error64: f64 = difference(finest.state, reference)
    if error4 < 0.000001 { return 2 }
    if error8 >= 0.11 * error4 { return 3 }
    if error16 >= 0.11 * error8 { return 4 }
    if error32 >= 0.11 * error16 { return 5 }
    if error64 >= 0.11 * error32 or error64 > 0.000000001 { return 6 }
    if absolute(total(finest.state) - 4.0) > 0.00000000001 { return 7 }
    if finest.state.susceptibleNorth < 0.0 or finest.state.susceptibleNorth > 1.0 { return 8 }
    if finest.state.infectedNorth < 0.0 or finest.state.infectedNorth > 1.0 { return 9 }
    if finest.state.recoveredNorth < 0.0 or finest.state.recoveredNorth > 1.0 { return 10 }
    if finest.state.susceptibleEast < 0.0 or finest.state.susceptibleEast > 1.0 { return 11 }
    if finest.state.infectedEast < 0.0 or finest.state.infectedEast > 1.0 { return 12 }
    if finest.state.recoveredEast < 0.0 or finest.state.recoveredEast > 1.0 { return 13 }
    if finest.state.susceptibleSouth < 0.0 or finest.state.susceptibleSouth > 1.0 { return 14 }
    if finest.state.infectedSouth < 0.0 or finest.state.infectedSouth > 1.0 { return 15 }
    if finest.state.recoveredSouth < 0.0 or finest.state.recoveredSouth > 1.0 { return 16 }
    if finest.state.susceptibleWest < 0.0 or finest.state.susceptibleWest > 1.0 { return 17 }
    if finest.state.infectedWest < 0.0 or finest.state.infectedWest > 1.0 { return 18 }
    if finest.state.recoveredWest < 0.0 or finest.state.recoveredWest > 1.0 { return 19 }
    let replay: SpatialSIR4Run = integrate(1.25, 64)
    if not replay.valid or difference(replay.state, finest.state) > 0.000000000001 { return 20 }
    let half: SpatialSIR4Run = integrate(0.625, 32)
    if not half.valid { return 21 }
    let second: SpatialSIR4Run = runFrom(half.state, 0.625, 32)
    if not second.valid or difference(second.state, finest.state) > 0.000000000001 { return 22 }
    let rotatedRun: SpatialSIR4Run = runFrom(rotated(SpatialSIR4_new()), 1.25, 64)
    if not rotatedRun.valid or difference(rotatedRun.state, rotated(finest.state)) > 0.000000000001 { return 23 }
    let mut scaledInitial: SpatialSIR4 = SpatialSIR4_new()
    scaledInitial.infectionRate = 0.65
    scaledInitial.recoveryRate = 0.2
    scaledInitial.diffusionSusceptible = 0.075
    scaledInitial.diffusionInfected = 0.045
    scaledInitial.diffusionRecovered = 0.03
    let scaled: SpatialSIR4Run = runFrom(scaledInitial, 2.5, 64)
    if not scaled.valid or difference(scaled.state, finest.state) > 0.000000000001 { return 24 }
    let mut logisticInitial: SpatialSIR4 = SpatialSIR4_new()
    logisticInitial.recoveryRate = 0.0
    logisticInitial.diffusionSusceptible = 0.0
    logisticInitial.diffusionInfected = 0.0
    logisticInitial.diffusionRecovered = 0.0
    let logistic: SpatialSIR4Run = runFrom(logisticInitial, 1.25, 128)
    if not logistic.valid { return 25 }
    if absolute(logistic.state.infectedNorth - 0.17464563773865227) > 0.00000001 { return 26 }
    if absolute(logistic.state.infectedEast - 0.2689047113538264) > 0.00000001 { return 27 }
    if absolute(logistic.state.infectedSouth - 0.337427601574613) > 0.00000001 { return 28 }
    if absolute(logistic.state.infectedWest - 0.04802680717276211) > 0.00000001 { return 29 }
    let mut frozenInitial: SpatialSIR4 = SpatialSIR4_new()
    frozenInitial.infectionRate = 0.0
    frozenInitial.recoveryRate = 0.0
    frozenInitial.diffusionSusceptible = 0.0
    frozenInitial.diffusionInfected = 0.0
    frozenInitial.diffusionRecovered = 0.0
    let frozen: SpatialSIR4Run = runFrom(frozenInitial, 1.25, 4)
    if not frozen.valid or difference(frozen.state, frozenInitial) > 0.000000000001 { return 30 }
    let zero: SpatialSIR4Run = integrate(0.0, 4)
    if not zero.valid or difference(zero.state, SpatialSIR4_new()) > 0.000000000001 { return 31 }
    if integrate(-0.1, 64).valid { return 32 }
    if integrate(10.1, 64).valid { return 33 }
    if integrate(1.25, 0).valid { return 34 }
    if integrate(1.25, 8193).valid { return 35 }
    if integrate(1.25, 1).valid { return 36 }
    let mut invalid: SpatialSIR4 = SpatialSIR4_new()
    invalid.infectionRate = -0.1
    if runFrom(invalid, 1.25, 64).valid { return 37 }
    invalid = SpatialSIR4_new()
    invalid.diffusionInfected = -0.1
    if runFrom(invalid, 1.25, 64).valid { return 38 }
    invalid = SpatialSIR4_new()
    invalid.recoveryRate = 10.1
    if runFrom(invalid, 1.25, 64).valid { return 39 }
    invalid = SpatialSIR4_new()
    invalid.infectedSouth = -0.01
    if runFrom(invalid, 1.25, 64).valid { return 40 }
    invalid = SpatialSIR4_new()
    invalid.susceptibleNorth = 1.1
    if runFrom(invalid, 1.25, 64).valid { return 41 }
    println("native-spatial-sir4-ok")
    return 0
}
