# Actual Flow 2.0 evolution declaration: anisotropic 2D periodic heat.
# Four states are a 2x2 grid, not a hand-written integrator.
# Each periodic axis has the same neighbor on both sides, giving factor 2.
# The compiler generates AnisotropicHeat2D_step using RK4.
# Exact semidiscrete Fourier eigenvalues: -4*Dx/dx^2, -4*Dy/dy^2,
# and their sum. No Python or NumPy is used to execute this program.

flow AnisotropicHeat2D {
    state northwest : f64 = 3.6
    state northeast : f64 = 1.6
    state southwest : f64 = 4.0
    state southeast : f64 = 2.8

    param diffusivity_x : f64 = 0.02
    param diffusivity_y : f64 = 0.04
    param spacing_x : f64 = 0.5
    param spacing_y : f64 = 0.5

    solver { dt 1 ms method rk4 }

    northwest evolves as 2.0 * diffusivity_x * (northeast - northwest) / (spacing_x * spacing_x) + 2.0 * diffusivity_y * (southwest - northwest) / (spacing_y * spacing_y)
    northeast evolves as 2.0 * diffusivity_x * (northwest - northeast) / (spacing_x * spacing_x) + 2.0 * diffusivity_y * (southeast - northeast) / (spacing_y * spacing_y)
    southwest evolves as 2.0 * diffusivity_x * (southeast - southwest) / (spacing_x * spacing_x) + 2.0 * diffusivity_y * (northwest - southwest) / (spacing_y * spacing_y)
    southeast evolves as 2.0 * diffusivity_x * (southwest - southeast) / (spacing_x * spacing_x) + 2.0 * diffusivity_y * (northeast - southeast) / (spacing_y * spacing_y)
}

struct HeatRun2D {
    valid: bool,
    state: AnisotropicHeat2D
}

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

function maximum(first: f64, second: f64) -> f64 {
    if first > second { return first }
    return second
}

function maxDifference(first: AnisotropicHeat2D, second: AnisotropicHeat2D) -> f64 {
    let mut error: f64 = absolute(first.northwest - second.northwest)
    error = maximum(error, absolute(first.northeast - second.northeast))
    error = maximum(error, absolute(first.southwest - second.southwest))
    return maximum(error, absolute(first.southeast - second.southeast))
}

function meanTemperature(state: AnisotropicHeat2D) -> f64 {
    return (state.northwest + state.northeast + state.southwest + state.southeast) * 0.25
}

function validRun(state: AnisotropicHeat2D, duration: f64, steps: i32) -> bool {
    if steps <= 0 or steps > 100000 { return false }
    if not (duration >= 0.0 and duration <= 100.0) { return false }
    if not (state.spacing_x > 0.0 and state.spacing_x <= 100.0) { return false }
    if not (state.spacing_y > 0.0 and state.spacing_y <= 100.0) { return false }
    if not (state.diffusivity_x >= 0.0 and state.diffusivity_x <= 100.0) { return false }
    if not (state.diffusivity_y >= 0.0 and state.diffusivity_y <= 100.0) { return false }
    let maximum_rate: f64 = 4.0 * (
        state.diffusivity_x / (state.spacing_x * state.spacing_x) +
        state.diffusivity_y / (state.spacing_y * state.spacing_y))
    return duration * maximum_rate / (steps as f64) <= 1.0
}

function runFrom(initial: AnisotropicHeat2D, duration: f64, steps: i32) -> HeatRun2D {
    if not validRun(initial, duration, steps) {
        return HeatRun2D { valid: false, state: initial }
    }
    let mut state: AnisotropicHeat2D = initial
    let dt: f64 = duration / (steps as f64)
    for index in 0 to steps {
        AnisotropicHeat2D_step(&state, dt)
    }
    return HeatRun2D { valid: true, state: state }
}

function integrate(duration: f64, steps: i32) -> HeatRun2D {
    return runFrom(AnisotropicHeat2D_new(), duration, steps)
}

function analyticReference() -> AnisotropicHeat2D {
    # Initial data: mean=3, x-mode=0.8, y-mode=-0.4, xy-mode=0.2.
    # At t=1, exact amplitudes are exp(-0.32), exp(-0.64), exp(-0.96).
    let mut expected: AnisotropicHeat2D = AnisotropicHeat2D_new()
    expected.northwest = 3.446580837236756
    expected.northeast = 2.131585223528805
    expected.southwest = 3.71525762208115
    expected.southeast = 2.706576317153289
    return expected
}

function main() -> i32 {
    let expected: AnisotropicHeat2D = analyticReference()
    let coarse: HeatRun2D = integrate(1.0, 8)
    let medium: HeatRun2D = integrate(1.0, 16)
    let fine: HeatRun2D = integrate(1.0, 32)
    let finest: HeatRun2D = integrate(1.0, 64)
    if not coarse.valid or not medium.valid or not fine.valid or not finest.valid { return 1 }

    let error8: f64 = maxDifference(coarse.state, expected)
    let error16: f64 = maxDifference(medium.state, expected)
    let error32: f64 = maxDifference(fine.state, expected)
    let error64: f64 = maxDifference(finest.state, expected)
    if error8 < 0.00000001 { return 2 }
    if error64 > 0.0000000001 { return 3 }
    if error16 >= error8 * 0.09 { return 4 }
    if error32 >= error16 * 0.09 { return 5 }
    if error64 >= error32 * 0.09 { return 6 }
    if absolute(meanTemperature(finest.state) - 3.0) > 0.000000000001 { return 7 }
    if finest.state.northwest < 1.6 or finest.state.northwest > 4.0 or
       finest.state.northeast < 1.6 or finest.state.northeast > 4.0 or
       finest.state.southwest < 1.6 or finest.state.southwest > 4.0 or
       finest.state.southeast < 1.6 or finest.state.southeast > 4.0 { return 8 }

    let replay: HeatRun2D = integrate(1.0, 64)
    if not replay.valid or maxDifference(replay.state, finest.state) > 0.000000000001 { return 9 }
    let firstHalf: HeatRun2D = integrate(0.5, 32)
    if not firstHalf.valid { return 10 }
    let secondHalf: HeatRun2D = runFrom(firstHalf.state, 0.5, 32)
    if not secondHalf.valid or maxDifference(secondHalf.state, finest.state) > 0.000000000001 { return 11 }

    # Transposing the grid and exchanging x/y coefficients commutes with evolution.
    let mut transposed: AnisotropicHeat2D = AnisotropicHeat2D_new()
    transposed.northeast = 4.0
    transposed.southwest = 1.6
    transposed.diffusivity_x = 0.04
    transposed.diffusivity_y = 0.02
    let transposedRun: HeatRun2D = runFrom(transposed, 1.0, 64)
    let mut transposedExpected: AnisotropicHeat2D = finest.state
    transposedExpected.northeast = finest.state.southwest
    transposedExpected.southwest = finest.state.northeast
    if not transposedRun.valid or
       maxDifference(transposedRun.state, transposedExpected) > 0.000000000001 { return 12 }

    let mut uniform: AnisotropicHeat2D = AnisotropicHeat2D_new()
    uniform.northwest = 7.0
    uniform.northeast = 7.0
    uniform.southwest = 7.0
    uniform.southeast = 7.0
    let equilibrium: HeatRun2D = runFrom(uniform, 1.0, 64)
    if not equilibrium.valid or maxDifference(equilibrium.state, uniform) > 0.000000000001 { return 13 }
    let mut noDiffusion: AnisotropicHeat2D = AnisotropicHeat2D_new()
    noDiffusion.diffusivity_x = 0.0
    noDiffusion.diffusivity_y = 0.0
    let frozen: HeatRun2D = runFrom(noDiffusion, 1.0, 8)
    if not frozen.valid or maxDifference(frozen.state, noDiffusion) > 0.000000000001 { return 14 }
    let zeroDuration: HeatRun2D = integrate(0.0, 8)
    if not zeroDuration.valid or
       maxDifference(zeroDuration.state, AnisotropicHeat2D_new()) > 0.000000000001 { return 15 }

    if integrate(1.0, 0).valid { return 16 }
    if integrate(1.0, 100001).valid { return 17 }
    if integrate(-1.0, 64).valid { return 18 }
    if integrate(100.1, 64).valid { return 19 }
    let mut invalid: AnisotropicHeat2D = AnisotropicHeat2D_new()
    invalid.spacing_x = 0.0
    if runFrom(invalid, 1.0, 64).valid { return 20 }
    invalid = AnisotropicHeat2D_new()
    invalid.diffusivity_y = -0.04
    if runFrom(invalid, 1.0, 64).valid { return 21 }
    invalid = AnisotropicHeat2D_new()
    invalid.diffusivity_x = 100.1
    if runFrom(invalid, 1.0, 64).valid { return 22 }
    if integrate(1.0, 1).valid == false { return 23 }
    invalid = AnisotropicHeat2D_new()
    invalid.diffusivity_x = 1.0
    if runFrom(invalid, 1.0, 1).valid { return 24 }

    println("native-evolution-heat2d-ok")
    return 0
}
