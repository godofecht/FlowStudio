    result = evaluate_math_expression("π(2)")
    if result.valid or result.failed_at != 2 { return 442 }
    let pi_source: ParsedMathExpression = parse_math_expression("π+tau")
    if not pi_source.valid or pi_source.program.count != 3 or
       pi_source.program.instructions[0].source_start != 0 or
       pi_source.program.instructions[0].source_end != 2 or
       pi_source.program.instructions[1].source_start != 3 or
       pi_source.program.instructions[1].source_end != 6 or
       pi_source.program.instructions[2].source_start != 2 { return 443 }
    let mut constant_binding: MathBindings = empty_math_bindings()
    constant_binding.count = 1
    constant_binding.symbols[0] = MathSymbol { name: "pi", value: quantity(4.0, dimensionless()) }
    result = evaluate_math_expression_with_bindings("pi", constant_binding)
    if not result.valid or not near(result.result.value, 4.0) { return 444 }
    constant_binding.symbols[0] = MathSymbol { name: "π", value: quantity(4.0, dimensionless()) }
    result = evaluate_math_expression_with_bindings("π", constant_binding)
    if not result.valid or not near(result.result.value, 4.0) { return 445 }
    constant_binding.symbols[0] = MathSymbol { name: "tau", value: quantity(4.0, dimensionless()) }
    result = evaluate_math_expression_with_bindings("tau", constant_binding)
    if not result.valid or not near(result.result.value, 4.0) { return 446 }
    constant_binding.symbols[0] = MathSymbol { name: "τ", value: quantity(4.0, dimensionless()) }
    result = evaluate_math_expression_with_bindings("τ", constant_binding)
    if not result.valid or not near(result.result.value, 4.0) { return 447 }

    # Unicode mathematical whitespace is lexed without changing source spans.
    result = evaluate_math_expression("1m + 2m")
    if not result.valid or not near(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 448 }
    result = evaluate_math_expression("2 × 3")
    if not result.valid or not near(result.result.value, 6.0) { return 449 }
    result = evaluate_math_expression("4 ÷ 2")
    if not result.valid or not near(result.result.value, 2.0) { return 450 }
    result = evaluate_math_expression("2 + 3")
    if not result.valid or not near(result.result.value, 5.0) { return 451 }
    result = evaluate_math_expression("2 + 3")
    if not result.valid or not near(result.result.value, 5.0) { return 452 }
    result = evaluate_math_expression("2　+　3")
    if not result.valid or not near(result.result.value, 5.0) { return 453 }
    let spaced_source: ParsedMathExpression = parse_math_expression("1 + 2")
    if not spaced_source.valid or spaced_source.program.count != 3 or
       spaced_source.program.instructions[0].source_start != 0 or
       spaced_source.program.instructions[0].source_end != 1 or
       spaced_source.program.instructions[1].source_start != 8 or
       spaced_source.program.instructions[1].source_end != 9 or
       spaced_source.program.instructions[2].source_start != 4 or
       spaced_source.program.instructions[2].source_end != 5 { return 454 }
    let rejected_zwsp: ParsedMathExpression = parse_math_expression("1​+2")
    if rejected_zwsp.valid or rejected_zwsp.failed_at != 1 { return 455 }
    let rejected_joiner: ParsedMathExpression = parse_math_expression("1⁠+2")
    if rejected_joiner.valid or rejected_joiner.failed_at != 1 { return 456 }
    if parse_math_expression("1<").valid or parse_math_expression("1>").valid {
        return 457
    }
    let incomplete_space: ParsedMathExpression = parse_math_expression("1 +")
    if incomplete_space.valid or incomplete_space.failed_at != 4 { return 458 }

    # U+2212 is a mathematical exponent sign, not an implicit operation.
    result = evaluate_math_expression("2m^−2")
    if not result.valid or not near(result.result.value, 0.25) or
       not same_dimension(result.result.dimension,
           quotient_dimension(dimensionless(), product_dimension(length, length))) { return 459 }
    result = evaluate_math_expression("2m^−2 * 2m²")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 460 }
    result = evaluate_math_expression("-2m^−2")
    if not result.valid or not near(result.result.value, -0.25) { return 461 }
    result = evaluate_math_expression("2m^−0")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 462 }
    result = evaluate_math_expression("2m⁻²")
    if not result.valid or not near(result.result.value, 0.25) { return 463 }
    let unicode_power: ParsedMathExpression = parse_math_expression("2m^−2")
    if not unicode_power.valid or unicode_power.program.count != 2 or
       unicode_power.program.instructions[1].opcode != 6 or
       unicode_power.program.instructions[1].exponent != -2 or
       unicode_power.program.instructions[1].source_start != 2 or
       unicode_power.program.instructions[1].source_end != 7 { return 464 }
    let missing_exponent: ParsedMathExpression = parse_math_expression("2m^−")
    if missing_exponent.valid or missing_exponent.failed_at != 2 { return 465 }
    let out_of_range_power: ParsedMathExpression = parse_math_expression("2m^−9")
    if out_of_range_power.valid or out_of_range_power.failed_at != 2 { return 466 }
    let chained_power: ParsedMathExpression = parse_math_expression("2m^−2^2")
    if chained_power.valid or chained_power.failed_at != 7 { return 467 }
    result = evaluate_math_expression("2m^−2 + 1m")
    if result.valid or result.failed_at != 8 { return 468 }


    # ASCII ** is executable bounded integer exponentiation, not multiplication.
    # Physical units, precedence, byte spans, and malformed powers use the
    # same typed IR and diagnostics as ^ and Unicode superscripts.
    result = evaluate_math_expression("2m**2 / 2m")
    if not result.valid or not near(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, length) { return 469 }
    result = evaluate_math_expression("2m**-2 * 2m²")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 470 }
    result = evaluate_math_expression("-2**2")
    if not result.valid or not near(result.result.value, -4.0) { return 471 }
    result = evaluate_math_expression("2**2*3")
    if not result.valid or not near(result.result.value, 12.0) { return 472 }
    result = evaluate_math_expression("2m**−2")
    if not result.valid or not near(result.result.value, 0.25) or
       not same_dimension(result.result.dimension,
           quotient_dimension(dimensionless(), product_dimension(length, length))) { return 473 }
    let double_star: ParsedMathExpression = parse_math_expression("2m**−2")
    if not double_star.valid or double_star.program.count != 2 or
       double_star.program.instructions[1].opcode != 6 or
       double_star.program.instructions[1].exponent != -2 or
       double_star.program.instructions[1].source_start != 2 or
       double_star.program.instructions[1].source_end != 8 { return 474 }
    let malformed_double_star: ParsedMathExpression = parse_math_expression("2***2")
    if malformed_double_star.valid or malformed_double_star.failed_at != 1 { return 475 }
    malformed_double_star = parse_math_expression("2**")
    if malformed_double_star.valid or malformed_double_star.failed_at != 1 { return 476 }
    malformed_double_star = parse_math_expression("2**9")
    if malformed_double_star.valid or malformed_double_star.failed_at != 1 { return 477 }
    malformed_double_star = parse_math_expression("2**2**3")
    if malformed_double_star.valid or malformed_double_star.failed_at != 4 { return 478 }
    result = evaluate_math_expression("2m**2 + 1s")
    if result.valid or result.failed_at != 6 { return 479 }

    # Practical volume, pressure and time units lower into the same SI-typed
    # native postfix IR, including nontrivial scaling and dimensional failures.
    result = evaluate_math_expression("1L/1m³")
    if not result.valid or not near(result.result.value, 0.001) or
       not same_dimension(result.result.dimension, dimensionless()) { return 480 }
    result = evaluate_math_expression("1mL/1L")
    if not result.valid or not near(result.result.value, 0.001) { return 481 }
    result = evaluate_math_expression("1bar/1kPa")
    if not result.valid or not near(result.result.value, 100.0) { return 482 }
    result = evaluate_math_expression("1min+30s")
    if not result.valid or not near(result.result.value, 90.0) or
       not same_dimension(result.result.dimension, time) { return 483 }
    result = evaluate_math_expression("1h/60min")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 484 }
    result = evaluate_math_expression("1dm+20cm")
    if not result.valid or not near(result.result.value, 0.3) or
       not same_dimension(result.result.dimension, length) { return 485 }
    result = evaluate_math_expression("1hm/1m")
    if not result.valid or not near(result.result.value, 100.0) { return 486 }
    result = evaluate_math_expression("1daN/1N")
    if not result.valid or not near(result.result.value, 10.0) { return 487 }
    result = evaluate_math_expression("1pPa/1fPa")
    if not result.valid or not near(result.result.value, 1000.0) { return 488 }
    result = evaluate_math_expression("1Tm/1Gm")
    if not result.valid or not near(result.result.value, 1000.0) { return 489 }
    result = evaluate_math_expression("1mbar+1Pa")
    if not result.valid or not near(result.result.value, 101.0) { return 490 }
    result = evaluate_math_expression("1h+1m")
    if result.valid or result.failed_at != 2 { return 491 }
    result = evaluate_math_expression("1min+1m")
    if result.valid or result.failed_at != 4 { return 492 }
    result = evaluate_math_expression("1L+1m")
    if result.valid or result.failed_at != 2 { return 493 }
    let practical_unit: ParsedMathExpression = parse_math_expression("1µL")
    if not practical_unit.valid or practical_unit.program.count != 1 or
       practical_unit.program.instructions[0].source_end != 4 { return 494 }
    practical_unit = parse_math_expression("1daPa")
    if not practical_unit.valid or practical_unit.program.instructions[0].source_end != 5 { return 495 }
    practical_unit = parse_math_expression("1fPa")
    if not practical_unit.valid or practical_unit.program.instructions[0].source_end != 4 { return 496 }
    practical_unit = parse_math_expression("1minute")
    if practical_unit.valid or practical_unit.failed_at != 4 { return 497 }


    # Native angle quantities are dimensionless radians after coherent scaling.
    # This is executed by the Flow compiler, not just recognized by Monaco.
    result = evaluate_math_expression("sin(90°)")
    if not result.valid or not near(result.result.value, 1.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 498 }
    result = evaluate_math_expression("cos(180deg)")
    if not result.valid or not near(result.result.value, -1.0) { return 499 }
    result = evaluate_math_expression("sin(0.25turn)")
    if not result.valid or not near(result.result.value, 1.0) { return 500 }
    result = evaluate_math_expression("tan(50grad)")
    if not result.valid or not near(result.result.value, 1.0) { return 501 }
    result = evaluate_math_expression("1mrad+1rad")
    if not result.valid or not near(result.result.value, 1.001) { return 502 }
    result = evaluate_math_expression("1°/1deg")
    if not result.valid or not near(result.result.value, 1.0) { return 503 }
    result = evaluate_math_expression("ln(e)")
    if not result.valid or not near(result.result.value, 1.0) { return 504 }
    result = evaluate_math_expression("90°+1m")
    if result.valid or result.failed_at != 4 { return 505 }
    result = evaluate_math_expression("1rad+1s")
    if result.valid or result.failed_at != 4 { return 506 }
    let angle_source: ParsedMathExpression = parse_math_expression("90°")
    if not angle_source.valid or angle_source.program.count != 1 or
       angle_source.program.instructions[0].source_end != 4 { return 507 }
    angle_source = parse_math_expression("1µrad")
    if not angle_source.valid or angle_source.program.instructions[0].source_end != 6 { return 508 }
    angle_source = parse_math_expression("1degrees")
    if angle_source.valid or angle_source.failed_at != 4 { return 509 }
    let mut e_bindings: MathBindings = empty_math_bindings()
    e_bindings.count = 1
    e_bindings.symbols[0] = MathSymbol { name: "e", value: quantity(3.0, length) }
    result = evaluate_math_expression_with_bindings("e", e_bindings)
    if not result.valid or not near(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length) { return 510 }

    # Native factorial postfix and function calls share typed opcode 56.
    result = evaluate_math_expression("0!")
    if not result.valid or not near(result.result.value, 1.0) { return 511 }
    result = evaluate_math_expression("5!")
    if not result.valid or not near(result.result.value, 120.0) { return 512 }
    result = evaluate_math_expression("factorial(6)")
    if not result.valid or not near(result.result.value, 720.0) { return 513 }
    result = evaluate_math_expression("3!²")
    if not result.valid or not near(result.result.value, 36.0) { return 514 }
    result = evaluate_math_expression("-3!")
    if not result.valid or not near(result.result.value, -6.0) { return 515 }
    result = evaluate_math_expression("20!")
    if not result.valid or result.result.value != 2432902008176640000.0 { return 516 }
    result = evaluate_math_expression("3!=4")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 517 }
    result = evaluate_math_expression("3.5!")
    if result.valid or result.failed_at != 3 { return 518 }
    result = evaluate_math_expression("(-3)!")
    if result.valid or result.failed_at != 4 { return 519 }
    result = evaluate_math_expression("21!")
    if result.valid or result.failed_at != 2 { return 520 }
    result = evaluate_math_expression("2m!")
    if result.valid or result.failed_at != 2 { return 521 }
    result = evaluate_math_expression("true!")
    if result.valid or result.failed_at != 4 { return 522 }
    let factorial_source: ParsedMathExpression = parse_math_expression("5!")
    if not factorial_source.valid or factorial_source.program.count != 2 or
       factorial_source.program.instructions[1].opcode != 56 or
       factorial_source.program.instructions[1].source_start != 1 or
       factorial_source.program.instructions[1].source_end != 2 { return 523 }
    factorial_source = parse_math_expression("factorial(5)")
    if not factorial_source.valid or factorial_source.program.count != 2 or
       factorial_source.program.instructions[1].opcode != 56 or
       factorial_source.program.instructions[1].source_start != 0 or
       factorial_source.program.instructions[1].source_end != 9 { return 524 }
    if parse_math_expression("factorial()").valid { return 525 }
    if parse_math_expression("factorial(1,2)").valid { return 526 }
    if parse_math_expression("!5").valid { return 527 }

    println("native-math-source-ok")
    return 0
}
