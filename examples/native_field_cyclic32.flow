        0.36108963479868700,
        0.18147591161399682,
        0.0
    ]
    let afterU16: array<f64, 32> = [0.0]
    let afterV16: array<f64, 32> = [0.0]
    let afterW16: array<f64, 32> = [0.0]
    let afterU64: array<f64, 32> = [0.0]
    let afterV64: array<f64, 32> = [0.0]
    let afterW64: array<f64, 32> = [0.0]
    let afterU128: array<f64, 32> = [0.0]
    let afterV128: array<f64, 32> = [0.0]
    let afterW128: array<f64, 32> = [0.0]
    if not integrate(initialU, initialV, initialW, afterU16, afterV16, afterW16, RATIO, EXCHANGE, 16) { return 1 }
    if not integrate(initialU, initialV, initialW, afterU64, afterV64, afterW64, RATIO, EXCHANGE, 64) { return 2 }
    if not integrate(initialU, initialV, initialW, afterU128, afterV128, afterW128, RATIO, EXCHANGE, 128) { return 3 }
    let mut energyInitial: f64 = 0.0
    let mut energy16: f64 = 0.0
    let mut energy64: f64 = 0.0
    let mut energy128: f64 = 0.0
    for i in 0 to N {
        if absolute(afterU16[i] - expectedU16[i]) > 0.00000000005 or
           absolute(afterV16[i] - expectedV16[i]) > 0.00000000005 or
           absolute(afterW16[i] - expectedW16[i]) > 0.00000000005 { return 4 }
        if absolute(afterU64[i] - expectedU64[i]) > 0.00000000005 or
           absolute(afterV64[i] - expectedV64[i]) > 0.00000000005 or
           absolute(afterW64[i] - expectedW64[i]) > 0.00000000005 { return 5 }
        if absolute(afterU128[i] - expectedU128[i]) > 0.00000000005 or
           absolute(afterV128[i] - expectedV128[i]) > 0.00000000005 or
           absolute(afterW128[i] - expectedW128[i]) > 0.00000000005 { return 6 }
        energyInitial = energyInitial + initialU[i] * initialU[i] + initialV[i] * initialV[i] + initialW[i] * initialW[i]
        energy16 = energy16 + afterU16[i] * afterU16[i] + afterV16[i] * afterV16[i] + afterW16[i] * afterW16[i]
        energy64 = energy64 + afterU64[i] * afterU64[i] + afterV64[i] * afterV64[i] + afterW64[i] * afterW64[i]
        energy128 = energy128 + afterU128[i] * afterU128[i] + afterV128[i] * afterV128[i] + afterW128[i] * afterW128[i]
    }
    if not (energyInitial > energy16 and energy16 > energy64 and energy64 > energy128) { return 7 }
    if afterU128[0] != 0.0 or afterU128[N - 1] != 0.0 { return 8 }
    if afterV128[0] != 0.0 or afterV128[N - 1] != 0.0 { return 9 }
    if afterW128[0] != 0.0 or afterW128[N - 1] != 0.0 { return 10 }
    let composedU: array<f64, 32> = [0.0]
    let replayU: array<f64, 32> = [0.0]
    let composedV: array<f64, 32> = [0.0]
    let replayV: array<f64, 32> = [0.0]
    let composedW: array<f64, 32> = [0.0]
    let replayW: array<f64, 32> = [0.0]
    if not integrate(afterU64, afterV64, afterW64, composedU, composedV, composedW, RATIO, EXCHANGE, 64) { return 11 }
    if not integrate(initialU, initialV, initialW, replayU, replayV, replayW, RATIO, EXCHANGE, 128) { return 12 }
    for i in 0 to N {
        if absolute(composedU[i] - afterU128[i]) > 0.000000000001 or
           absolute(composedV[i] - afterV128[i]) > 0.000000000001 or
           absolute(composedW[i] - afterW128[i]) > 0.000000000001 { return 13 }
        if replayU[i] != afterU128[i] or
           replayV[i] != afterV128[i] or
           replayW[i] != afterW128[i] { return 14 }
    }
    if not integrate(initialU, initialV, initialW, replayU, replayV, replayW, RATIO, EXCHANGE, 0) { return 15 }
    for i in 0 to N {
        if replayU[i] != initialU[i] or
           replayV[i] != initialV[i] or
           replayW[i] != initialW[i] { return 16 }
    }
    if not integrate(initialU, initialV, initialW, replayU, replayV, replayW, RATIO, 0, 128) { return 17 }
    if absolute(replayU[15] - afterU128[15]) < 0.0001 { return 18 }
    let sentinelU: array<f64, 32> = [0.0]
    let sentinelV: array<f64, 32> = [0.0]
    let sentinelW: array<f64, 32> = [0.0]
    for i in 0 to N {
        sentinelU[i] = 777.0
        sentinelV[i] = 777.0
        sentinelW[i] = 777.0
    }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, -0.01, EXCHANGE, 16) { return 19 }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, 0.500001, EXCHANGE, 16) { return 20 }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, -0.01, 16) { return 21 }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, 0.250001, 16) { return 22 }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, EXCHANGE, -1) { return 23 }
    if integrate(initialU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, EXCHANGE, 1025) { return 24 }
    let malformedU: array<f64, 32> = [0.0]
    field_copy_1d(initialU, malformedU, N)
    malformedU[0] = 1.0
    if integrate(malformedU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, EXCHANGE, 16) { return 25 }
    malformedU[0] = 0.0
    malformedU[15] = 11.0
    if integrate(malformedU, initialV, initialW, sentinelU, sentinelV, sentinelW, RATIO, EXCHANGE, 16) { return 26 }
    for i in 0 to N {
        if sentinelU[i] != 777.0 or sentinelV[i] != 777.0 or sentinelW[i] != 777.0 { return 27 }
    }
    println("native-field-cyclic32-ok")
    println("FLOWSTUDIO_FIELD_V1 32 3")
    print("U")
    for i in 0 to N {
        print(" ")
        print(afterU128[i])
    }
    println("")
    print("V")
    for i in 0 to N {
        print(" ")
        print(afterV128[i])
    }
    println("")
    print("W")
    for i in 0 to N {
        print(" ")
        print(afterW128[i])
    }
    println("")
    println("FLOWSTUDIO_FIELD_END")
    return 0
}
