# Executable native Flow 2.0 regression for mathematical comparison glyphs.
# No editor emulation: this imports the production source parser and typed IR.
import .math_dimensions { dimensionless, same_dimension }
import .math_expression_ir { MathResult }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("2m≦3m")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 or
       not same_dimension(result.result.dimension, dimensionless()) { return 1 }
    result = evaluate_math_expression("3m≦2m")
    if not result.valid or result.result.value != 0.0 { return 2 }
    result = evaluate_math_expression("3m≧2m")
    if not result.valid or result.result.value != 1.0 { return 3 }
    result = evaluate_math_expression("2m≧3m")
    if not result.valid or result.result.value != 0.0 { return 4 }
    result = evaluate_math_expression("2m⩽2m")
    if not result.valid or result.result.value != 1.0 { return 5 }
    result = evaluate_math_expression("2m⩾3m")
    if not result.valid or result.result.value != 0.0 { return 6 }
    result = evaluate_math_expression("2m+1m⩽3m")
    if not result.valid or result.result.value != 1.0 { return 7 }
    result = evaluate_math_expression("2m≦3m ∧ 3m⩾2m")
    if not result.valid or not result.is_predicate or result.result.value != 1.0 { return 8 }
    result = evaluate_math_expression("where(2m⩾3m,1s,2s)")
    if not result.valid or result.is_predicate or result.result.value != 2.0 { return 9 }
    let less: ParsedMathExpression = parse_math_expression("2m≦3m")
    if not less.valid or less.program.count != 3 or
       less.program.instructions[2].opcode != 11 or
       less.program.instructions[2].source_start != 2 or
       less.program.instructions[2].source_end != 5 { return 10 }
    let greater: ParsedMathExpression = parse_math_expression("2m⩾3m")
    if not greater.valid or greater.program.count != 3 or
       greater.program.instructions[2].opcode != 13 or
       greater.program.instructions[2].source_start != 2 or
       greater.program.instructions[2].source_end != 5 { return 11 }
    result = evaluate_math_expression("2m≦3s")
    if result.valid or result.failed_at != 2 { return 12 }
    result = evaluate_math_expression("2m⩾3s")
    if result.valid or result.failed_at != 2 { return 13 }
    let malformed: ParsedMathExpression = parse_math_expression("≦2m")
    if malformed.valid or malformed.failed_at != 0 { return 14 }
    malformed = parse_math_expression("2m⩽")
    if malformed.valid or malformed.failed_at != 5 { return 15 }
    malformed = parse_math_expression("2m≦3m≧4m")
    if not malformed.valid { return 16 }
    result = evaluate_math_expression("2m≦3m≧4m")
    if result.valid { return 17 }
    result = evaluate_math_expression("2m⩾2m ∨ 4m≦3m")
    if not result.valid or result.result.value != 1.0 { return 18 }
    println("native-math-unicode-comparisons-ok")
    return 0
}
