# Native Flow execution tests for variable-count symbolic dimensional constraints.
import .math_dimensions { Dimension, length_dimension, time_dimension, product_dimension, same_dimension }
import .math_static { MathDimensionBindings, MathDimensionSymbol, empty_math_dimension_bindings }
import .math_dimension_triple { MathThreeDimensionSolution }
import .math_dimension_variable { MathThreeConstraintSystem, empty_math_three_constraint_system, solve_math_equations_variable_constraints_three_unknown_dimensions }

function main() -> i32 {
    let length: Dimension = length_dimension()
    let time: Dimension = time_dimension()
    let area: Dimension = product_dimension(length, length)
    let mut known: MathDimensionBindings = empty_math_dimension_bindings()
    let mut system: MathThreeConstraintSystem = empty_math_three_constraint_system()
    system.count = 6
    system.equations[0] = "x/y = 1"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "x/y = 1"
    system.equations[3] = "x*y*z = 1m³"
    system.equations[4] = "y/z = 1"
    system.equations[5] = "x+y = 2m"
    let mut result: MathThreeDimensionSolution =
        solve_math_equations_variable_constraints_three_unknown_dimensions(
            system, known, "x", "y", "z")
    if not result.valid or result.failed_equation != -1 or
       not same_dimension(result.first, length) or
       not same_dimension(result.second, length) or
       not same_dimension(result.third, length) { return 1 }

    # Rank is obtained from the final three constraints, with two typed
    # additive checks before the pivot. This cannot be handled by the old
    # fixed four-equation API.
    system.equations[0] = "x+y = 2m"
    system.equations[1] = "x+z = 2m"
    system.equations[2] = "x/y = 1"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if not result.valid { return 2 }

    system.equations[5] = "x+y = 2s"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid or result.failed_equation != 5 { return 3 }

    system.equations[5] = "x+=1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid or result.failed_equation != 5 { return 4 }

    system.equations[5] = "x+y = 2m"
    system.equations[0] = "x+=1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid or result.failed_equation != 0 { return 5 }

    # All 16 slots are executable, including a late contradiction.
    system = empty_math_three_constraint_system()
    system.count = 16
    let mut index: i32 = 0
    while index < 13 {
        system.equations[index] = "x/y = 1"
        index = index + 1
    }
    system.equations[13] = "x*y*z = 1m³"
    system.equations[14] = "y/z = 1"
    system.equations[15] = "x = 1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if not result.valid or not same_dimension(result.third, length) { return 6 }

    system.equations[15] = "x = 1s"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid or result.failed_equation != 15 { return 7 }

    system.equations[15] = "x = 1m"
    system.count = 17
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid { return 8 }
    system.count = 2
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid { return 9 }

    system = empty_math_three_constraint_system()
    system.count = 4
    system.equations[0] = "δ₀*ρ*ζ = 1m³"
    system.equations[1] = "δ₀/ρ = 1"
    system.equations[2] = "ρ/ζ = 1"
    system.equations[3] = "δ₀ = 1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "δ₀", "ρ", "ζ")
    if not result.valid or not same_dimension(result.first, length) { return 10 }

    system.equations[0] = "sqrt(x)*y*z = 1m³"
    system.equations[1] = "x/y = 1m"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "x = 1m²"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if not result.valid or not same_dimension(result.first, area) or
       not same_dimension(result.second, length) { return 11 }

    system.equations[0] = "x/y = 1"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "y/z = 1"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid { return 12 }

    system.equations[0] = "x*y*z = 1m²"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "x = 1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid { return 13 }

    known.count = 1
    known.symbols[0] = MathDimensionSymbol { name: "duration", dimension: time }
    system.equations[0] = "x*y*z = duration³*1m³"
    system.equations[1] = "x/y = 1"
    system.equations[2] = "y/z = 1"
    system.equations[3] = "x = duration*1m"
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    let length_time: Dimension = product_dimension(length, time)
    if not result.valid or not same_dimension(result.first, length_time) { return 14 }

    known.count = 6
    result = solve_math_equations_variable_constraints_three_unknown_dimensions(
        system, known, "x", "y", "z")
    if result.valid { return 15 }

    print("native-math-variable-constraints-ok")
    return 0
}
