# Executable native Flow 2.0 bounded equation-system parsing and residuals.
# flow run src/math_equation_system_smoke.flow
import .math_dimensions { dimensionless, length_dimension, time_dimension, temperature_dimension, quantity, same_dimension }
import .math_expression_source { MathBindings, MathSymbol, empty_math_bindings }
import .math_equation_system { MathEquationSystem, MathEquationSystemResult, MathEquationTolerances, empty_math_equation_tolerances, parse_math_equation_system, parse_math_equation_system_with_bindings, evaluate_math_equation_system }

function near(a: f64, b: f64) -> bool {
    let mut difference: f64 = a - b
    if difference < 0.0 { difference = -difference }
    return difference < 0.00000000001
}

function main() -> i32 {
    let mut system: MathEquationSystem = parse_math_equation_system("3m+2m=5m;2s=2s;3K=3K")
    if not system.valid or system.count != 3 or system.source_length != 23 or
       system.equations[1].equality_at != 12 or
       system.equations[1].right.instructions[0].source_start != 13 or
       system.equations[2].left.instructions[0].source_start != 16 { return 1 }
    let mut tolerances: MathEquationTolerances = empty_math_equation_tolerances()
    tolerances.count = 3
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, time_dimension())
    tolerances.values[2] = quantity(0.0, temperature_dimension())
    let mut result: MathEquationSystemResult = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 3 or
       not near(result.results[0].residual.value, 0.0) or
       not same_dimension(result.results[1].residual.dimension, time_dimension()) { return 2 }

    system = parse_math_equation_system("3m+2m=5m;2s=3s;3K=3K")
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or result.satisfied or result.count != 3 or
       result.results[1].satisfied or not near(result.results[1].residual.value, -1.0) { return 3 }
    tolerances.values[1] = quantity(1.0, time_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 4 }
    tolerances.values[1] = quantity(0.0, time_dimension())

    system = parse_math_equation_system("1m+2m=3m;4s/0=2s")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 12 { return 5 }
    system = parse_math_equation_system("1m+2m=3m;1m+1s=2m")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 12 { return 6 }
    system = parse_math_equation_system("1m+2m=3m;2s=2m")
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != 1 or result.failed_at != 12 { return 7 }

    system = parse_math_equation_system("1m+2m=3m;;2s=2s")
    if system.valid or system.failed_equation != 1 or system.failed_at != 10 { return 8 }
    system = parse_math_equation_system("1m+2m=3m;")
    if system.valid or system.failed_equation != 1 or system.failed_at != 10 { return 9 }
    system = parse_math_equation_system("1=(2;3)")
    if system.valid or system.failed_at != 4 { return 10 }
    system = parse_math_equation_system("1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m")
    if system.valid or system.failed_equation != 8 { return 11 }

    system = parse_math_equation_system("1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m;1m=1m")
    if not system.valid or system.count != 8 { return 12 }
    tolerances.count = 8
    let mut i: i32 = 0
    while i < 8 {
        tolerances.values[i] = quantity(0.0, length_dimension())
        i = i + 1
    }
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied or result.count != 8 { return 13 }
    tolerances.count = 7
    result = evaluate_math_equation_system(system, tolerances)
    if result.valid or result.failed_equation != -1 { return 14 }

    let mut bindings: MathBindings = empty_math_bindings()
    bindings.count = 1
    bindings.symbols[0] = MathSymbol { name: "α", value: quantity(3.0, length_dimension()) }
    system = parse_math_equation_system_with_bindings("α+2m=5m;α/3=1m", bindings)
    if not system.valid or system.count != 2 or
       system.equations[1].left.instructions[0].source_start != 9 { return 15 }
    tolerances.count = 2
    tolerances.values[0] = quantity(0.0, length_dimension())
    tolerances.values[1] = quantity(0.0, length_dimension())
    result = evaluate_math_equation_system(system, tolerances)
    if not result.valid or not result.satisfied { return 16 }

    println("native-math-equation-system-ok")
    return 0
}
