# Executable native Flow log1p regression, not a Python or editor snippet.
# flow run src/math_log1p_smoke.flow
import .math_dimensions { Quantity, dimensionless, length_dimension, quantity, same_dimension }
import .math_expression_ir { MathInstruction, MathProgram, MathResult, evaluate_math_ir }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }
import .math_static { MathInferredType, infer_math_ir, infer_math_expression_source, infer_math_equation_source }
import .math_equation { MathEquationResult, evaluate_math_equation_source }

function close(actual: f64, expected: f64, tolerance: f64) -> bool {
    let mut difference: f64 = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference <= tolerance
}

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("log1p(0)")
    if not result.valid or not close(result.result.value, 0.0, 0.000000000000001) { return 1 }
    result = evaluate_math_expression("log1p(1)")
    if not result.valid or not close(result.result.value, 0.6931471805599453, 0.00000000000001) { return 2 }
    result = evaluate_math_expression("log1p(0.5)")
    if not result.valid or not close(result.result.value, 0.4054651081081644, 0.00000000000001) { return 3 }
    result = evaluate_math_expression("log1p(-0.5)")
    if not result.valid or not close(result.result.value, -0.6931471805599453, 0.00000000000001) { return 4 }
    result = evaluate_math_expression("log1p(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000009999999999995, 0.000000000000000000000001) { return 5 }
    result = evaluate_math_expression("log1p(-0.000000000001)")
    if not result.valid or not close(result.result.value, -0.0000000000010000000000005, 0.000000000000000000000001) { return 6 }
    result = evaluate_math_expression("log1p(0.0000000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000000001, 0.0000000000000000000000000001) { return 7 }
    result = evaluate_math_expression("log1p(-0.999999999999)")
    if not result.valid or not close(result.result.value, -27.63104323789336, 0.000000000001) { return 8 }
    result = evaluate_math_expression("log1p(100000000000000000000)")
    if not result.valid or not close(result.result.value, 46.051701859880914, 0.000000000001) { return 9 }
    result = evaluate_math_expression("log1p(exp(1)-1)")
    if not result.valid or not close(result.result.value, 1.0, 0.00000000001) { return 10 }
    result = evaluate_math_expression("log1p(1m/1m)")
    if not result.valid or not close(result.result.value, 0.6931471805599453, 0.00000000000001) or
       not same_dimension(result.result.dimension, dimensionless()) { return 11 }
    result = evaluate_math_expression("log1p(0)+ln(2)-log(2)")
    if not result.valid or not close(result.result.value, 0.0, 0.00000000000001) { return 12 }
    result = evaluate_math_expression("log1p(-1)")
    if result.valid or result.failed_at != 0 { return 13 }
    result = evaluate_math_expression("log1p(-2)")
    if result.valid or result.failed_at != 0 { return 14 }
    result = evaluate_math_expression("log1p(1m)")
    if result.valid or result.failed_at != 0 { return 15 }
    result = evaluate_math_expression("log1p(true)")
    if result.valid or result.failed_at != 0 { return 16 }
    result = evaluate_math_expression("log1p(1<2)")
    if result.valid or result.failed_at != 0 { return 17 }
    result = evaluate_math_expression("log1p(1000000000000000000000000000001)")
    if result.valid or result.failed_at != 0 { return 18 }
    if parse_math_expression("log1p()").valid { return 19 }
    if parse_math_expression("log1p(1,2)").valid { return 20 }
    if parse_math_expression("log1p (1)").valid { return 21 }
    if parse_math_expression("log1p(1").valid { return 22 }
    let parsed: ParsedMathExpression = parse_math_expression("log1p(1)")
    if not parsed.valid or parsed.program.count != 2 or
       parsed.program.instructions[1].opcode != 42 or
       parsed.program.instructions[1].source_start != 0 or
       parsed.program.instructions[1].source_end != 5 { return 23 }
    let inferred: MathInferredType = infer_math_expression_source("log1p(1)")
    if not inferred.valid or inferred.is_predicate or
       not same_dimension(inferred.dimension, dimensionless()) { return 24 }
    inferred = infer_math_expression_source("log1p(-1)")
    if not inferred.valid or inferred.is_predicate { return 25 }
    inferred = infer_math_expression_source("log1p(1m)")
    if inferred.valid or inferred.failed_at != 0 { return 26 }
    inferred = infer_math_expression_source("log1p(true)")
    if inferred.valid or inferred.failed_at != 0 { return 27 }
    let tolerance: Quantity = quantity(0.00000000001, dimensionless())
    let equation: MathEquationResult = evaluate_math_equation_source("log1p(1) = ln(2)", tolerance)
    if not equation.valid or not equation.satisfied { return 28 }
    equation = evaluate_math_equation_source("log1p(-1) = 0", tolerance)
    if equation.valid { return 29 }
    inferred = infer_math_equation_source("log1p(1) = ln(2)")
    if not inferred.valid or not same_dimension(inferred.dimension, dimensionless()) { return 30 }
    let blank: MathInstruction = MathInstruction {
        opcode: 0, literal: quantity(0.0, dimensionless()),
        exponent: 0, source_start: 0, source_end: 0
    }
    let mut instructions: array<MathInstruction, 64> = [blank]
    instructions[0] = MathInstruction {
        opcode: 0, literal: quantity(0.5, dimensionless()),
        exponent: 0, source_start: 0, source_end: 1
    }
    instructions[1] = MathInstruction {
        opcode: 42, literal: quantity(0.0, dimensionless()),
        exponent: 0, source_start: 1, source_end: 2
    }
    let program: MathProgram = MathProgram { instructions: instructions, count: 2, source_length: 2 }
    result = evaluate_math_ir(program)
    if not result.valid or not close(result.result.value, 0.4054651081081644, 0.00000000000001) { return 31 }
    inferred = infer_math_ir(program)
    if not inferred.valid or not same_dimension(inferred.dimension, dimensionless()) { return 32 }
    instructions[0] = MathInstruction {
        opcode: 0, literal: quantity(0.5, length_dimension()),
        exponent: 0, source_start: 0, source_end: 1
    }
    let invalid_program: MathProgram = MathProgram { instructions: instructions, count: 2, source_length: 2 }
    result = evaluate_math_ir(invalid_program)
    if result.valid or result.failed_at != 1 { return 33 }
    inferred = infer_math_ir(invalid_program)
    if inferred.valid or inferred.failed_at != 1 { return 34 }
    println("native-math-log1p-ok")
    return 0
}
