# Compact HTTP acceptance fixture for the real native mathematical source parser.
# The comprehensive 70KB+ source regression runs separately via flow run.
# flow run src/math_expression_source_http_smoke.flow
import .math_dimensions { dimensionless, length_dimension, time_dimension, quotient_dimension, same_dimension }
import .math_expression_ir { MathResult }
import .math_expression_source { ParsedMathExpression, parse_math_expression, evaluate_math_expression }

function close(actual: f64, expected: f64) -> bool {
    let mut difference: f64 = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference < 0.00000000001
}

function main() -> i32 {
    let mut result: MathResult = evaluate_math_expression("3m/2s+4m/1s")
    if not result.valid or not close(result.result.value, 5.5) or
       not same_dimension(result.result.dimension,
           quotient_dimension(length_dimension(), time_dimension())) { return 1 }
    result = evaluate_math_expression("2×(3−1)÷2")
    if not result.valid or not close(result.result.value, 2.0) { return 2 }
    result = evaluate_math_expression("2m²/2m")
    if not result.valid or not close(result.result.value, 2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 3 }
    result = evaluate_math_expression("sin(0)+cos(0)")
    if not result.valid or not close(result.result.value, 1.0) { return 4 }
    result = evaluate_math_expression("tan(0)")
    if not result.valid or not close(result.result.value, 0.0) { return 5 }
    result = evaluate_math_expression("atan(1)")
    if not result.valid or not close(result.result.value, 0.7853981633974483) { return 6 }
    result = evaluate_math_expression("asin(0)+acos(1)")
    if not result.valid or not close(result.result.value, 0.0) { return 7 }
    result = evaluate_math_expression("atan2(1,1)")
    if not result.valid or not close(result.result.value, 0.7853981633974483) { return 8 }
    result = evaluate_math_expression("sinh(0)+cosh(0)+tanh(0)")
    if not result.valid or not close(result.result.value, 1.0) { return 9 }
    result = evaluate_math_expression("sinh(1m)")
    if result.valid or result.failed_at != 0 { return 10 }
    result = evaluate_math_expression("3m+2s")
    if result.valid or result.failed_at != 2 { return 11 }
    result = evaluate_math_expression("1/0")
    if result.valid or result.failed_at != 1 { return 12 }
    result = evaluate_math_expression("tanh(true)")
    if result.valid or result.failed_at != 0 { return 13 }
    let parsed: ParsedMathExpression = parse_math_expression("cosh(0)")
    if not parsed.valid or parsed.program.count != 2 or
       parsed.program.instructions[1].opcode != 36 or
       parsed.program.instructions[1].source_start != 0 or
       parsed.program.instructions[1].source_end != 4 { return 14 }
    if parse_math_expression("sinh(1,2)").valid { return 15 }
    result = evaluate_math_expression("asinh(1)+acosh(2)+atanh(0.5)")
    if not result.valid or not close(result.result.value, 2.7476376282784144) { return 16 }
    result = evaluate_math_expression("atanh(1)")
    if result.valid or result.failed_at != 0 { return 17 }
    result = evaluate_math_expression("acosh(1m)")
    if result.valid or result.failed_at != 0 { return 18 }
    result = evaluate_math_expression("log1p(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000009999999999995) { return 19 }
    result = evaluate_math_expression("log1p(-1)")
    if result.valid or result.failed_at != 0 { return 20 }
    result = evaluate_math_expression("expm1(0.000000000001)")
    if not result.valid or not close(result.result.value, 0.0000000000010000000000005) { return 21 }
    result = evaluate_math_expression("log1p(expm1(0.5))")
    if not result.valid or not close(result.result.value, 0.5) { return 22 }
    result = evaluate_math_expression("expm1(1m)")
    if result.valid or result.failed_at != 0 { return 23 }
    result = evaluate_math_expression("expm1(61)")
    if result.valid or result.failed_at != 0 { return 24 }
    result = evaluate_math_expression("sin(π/2)+cos(tau/2)")
    if not result.valid or not close(result.result.value, 0.0) or
       not same_dimension(result.result.dimension, dimensionless()) { return 25 }
    result = evaluate_math_expression("π+1m")
    if result.valid or result.failed_at != 2 { return 26 }
    let pi_source: ParsedMathExpression = parse_math_expression("π")
    if not pi_source.valid or pi_source.program.count != 1 or
       pi_source.program.instructions[0].source_end != 2 { return 27 }

    result = evaluate_math_expression("cbrt(-8*1m³)")
    if not result.valid or not close(result.result.value, -2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 28 }
    result = evaluate_math_expression("∛(27*1m³)")
    if not result.valid or not close(result.result.value, 3.0) { return 29 }
    result = evaluate_math_expression("cbrt(8m²)")
    if result.valid or result.failed_at != 0 { return 30 }
    let cube_source: ParsedMathExpression = parse_math_expression("∛(8)")
    if not cube_source.valid or cube_source.program.instructions[1].opcode != 44 or
       cube_source.program.instructions[1].source_end != 3 { return 31 }

    result = evaluate_math_expression("norm3(3m,4m,12m)")
    if not result.valid or not close(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 32 }
    result = evaluate_math_expression("norm3(3m,4s,12m)")
    if result.valid or result.failed_at != 0 { return 33 }
    result = evaluate_math_expression("norm3(1e20,1,1)")
    if not result.valid or not close(result.result.value / 1e20, 1.0) { return 34 }

    result = evaluate_math_expression("root4(81*1m⁴)")
    if not result.valid or not close(result.result.value, 3.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 35 }
    result = evaluate_math_expression("∜(16*1m⁴)")
    if not result.valid or not close(result.result.value, 2.0) { return 36 }
    result = evaluate_math_expression("root4(-16)")
    if result.valid or result.failed_at != 0 { return 37 }
    result = evaluate_math_expression("root4(16m³)")
    if result.valid or result.failed_at != 0 { return 38 }
    let fourth_source: ParsedMathExpression = parse_math_expression("∜(16)")
    if not fourth_source.valid or fourth_source.program.instructions[1].opcode != 46 or
       fourth_source.program.instructions[1].source_end != 3 { return 39 }

    result = evaluate_math_expression("root5(-32*1m⁵)")
    if not result.valid or not close(result.result.value, -2.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 40 }
    result = evaluate_math_expression("root6(64*1m⁶)")
    if not result.valid or not close(result.result.value, 2.0) { return 41 }
    result = evaluate_math_expression("root7(-128*1m⁷)")
    if not result.valid or not close(result.result.value, -2.0) { return 42 }
    result = evaluate_math_expression("root8(256*1m⁸)")
    if not result.valid or not close(result.result.value, 2.0) { return 43 }
    result = evaluate_math_expression("root8(-256)")
    if result.valid or result.failed_at != 0 { return 44 }
    result = evaluate_math_expression("root5(1m⁴)")
    if result.valid or result.failed_at != 0 { return 45 }
    let high_root_source: ParsedMathExpression = parse_math_expression("root8(256)")
    if not high_root_source.valid or high_root_source.program.instructions[1].opcode != 50 or
       high_root_source.program.instructions[1].source_end != 5 { return 46 }

    result = evaluate_math_expression("norm4(1m,2m,2m,4m)")
    if not result.valid or not close(result.result.value, 5.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 47 }
    result = evaluate_math_expression("norm4(1m,2m,2s,4m)")
    if result.valid or result.failed_at != 0 { return 48 }
    result = evaluate_math_expression("norm4(1e20,1,1,1)")
    if not result.valid or not close(result.result.value / 1e20, 1.0) { return 49 }
    let fourth_norm_source: ParsedMathExpression = parse_math_expression("norm4(1,2,2,4)")
    if not fourth_norm_source.valid or fourth_norm_source.program.instructions[4].opcode != 51 or
       fourth_norm_source.program.instructions[4].source_end != 5 { return 50 }

    result = evaluate_math_expression("norm5(3m,4m,0m,0m,12m)")
    if not result.valid or not close(result.result.value, 13.0) or
       not same_dimension(result.result.dimension, length_dimension()) { return 51 }
    result = evaluate_math_expression("norm6(3,4,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 52 }
    result = evaluate_math_expression("norm7(3,4,0,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 53 }
    result = evaluate_math_expression("norm8(3,4,0,0,0,0,0,12)")
    if not result.valid or not close(result.result.value, 13.0) { return 54 }
    result = evaluate_math_expression("norm8(3m,4m,0m,0m,0m,0s,0m,12m)")
    if result.valid or result.failed_at != 0 { return 55 }
    let eighth_norm_source: ParsedMathExpression =
        parse_math_expression("norm8(3,4,0,0,0,0,0,12)")
    if not eighth_norm_source.valid or
       eighth_norm_source.program.instructions[8].opcode != 55 or
       eighth_norm_source.program.instructions[8].source_end != 5 { return 56 }

    println("native-math-source-ok")
    return 0
}
