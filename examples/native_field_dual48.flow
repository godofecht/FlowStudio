# Two independent compiler-generated upstream Flow 2.0 PDE fields.
# Distinct fixed boundaries and diffusion ratios; 96 cells, 288 analytical
# checkpoint assertions, separate semigroup and mutation checks.
# Run: flow run examples/native_field_dual48.flow
import "stdlib/dynamics/pde.flow"

const N: i32 = 48
const RATIO_A: f64 = 0.4
const RATIO_B: f64 = 0.2

field A : f64[48] on Line
A evolves as laplacian(A)
boundary A { left = 1.0  right = 2.0 }

field B : f64[48] on Line
B evolves as laplacian(B)
boundary B { left = -0.5  right = 0.5 }

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

# Validate the entire input before either output is written. 2048 * 96
# <= 196608 cell-steps. Each field has its own stable Euler ratio.
function integrate(initialA: ptr<f64>, initialB: ptr<f64>,
                   outputA: ptr<f64>, outputB: ptr<f64>,
                   ratioA: f64, ratioB: f64, steps: i32) -> bool {
    if steps < 0 or steps > 2048 or
       ratioA != ratioA or ratioB != ratioB or
       ratioA < 0.0 or ratioA > 0.5 or
       ratioB < 0.0 or ratioB > 0.5 { return false }
    let currentA: array<f64, 48> = [0.0]
    let currentB: array<f64, 48> = [0.0]
    let nextA: array<f64, 48> = [0.0]
    let nextB: array<f64, 48> = [0.0]
    for i in 0 to N {
        if initialA[i] != initialA[i] or initialB[i] != initialB[i] or
           initialA[i] < -1000000.0 or initialA[i] > 1000000.0 or
           initialB[i] < -1000000.0 or initialB[i] > 1000000.0 { return false }
        currentA[i] = initialA[i]
        currentB[i] = initialB[i]
    }
    if currentA[0] != 1.0 or currentA[N - 1] != 2.0 or
       currentB[0] != -0.5 or currentB[N - 1] != 0.5 { return false }
    for step in 0 to steps {
        A_field_step(currentA, nextA, ratioA)
        B_field_step(currentB, nextB, ratioB)
        field_copy_1d(nextA, currentA, N)
        field_copy_1d(nextB, currentB, N)
        for i in 0 to N {
            if currentA[i] != currentA[i] or currentB[i] != currentB[i] or
               currentA[i] < -1000000.0 or currentA[i] > 1000000.0 or
               currentB[i] < -1000000.0 or currentB[i] > 1000000.0 { return false }
        }
    }
    for i in 0 to N {
        outputA[i] = currentA[i]
        outputB[i] = currentB[i]
    }
    return true
}

