            # /, and is represented by the real typed multiplication opcode.
            # The zero-width synthetic operator points to the opening '('
            # for accurate diagnostics without rewriting the UTF-8 source.
            if not expect_operand {
                while top > 0 and operators[top - 1] != -1 and
                      precedence(operators[top - 1]) >= precedence(3) {
                    top = top - 1
                    if count >= 64 { return source_error(index, length) }
                    instructions[count] = make_instruction(operators[top],
                        quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
                    count = count + 1
                }
                if top >= 63 { return source_error(index, length) }
                operators[top] = 3
                positions[top] = index
                widths[top] = 0
                top = top + 1
                expect_operand = true
            }
            if c == 124 {
                if top >= 63 { return source_error(index, length) }
                operators[top] = 20
                positions[top] = index
                widths[top] = 1
                top = top + 1
            }
            if top >= 64 { return source_error(index, length) }
            operators[top] = -1
            positions[top] = index
            widths[top] = 1
            argument_counts[top] = 0
            top = top + 1
            index = index + 1
            expect_operand = true
            continue
        }
        if c == 44 { # , separates arguments of recognized calls only
            if expect_operand { return source_error(index, length) }
            let mut opening: i32 = top - 1
            while opening >= 0 and operators[opening] != -1 {
                opening = opening - 1
            }
            if opening < 1 { return source_error(index, length) }
            let arity: i32 = function_arity(operators[opening - 1])
            if (arity < 2 and arity != -2 and arity != -3) or
               (arity > 0 and argument_counts[opening] >= arity - 1) or
               ((arity == -2 or arity == -3) and argument_counts[opening] >= 7) {
                return source_error(index, length)
            }
            while top > opening + 1 {
                top = top - 1
                if count >= 64 { return source_error(index, length) }
                instructions[count] = make_instruction(operators[top],
                    quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
                count = count + 1
            }
            argument_counts[opening] = argument_counts[opening] + 1
            expect_operand = true
            index = index + 1
            continue
        }
        if c == 41 or (c == 124 and close_bar) { # ) or closing |
            if expect_operand { return source_error(index, length) }
            let mut found: bool = false
            while top > 0 {
                top = top - 1
                if operators[top] == -1 {
                    if (c == 41 and bytes[positions[top]] != 40) or
                       (c == 124 and bytes[positions[top]] != 124) {
                        return source_error(index, length)
                    }
                    found = true
                    break
                }
                if count >= 64 { return source_error(index, length) }
                instructions[count] = make_instruction(operators[top], quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
                count = count + 1
            }
            if not found { return source_error(index, length) }
            # A completed function call is one primary, before a postfix
            # power. A function with missing or extra arguments fails closed.
            if top > 0 and function_arity(operators[top - 1]) != 0 {
                if c == 124 {
                    if operators[top - 1] != 20 or bytes[positions[top - 1]] != 124 {
                        return source_error(index, length)
                    }
                    widths[top - 1] = index + 1 - positions[top - 1]
                }
                let arity: i32 = function_arity(operators[top - 1])
                let actual_arity: i32 = argument_counts[top] + 1
                if (arity > 0 and actual_arity != arity) or
                   (arity == -2 and (actual_arity < 1 or actual_arity > 8)) or
                    (arity == -3 and (actual_arity < 2 or actual_arity > 8)) {
                    return source_error(index, length)
                }
                top = top - 1
                if count >= 64 { return source_error(positions[top], length) }
                if arity == -2 or arity == -3 {
                    # Preserve the actual operand count in the existing IR
                    # exponent field; source spans still refer to the call.
                    instructions[count] = MathInstruction {
                        opcode: operators[top], literal: quantity(0.0, dimensionless()),
                        exponent: actual_arity, source_start: positions[top],
                        source_end: positions[top] + widths[top]
                    }
                } else {
                    instructions[count] = make_instruction(operators[top],
                        quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
                }
                count = count + 1
            }
            index = index + 1
            expect_operand = false
            continue
        }
        let opcode: i32 = source_operator(bytes, index, length)
        if opcode == 0 { return source_error(index, length) }
        let width: i32 = operator_bytes(bytes, index, length)
        if expect_operand {
            if opcode != 1 and opcode != 2 { return source_error(index, length) }
            if opcode == 2 {
                if top >= 64 { return source_error(index, length) }
                operators[top] = 5
                positions[top] = index
                widths[top] = width
                top = top + 1
            }
        } else {
            while top > 0 and operators[top - 1] != -1 and
                  precedence(operators[top - 1]) >= precedence(opcode) {
                top = top - 1
                if count >= 64 { return source_error(index, length) }
                instructions[count] = make_instruction(operators[top], quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
                count = count + 1
            }
            if top >= 64 { return source_error(index, length) }
            operators[top] = opcode
            positions[top] = index
            widths[top] = width
            top = top + 1
            expect_operand = true
        }
        index = index + width
    }
    if expect_operand { return source_error(length, length) }
    while top > 0 {
        top = top - 1
        if operators[top] == -1 { return source_error(positions[top], length) }
        if count >= 64 { return source_error(positions[top], length) }
        instructions[count] = make_instruction(operators[top], quantity(0.0, dimensionless()), positions[top], positions[top] + widths[top])
        count = count + 1
    }
    return ParsedMathExpression {
        valid: true,
        program: MathProgram { instructions: instructions, count: count, source_length: length },
        failed_at: -1
    }
}

export function parse_math_expression(source: string) -> ParsedMathExpression {
    return parse_math_expression_with_bindings(source, empty_math_bindings())
}

export function evaluate_math_expression_with_bindings(source: string, bindings: MathBindings) -> MathResult {
    let parsed: ParsedMathExpression = parse_math_expression_with_bindings(source, bindings)
    if not parsed.valid {
        return MathResult {
            valid: false, result: quantity(0.0, dimensionless()),
            failed_at: parsed.failed_at, is_predicate: false
        }
    }
    return evaluate_math_ir(parsed.program)
}

export function evaluate_math_expression(source: string) -> MathResult {
    return evaluate_math_expression_with_bindings(source, empty_math_bindings())
}
