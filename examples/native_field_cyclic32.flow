# Three compiler-generated Flow 2.0 Dirichlet PDE fields with directed cyclic
# interspecies exchange. Independent Python stencil and spectral oracles verify
# 288 native cell checkpoints. The exchange matrix is row-stochastic but not
# symmetric; all three PDE fields genuinely interact at every time step.
# Run: flow run examples/native_field_cyclic32.flow
import "stdlib/dynamics/pde.flow"

const N: i32 = 32
const RATIO: f64 = 0.2
const EXCHANGE: f64 = 0.08

field U : f64[32] on Line
U evolves as laplacian(U)
boundary U { left = 0.0  right = 0.0 }

field V : f64[32] on Line
V evolves as laplacian(V)
boundary V { left = 0.0  right = 0.0 }

field W : f64[32] on Line
W evolves as laplacian(W)
boundary W { left = 0.0  right = 0.0 }

function absolute(value: f64) -> f64 {
    if value < 0.0 { return -value }
    return value
}

# Each field's spatial step is generated by the upstream compiler. A directed
# exchange of their freshly diffused states is simultaneous, not sequential.
# Reject before touching outputs, including any overflow during integration.
# 1024 steps * 96 species-cells = 98304 maximum field-cell steps.
function integrate(initialU: ptr<f64>, initialV: ptr<f64>, initialW: ptr<f64>,
                   outputU: ptr<f64>, outputV: ptr<f64>, outputW: ptr<f64>,
                   ratio: f64, exchange: f64, steps: i32) -> bool {
    if steps < 0 or steps > 1024 or ratio != ratio or exchange != exchange or
       ratio < 0.0 or ratio > 0.5 or exchange < 0.0 or exchange > 0.25 { return false }
    let currentU: array<f64, 32> = [0.0]
    let currentV: array<f64, 32> = [0.0]
    let currentW: array<f64, 32> = [0.0]
    let nextU: array<f64, 32> = [0.0]
    let nextV: array<f64, 32> = [0.0]
    let nextW: array<f64, 32> = [0.0]
    for i in 0 to N {
        if initialU[i] != initialU[i] or initialV[i] != initialV[i] or
           initialW[i] != initialW[i] or
           initialU[i] < 0.0 or initialU[i] > 10.0 or
           initialV[i] < 0.0 or initialV[i] > 10.0 or
           initialW[i] < 0.0 or initialW[i] > 10.0 { return false }
        currentU[i] = initialU[i]
        currentV[i] = initialV[i]
        currentW[i] = initialW[i]
    }
    if currentU[0] != 0.0 or currentU[N - 1] != 0.0 or
       currentV[0] != 0.0 or currentV[N - 1] != 0.0 or
       currentW[0] != 0.0 or currentW[N - 1] != 0.0 { return false }
    for step in 0 to steps {
        U_field_step(currentU, nextU, ratio)
        V_field_step(currentV, nextV, ratio)
        W_field_step(currentW, nextW, ratio)
        for i in 1 to N - 1 {
            let diffusedU: f64 = nextU[i]
            let diffusedV: f64 = nextV[i]
            let diffusedW: f64 = nextW[i]
            nextU[i] = (1.0 - exchange) * diffusedU + exchange * diffusedV
            nextV[i] = (1.0 - exchange) * diffusedV + exchange * diffusedW
            nextW[i] = (1.0 - exchange) * diffusedW + exchange * diffusedU
        }
        field_copy_1d(nextU, currentU, N)
        field_copy_1d(nextV, currentV, N)
        field_copy_1d(nextW, currentW, N)
        for i in 0 to N {
            if currentU[i] != currentU[i] or currentV[i] != currentV[i] or
               currentW[i] != currentW[i] or
               currentU[i] < -0.000000000001 or currentU[i] > 10.0 or
               currentV[i] < -0.000000000001 or currentV[i] > 10.0 or
               currentW[i] < -0.000000000001 or currentW[i] > 10.0 { return false }
        }
    }
    for i in 0 to N {
        outputU[i] = currentU[i]
        outputV[i] = currentV[i]
        outputW[i] = currentW[i]
    }
    return true
}

