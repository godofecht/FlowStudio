        2.1646348029576861,
        2.1686058265454311,
        2.1724272771814102,
        2.1760308107012780,
        2.1793074039754852,
        2.1821131589043743,
        2.1842766083183207,
        2.1856072300903771,
        2.1859048275713673,
        2.1849693998281241,
        2.1826111054784794,
        2.1786599199530494,
        2.1729745979315891,
        2.1654505800287436,
        2.1560265244573080,
        2.1446891987253403,
        2.1314765312728472,
        2.1164786957530275,
        2.0998371785258723,
        2.0817418597709496,
        2.0624262172757746,
        2.0421608362977688,
        2.0212454759836378,
        2.0000000000000000
    ]
    let after16: array<f64, 64> = [0.0]
    let after64: array<f64, 64> = [0.0]
    let after128: array<f64, 64> = [0.0]
    let composed: array<f64, 64> = [0.0]
    let replay: array<f64, 64> = [0.0]
    let half: array<f64, 64> = [0.0]
    if not integrate(initial, after16, RATIO, 16) { return 1 }
    if not integrate(initial, after64, RATIO, 64) { return 2 }
    if not integrate(initial, after128, RATIO, 128) { return 3 }
    let mut energy0: f64 = 0.0
    let mut energy16: f64 = 0.0
    let mut energy64: f64 = 0.0
    let mut energy128: f64 = 0.0
    for i in 0 to N {
        if absolute(after16[i] - expected16[i]) > 0.00000000001 { return 4 }
        if absolute(after64[i] - expected64[i]) > 0.00000000001 { return 5 }
        if absolute(after128[i] - expected128[i]) > 0.00000000001 { return 6 }
        if after16[i] < 0.0 or after64[i] < 0.0 or after128[i] < 0.0 { return 7 }
        let equilibrium: f64 = 1.0 + (i as f64) / 63.0
        let d0: f64 = initial[i] - equilibrium
        let d16: f64 = after16[i] - equilibrium
        let d64: f64 = after64[i] - equilibrium
        let d128: f64 = after128[i] - equilibrium
        energy0 = energy0 + d0 * d0
        energy16 = energy16 + d16 * d16
        energy64 = energy64 + d64 * d64
        energy128 = energy128 + d128 * d128
    }
    if not (energy0 > energy16 and energy16 > energy64 and
            energy64 > energy128) { return 8 }
    if after128[0] != 1.0 or after128[N - 1] != 2.0 { return 9 }
    if not integrate(initial, half, RATIO, 64) or
       not integrate(half, composed, RATIO, 64) { return 10 }
    if not integrate(initial, replay, RATIO, 128) { return 11 }
    for i in 0 to N {
        if absolute(composed[i] - after128[i]) > 0.000000000001 { return 12 }
        if replay[i] != after128[i] { return 13 }
    }
    let affine: array<f64, 64> = [0.0]
    for i in 0 to N { affine[i] = 1.0 + (i as f64) / 63.0 }
    let unchanged: array<f64, 64> = [0.0]
    if not integrate(affine, unchanged, RATIO, 128) { return 14 }
    for i in 0 to N {
        if absolute(unchanged[i] - affine[i]) > 0.00000000001 { return 15 }
    }
    if not integrate(initial, unchanged, 0.0, 64) { return 16 }
    for i in 0 to N { if unchanged[i] != initial[i] { return 17 } }
    if not integrate(initial, unchanged, RATIO, 0) { return 18 }
    for i in 0 to N { if unchanged[i] != initial[i] { return 19 } }
    if not integrate(initial, unchanged, 0.5, 16) { return 20 }
    let sentinel: array<f64, 64> = [777.0]
    if integrate(initial, sentinel, -0.1, 16) { return 21 }
    if integrate(initial, sentinel, 0.500001, 16) { return 22 }
    if integrate(initial, sentinel, RATIO, -1) { return 23 }
    if integrate(initial, sentinel, RATIO, 4097) { return 24 }
    let mut malformed: array<f64, 64> = [0.0]
    for i in 0 to N { malformed[i] = initial[i] }
    malformed[0] = 0.0
    if integrate(malformed, sentinel, RATIO, 16) { return 25 }
    malformed[0] = 1.0
    malformed[N - 1] = 0.0
    if integrate(malformed, sentinel, RATIO, 16) { return 26 }
    malformed[N - 1] = 2.0
    malformed[30] = 1000001.0
    if integrate(malformed, sentinel, RATIO, 16) { return 27 }
    for i in 0 to N { if sentinel[i] != 777.0 { return 28 } }
    malformed[30] = initial[30] + 0.2
    if not integrate(malformed, unchanged, RATIO, 64) { return 29 }
    if absolute(unchanged[30] - after64[30]) < 0.001 { return 30 }
    println("native-field-affine64-ok")
    return 0
}
