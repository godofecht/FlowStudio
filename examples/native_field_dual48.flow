    let afterA16: array<f64, 48> = [0.0]
    let afterA64: array<f64, 48> = [0.0]
    let afterA128: array<f64, 48> = [0.0]
    let afterB16: array<f64, 48> = [0.0]
    let afterB64: array<f64, 48> = [0.0]
    let afterB128: array<f64, 48> = [0.0]
    let composedA: array<f64, 48> = [0.0]
    let composedB: array<f64, 48> = [0.0]
    let replayA: array<f64, 48> = [0.0]
    let replayB: array<f64, 48> = [0.0]
    if not integrate(initialA, initialB, afterA16, afterB16, RATIO_A, RATIO_B, 16) { return 1 }
    if not integrate(initialA, initialB, afterA64, afterB64, RATIO_A, RATIO_B, 64) { return 2 }
    if not integrate(initialA, initialB, afterA128, afterB128, RATIO_A, RATIO_B, 128) { return 3 }
    let mut energyA0: f64 = 0.0
    let mut energyA16: f64 = 0.0
    let mut energyA64: f64 = 0.0
    let mut energyA128: f64 = 0.0
    let mut energyB0: f64 = 0.0
    let mut energyB16: f64 = 0.0
    let mut energyB64: f64 = 0.0
    let mut energyB128: f64 = 0.0
    for i in 0 to N {
        if absolute(afterA16[i] - expectedA16[i]) > 0.00000000001 or
           absolute(afterA64[i] - expectedA64[i]) > 0.00000000001 or
           absolute(afterA128[i] - expectedA128[i]) > 0.00000000001 { return 4 }
        if absolute(afterB16[i] - expectedB16[i]) > 0.00000000001 or
           absolute(afterB64[i] - expectedB64[i]) > 0.00000000001 or
           absolute(afterB128[i] - expectedB128[i]) > 0.00000000001 { return 5 }
        let equilibriumA: f64 = 1.0 + (i as f64) / 47.0
        let equilibriumB: f64 = -0.5 + (i as f64) / 47.0
        let a0: f64 = initialA[i] - equilibriumA
        let a16: f64 = afterA16[i] - equilibriumA
        let a64: f64 = afterA64[i] - equilibriumA
        let a128: f64 = afterA128[i] - equilibriumA
        let b0: f64 = initialB[i] - equilibriumB
        let b16: f64 = afterB16[i] - equilibriumB
        let b64: f64 = afterB64[i] - equilibriumB
        let b128: f64 = afterB128[i] - equilibriumB
        energyA0 = energyA0 + a0 * a0
        energyA16 = energyA16 + a16 * a16
        energyA64 = energyA64 + a64 * a64
        energyA128 = energyA128 + a128 * a128
        energyB0 = energyB0 + b0 * b0
        energyB16 = energyB16 + b16 * b16
        energyB64 = energyB64 + b64 * b64
        energyB128 = energyB128 + b128 * b128
    }
    if not (energyA0 > energyA16 and energyA16 > energyA64 and
            energyA64 > energyA128) { return 6 }
    if not (energyB0 > energyB16 and energyB16 > energyB64 and
            energyB64 > energyB128) { return 7 }
    if not integrate(afterA64, afterB64, composedA, composedB, RATIO_A, RATIO_B, 64) { return 8 }
    if not integrate(initialA, initialB, replayA, replayB, RATIO_A, RATIO_B, 128) { return 9 }
    for i in 0 to N {
        if absolute(composedA[i] - afterA128[i]) > 0.000000000001 or
           absolute(composedB[i] - afterB128[i]) > 0.000000000001 { return 10 }
        if replayA[i] != afterA128[i] or replayB[i] != afterB128[i] { return 11 }
    }
    let affineA: array<f64, 48> = [0.0]
    let affineB: array<f64, 48> = [0.0]
    let unchangedA: array<f64, 48> = [0.0]
    let unchangedB: array<f64, 48> = [0.0]
    for i in 0 to N {
        affineA[i] = 1.0 + (i as f64) / 47.0
        affineB[i] = -0.5 + (i as f64) / 47.0
    }
    if not integrate(affineA, affineB, unchangedA, unchangedB, RATIO_A, RATIO_B, 128) { return 12 }
    for i in 0 to N {
        if absolute(unchangedA[i] - affineA[i]) > 0.00000000001 or
           absolute(unchangedB[i] - affineB[i]) > 0.00000000001 { return 13 }
    }
    if not integrate(initialA, initialB, unchangedA, unchangedB, 0.0, 0.0, 128) { return 14 }
    for i in 0 to N {
        if unchangedA[i] != initialA[i] or unchangedB[i] != initialB[i] { return 15 }
    }
    if not integrate(initialA, initialB, unchangedA, unchangedB, RATIO_A, RATIO_B, 0) { return 16 }
    for i in 0 to N {
        if unchangedA[i] != initialA[i] or unchangedB[i] != initialB[i] { return 17 }
    }
    if not integrate(initialA, initialB, unchangedA, unchangedB, 0.5, 0.5, 16) { return 18 }
    let sentinelA: array<f64, 48> = [0.0]
    let sentinelB: array<f64, 48> = [0.0]
    for i in 0 to N {
        sentinelA[i] = 777.0
        sentinelB[i] = 777.0
    }
    if integrate(initialA, initialB, sentinelA, sentinelB, -0.1, RATIO_B, 16) { return 19 }
    if integrate(initialA, initialB, sentinelA, sentinelB, RATIO_A, 0.500001, 16) { return 20 }
    if integrate(initialA, initialB, sentinelA, sentinelB, RATIO_A, RATIO_B, -1) { return 21 }
    if integrate(initialA, initialB, sentinelA, sentinelB, RATIO_A, RATIO_B, 2049) { return 22 }
    let malformedA: array<f64, 48> = [0.0]
    let malformedB: array<f64, 48> = [0.0]
    for i in 0 to N {
        malformedA[i] = initialA[i]
        malformedB[i] = initialB[i]
    }
    malformedA[0] = 0.0
    if integrate(malformedA, malformedB, sentinelA, sentinelB, RATIO_A, RATIO_B, 16) { return 23 }
    malformedA[0] = 1.0
    malformedB[N - 1] = 0.0
    if integrate(malformedA, malformedB, sentinelA, sentinelB, RATIO_A, RATIO_B, 16) { return 24 }
    malformedB[N - 1] = 0.5
    malformedB[24] = 1000001.0
    if integrate(malformedA, malformedB, sentinelA, sentinelB, RATIO_A, RATIO_B, 16) { return 25 }
    for i in 0 to N {
        if sentinelA[i] != 777.0 or sentinelB[i] != 777.0 { return 26 }
    }
    malformedB[24] = initialB[24] + 0.2
    if not integrate(initialA, malformedB, unchangedA, unchangedB, RATIO_A, RATIO_B, 64) { return 27 }
    if absolute(unchangedB[24] - afterB64[24]) < 0.001 { return 28 }
    for i in 0 to N {
        if absolute(unchangedA[i] - afterA64[i]) > 0.000000000001 { return 29 }
    }
    println("native-field-dual48-ok")
    return 0
}
